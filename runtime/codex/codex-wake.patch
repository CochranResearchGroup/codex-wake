+#[cfg(unix)]
+#[tokio::test]
+async fn wake_delivery_eligibility_preserves_drafts_and_pending_user_turns() {
+    let (mut chat, _events, _operations) = make_chatwidget_manual(None).await;
+    assert_eq!(chat.wake_delivery_guard(), None);
+    chat.bottom_pane.set_composer_text("private human draft".into(), Vec::new(), Vec::new());
+    assert_eq!(chat.wake_delivery_guard(), Some("draft"));
+    assert_eq!(chat.composer_text_with_pending(), "private human draft");
+    chat.bottom_pane.set_composer_text(String::new(), Vec::new(), Vec::new());
+    chat.input_queue.user_turn_pending_start = true;
+    assert_eq!(chat.wake_delivery_guard(), Some("busy"));
+    chat.input_queue.user_turn_pending_start = false;
+    chat.bottom_pane.set_task_running(true);
+    assert_eq!(chat.wake_delivery_guard(), Some("busy"));
+    chat.bottom_pane.set_task_running(false);
+    chat.set_external_editor_state(ExternalEditorState::Active);
+    assert_eq!(chat.wake_delivery_guard(), Some("modal"));
+}
