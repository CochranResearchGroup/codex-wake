+pub fn goal_control_generation(home: &Path, thread: &str) -> Result<Value> {
+    ensure!(
+        upgrade_checkpoints::valid_thread(thread),
+        "invalid goal control conversation"
+    );
+    let path = home
+        .join("daemon-upgrades/goal-controls")
+        .join(format!("{thread}.json"));
+    if !path.try_exists()? {
+        return Ok(Value::Null);
+    }
+    private_dir(path.parent().context("goal control parent missing")?, false)?;
+    Ok(read(&path)?["generation"].clone())
+}
+pub(crate) fn executable_digest(path: &Path) -> Result<String> {
+    use std::io::Read;
+    let mut file = File::open(path)?;
+    let mut hash = blake3::Hasher::new();
+    let mut bytes = [0u8; 65536];
+    loop {
+        let count = file.read(&mut bytes)?;
+        if count == 0 {
+            break;
+        }
+        hash.update(&bytes[..count]);
+    }
+    Ok(hash.finalize().to_hex().to_string())
+}
+/// Native request handling verifies the actual process, not just an installed version string.
+pub fn matches_current_executable(state: &Value) -> Result<bool> {
+    let Some(target) = state["target_path"].as_str() else {
+        return Ok(false);
+    };
+    let executable = std::env::current_exe()?.canonicalize()?;
+    if Path::new(target).canonicalize().ok().as_ref() != Some(&executable) {
+        return Ok(false);
+    }
+    Ok(state["target_digest"] == executable_digest(&executable)?)
+}
+/// An incomplete inventory is an admission hold, never evidence that no work exists.
+pub const INVENTORY_SCAN_OPERATION: &str = "upgrade-inventory-scanning";
+const INVENTORY_RECORDS_PER_PASS: usize = 32;
+const OPERATIONS_PER_PASS: usize = 16;
+const CONVERSATIONS_PER_PASS: usize = 16;
+
+pub struct RecoveryInventory {
+    pub pending_operations: Vec<String>,
+    pub pending_work_operations: Vec<String>,
+    pub scan_incomplete: bool,
+}
+struct ConversationScan {
+    operation: String,
+    directory: PathBuf,
+    threads: std::vec::IntoIter<String>,
+    has_work: bool,
+    unfinished: bool,
+}
+struct InventoryScan {
+    stamp: (std::time::SystemTime, Option<Value>),
+    complete: bool,
+    watch: std::collections::BTreeSet<String>,
+    entries: std::fs::ReadDir,
+    directory_finished: bool,
+    recheck: Vec<String>,
+    conversations: Option<ConversationScan>,
+    pending: std::collections::BTreeMap<String, bool>,
+}
+impl InventoryScan {
+    fn new(root: &Path) -> Result<Self> {
+        Ok(Self {
+            stamp: Self::stamp(root)?,
+            complete: false,
+            watch: std::collections::BTreeSet::new(),
+            entries: std::fs::read_dir(root)?,
+            directory_finished: false,
+            recheck: Vec::new(),
+            conversations: None,
+            pending: std::collections::BTreeMap::new(),
+        })
+    }
+    fn stamp(root: &Path) -> Result<(std::time::SystemTime, Option<Value>)> {
+        let generation = root.join("inventory-generation.json");
+        Ok((
+            root.metadata()?.modified()?,
+            if generation.try_exists()? {
+                Some(read(&generation)?)
+            } else {
+                None
+            },
+        ))
+    }
+    fn snapshot(&self, scan_incomplete: bool) -> RecoveryInventory {
+        RecoveryInventory {
+            pending_operations: self.pending.keys().cloned().collect(),
+            pending_work_operations: self
+                .pending
+                .iter()
+                .filter(|(_, work)| **work)
+                .map(|(name, _)| name.clone())
+                .collect(),
+            scan_incomplete,
+        }
+    }
+}
+/// Each call reads at most 32 operation or conversation records. A process-owned
+/// directory cursor survives bounded passes; restarting only restarts this read-only
+/// inventory. Only immutable terminal classifications are excluded from refresh;
+/// known mutable candidates and generation changes force renewed examination.
+pub fn scan_inventory(home: &Path) -> Result<RecoveryInventory> {
+    advance_inventory(home)
+}
+fn advance_inventory(home: &Path) -> Result<RecoveryInventory> {
+    static SCANS: std::sync::OnceLock<
+        std::sync::Mutex<std::collections::HashMap<PathBuf, InventoryScan>>,
+    > = std::sync::OnceLock::new();
+    let mut scans = SCANS
+        .get_or_init(Default::default)
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let root = home.join("daemon-upgrades");
+    if !root.try_exists()? {
+        scans.remove(home);
+        return Ok(RecoveryInventory {
+            pending_operations: vec![],
+            pending_work_operations: vec![],
+            scan_incomplete: false,
+        });
+    }
+    private_dir(&root, false)?;
+    let mut scan = match scans.remove(home) {
+        Some(scan) if scan.stamp == InventoryScan::stamp(&root)? => scan,
+        _ => InventoryScan::new(&root)?,
+    };
+    if scan.complete {
+        if scan.watch.is_empty() {
+            let result = scan.snapshot(false);
+            scans.insert(home.to_path_buf(), scan);
+            return Ok(result);
+        }
+        scan.complete = false;
+        scan.recheck = scan.watch.iter().cloned().collect();
+        scan.pending.clear();
+    }
+    // An error drops this cursor. A later retry must revisit the failed record,
+    // rather than silently advancing past an unreadable obligation.
+    for _ in 0..INVENTORY_RECORDS_PER_PASS {
+        if let Some(conversations) = &mut scan.conversations {
+            if let Some(thread) = conversations.threads.next() {
+                ensure!(
+                    upgrade_checkpoints::valid_thread(&thread),
+                    "invalid recovery conversation"
+                );
+                let record = read(
+                    &conversations
+                        .directory
+                        .join(format!("{thread}.recovery.json")),
+                )?;
+                conversations.unfinished |= record["status"] == "resumed"
+                    && record["settled"].is_null()
+                    && record["runtime_epoch"] != server_epoch()
+                    && crate::upgrade_lifecycle::settled_reason(home, &thread, &record)?.is_none();
+                continue;
+            }
+            let conversations = scan
+                .conversations
+                .take()
+                .context("conversation inventory missing")?;
+            if conversations.unfinished {
+                scan.watch.insert(conversations.operation.clone());
+                scan.pending
+                    .insert(conversations.operation, conversations.has_work);
+            } else {
+                scan.watch.remove(&conversations.operation);
+            }
+        }
+        let (name, rechecking) = if !scan.directory_finished {
+            match scan.entries.next() {
+                Some(entry) => (entry?.file_name().to_string_lossy().into_owned(), false),
+                None => {
+                    scan.directory_finished = true;
+                    continue;
+                }
+            }
+        } else if let Some(name) = scan.recheck.pop() {
+            (name, true)
+        } else {
+            if scan.stamp != InventoryScan::stamp(&root)? {
+                scan = InventoryScan::new(&root)?;
+                let result = scan.snapshot(true);
+                scans.insert(home.to_path_buf(), scan);
+                return Ok(result);
+            }
+            scan.complete = true;
+            let result = scan.snapshot(false);
+            scans.insert(home.to_path_buf(), scan);
+            return Ok(result);
+        };
+        if !name.starts_with("upgrade-") {
+            continue;
+        }
+        let directory = root.join(&name);
+        let metadata = directory.symlink_metadata()?;
+        ensure!(
+            metadata.is_dir() && !metadata.file_type().is_symlink(),
+            "upgrade operation must be a real directory"
+        );
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            ensure!(
+                metadata.uid() == unsafe { libc::geteuid() },
+                "upgrade operation must be user-owned"
+            );
+        }
+        if rechecking {
+            scan.watch.remove(&name);
+        }
+        if !directory.join("state.json").try_exists()? {
+            scan.watch.insert(name.clone());
+            if !rechecking {
+                scan.recheck.push(name);
+            }
+            continue;
+        }
+        let state = read(&directory.join("state.json"))?;
+        if state["schema_version"] != 2 || state["recovery_enabled"] != true {
+            continue;
+        }
+        private_dir(&directory, false)?;
+        let phase = state["phase"].as_str();
+        if matches!(
+            phase,
+            Some("installing" | "recovering" | "recovered" | "recoveryHeld")
+        ) {
+            let threads = state["threads"]
+                .as_object()
+                .context("upgrade recovery inventory is missing")?;
+            ensure!(
+                threads.len() <= 4096,
+                "upgrade conversation inventory exceeds bound"
+            );
+            if matches!(phase, Some("installing" | "recovering")) {
+                scan.watch.insert(name.clone());
+                scan.pending.insert(name, !threads.is_empty());
+            } else {
+                scan.conversations = Some(ConversationScan {
+                    operation: name,
+                    directory,
+                    threads: threads.keys().cloned().collect::<Vec<_>>().into_iter(),
+                    has_work: !threads.is_empty(),
+                    unfinished: false,
+                });
+            }
+        } else if !matches!(phase, Some("replacementFailed" | "installedPaused")) {
+            scan.watch.insert(name.clone());
+            // Ready/preparing records may become pending without changing the
+            // root directory mtime. Recheck them at the end of this sweep.
+            if !rechecking {
+                scan.recheck.push(name);
+            }
+        }
+    }
+    let result = scan.snapshot(true);
+    scans.insert(home.to_path_buf(), scan);
+    Ok(result)
+}
+/// Pending receipts fence startup, including an as-yet unexamined inventory suffix.
+pub fn pending_operations(home: &Path) -> Result<Vec<String>> {
+    let inventory = advance_inventory(home)?;
+    let mut operations = inventory.pending_operations;
+    if inventory.scan_incomplete {
+        operations.push(INVENTORY_SCAN_OPERATION.into());
+    }
+    Ok(operations)
+}
+/// Empty saved operations need no work fence, but an incomplete scan always does.
+pub fn pending_work_operations(home: &Path) -> Result<Vec<String>> {
+    let inventory = advance_inventory(home)?;
+    let mut operations = inventory.pending_work_operations;
+    if inventory.scan_incomplete {
+        operations.push(INVENTORY_SCAN_OPERATION.into());
+    }
+    Ok(operations)
+}
+pub(crate) fn mark_installing(directory: &Path, target: &Path) -> Result<()> {
+    let mut state = read(&directory.join("state.json"))?;
+    ensure!(
+        state["phase"] == "ready",
+        "upgrade checkpoint preparation is not ready"
+    );
+    state["target_path"] = json!(target.canonicalize()?);
+    state["target_digest"] = json!(executable_digest(target)?);
+    state["phase"] = json!("installing");
+    upgrade_checkpoints::durable(&directory.join("state.json"), &state)?;
+    // A ready directory can become pending without changing its parent's mtime.
+    // Cross-process readers invalidate their terminal cache on this host generation.
+    upgrade_checkpoints::durable(
+        &directory
+            .parent()
+            .context("upgrade root missing")?
+            .join("inventory-generation.json"),
+        &json!({"schema_version":1,"generation":uuid::Uuid::now_v7().to_string()}),
+    )
+}
+pub(crate) fn mark_replacement_not_selected(directory: &Path, reason: &str) -> Result<()> {
+    let mut state = read(&directory.join("state.json"))?;
+    state["phase"] = json!("replacementFailed");
+    state["reason"] = json!(reason);
+    upgrade_checkpoints::durable(&directory.join("state.json"), &state)
+}
+pub(crate) fn mark_no_replacement(directory: &Path) -> Result<()> {
+    let mut state = read(&directory.join("state.json"))?;
+    state["no_replacement_verified"] = json!(true);
+    upgrade_checkpoints::durable(&directory.join("state.json"), &state)
+}
+pub(crate) fn mark_installed_paused(directory: &Path) -> Result<()> {
+    let mut state = read(&directory.join("state.json"))?;
+    if state["recovery_enabled"] != true {
+        state["phase"] = json!("installedPaused");
+        upgrade_checkpoints::durable(&directory.join("state.json"), &state)?;
+    }
+    Ok(())
+}
+/// Startup and the upgrader may race; one coordinator and native per-thread receipts own delivery.
+pub async fn resume_pending(home: &Path) -> Result<()> {
+    let inventory = scan_inventory(home)?;
+    if inventory.scan_incomplete {
+        return Ok(());
+    }
+    resume_inventory(home, &inventory.pending_operations).await
+}
+/// Continue a completed inventory snapshot; the caller retains the scan fence
+/// until `scan_incomplete` is false and reconciles its admission owner first.
+pub async fn resume_inventory(home: &Path, pending: &[String]) -> Result<()> {
+    let mut operations = pending.to_vec();
+    if operations.is_empty() {
+        return Ok(());
+    }
+    // A contended or uncertain prefix cannot monopolize every later pass.
+    static NEXT_OPERATION: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+    let offset = NEXT_OPERATION
+        .fetch_add(OPERATIONS_PER_PASS, std::sync::atomic::Ordering::Relaxed)
+        % operations.len();
+    operations.rotate_left(offset);
+    let mut processed = 0;
+    for operation in operations {
+        if processed >= OPERATIONS_PER_PASS {
+            break;
+        }
+        let directory = operation_directory(home, &operation)?;
+        let Ok(_owner) = lock(&directory.join("coordinator.lock")) else {
+            continue;
+        };
+        processed += 1;
+        let mut state = read(&directory.join("state.json"))?;
+        if !matches!(
+            state["phase"].as_str(),
+            Some("installing" | "recovering" | "recovered" | "recoveryHeld")
+        ) {
+            continue;
+        }
+        let socket = codex_app_server_transport::app_server_control_socket_path(home)?;
+        let mut control = None;
+        for _ in 0..100 {
+            if let Ok(value) = upgrade_checkpoints::Control::connect(socket.as_path()).await {
+                control = Some(value);
+                break;
+            }
+            tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+        }
+        let mut control=control.context("Upgrade recovery is unconfirmed: replacement control socket unavailable; handoffs remain saved")?;
+        if state["threads"]
+            .as_object()
+            .is_some_and(|threads| threads.is_empty())
+        {
+            // initialize already proved native health; there is no saved work to fence or awaken.
+            state["phase"] = json!("recovered");
+            upgrade_checkpoints::durable(&directory.join("state.json"), &state)?;
+            continue;
+        }
+        control
+            .call("daemon/upgrade/prepare", json!({"operationId":operation}))
+            .await?;
+        state["phase"] = json!("recovering");
+        upgrade_checkpoints::durable(&directory.join("state.json"), &state)?;
+        let mut threads = state["threads"]
+            .as_object()
+            .context("recovery inventory missing")?
+            .keys()
+            .cloned()
+            .collect::<Vec<_>>();
+        ensure!(
+            threads.len() <= 4096,
+            "upgrade conversation inventory exceeds bound"
+        );
+        threads.sort();
+        let start = state["recovery_next_thread"]
+            .as_str()
+            .and_then(|next| threads.iter().position(|thread| thread == next))
+            .unwrap_or(0);
+        let mut attempted = 0;
+        for step in 0..threads.len() {
+            let index = (start + step) % threads.len();
+            let thread = &threads[index];
+            if state["threads"][thread]["recovery_epoch"] == server_epoch()
+                && matches!(
+                    state["threads"][thread]["recovery"]["status"].as_str(),
+                    Some("resumed" | "alreadyResumed" | "skipped" | "held")
+                )
+            {
+                continue;
+            }
+            if attempted >= CONVERSATIONS_PER_PASS {
+                break;
+            }
+            attempted += 1;
+            // Persist the next candidate before awaiting an RPC. Cancellation or
+            // a lost response must not repeatedly consume the same slow prefix.
+            state["recovery_next_thread"] = json!(threads[(index + 1) % threads.len()]);
+            upgrade_checkpoints::durable(&directory.join("state.json"), &state)?;
+            let outcome = control
+                .call(
+                    "daemon/upgrade/recovery",
+                    json!({"operationId":operation,"threadId":thread,"action":"resume"}),
+                )
+                .await;
+            let outcome = match outcome {
+                Ok(v) => v,
+                Err(error) => json!({"status":"unknown","reason":format!("{error:#}")}),
+            };
+            let outcome = if matches!(
+                outcome["status"].as_str(),
+                Some(
+                    "resumed"
+                        | "alreadyResumed"
+                        | "skipped"
+                        | "held"
+                        | "waitingReplacement"
+                        | "unknown"
+                )
+            ) {
+                outcome
+            } else {
+                json!({"status":"unknown","reason":"Replacement returned an unrecognized recovery verdict"})
+            };
+            state["threads"][thread]["recovery"] = outcome;
+            state["threads"][thread]["recovery_epoch"] = json!(server_epoch());
+            upgrade_checkpoints::durable(&directory.join("state.json"), &state)?;
+        }
+        let mut held = false;
+        let mut unknown = false;
+        let mut waiting = false;
+        for thread in &threads {
+            let entry = &state["threads"][thread];
+            if entry["recovery_epoch"] != server_epoch() {
+                unknown = true;
+                continue;
+            }
+            held |= entry["recovery"]["status"] == "held";
+            unknown |= entry["recovery"]["status"] == "unknown";
+            waiting |= entry["recovery"]["status"] == "waitingReplacement";
+        }
+        state["phase"] = json!(if unknown {
+            "recovering"
+        } else if waiting {
+            "installing"
+        } else if held {
+            "recoveryHeld"
+        } else {
+            "recovered"
+        });
+        upgrade_checkpoints::durable(&directory.join("state.json"), &state)?;
+        eprintln!(
+            "Daemon upgrade recovery: {}. Checkpoints and receipts: {}",
+            state["phase"],
+            directory.display()
+        );
+    }
+    Ok(())
+}
