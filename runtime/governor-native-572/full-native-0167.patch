+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn native_wake_palette_and_guided_form_never_submit_model_operations() {
+        let (mut widget, _sender, _events, mut operations) =
+            crate::chatwidget::tests::make_chatwidget_manual_with_sender().await;
+        widget.thread_id = Some(ThreadId::new());
+        while operations.try_recv().is_ok() {}
+        widget.handle_slash_command_dispatch(SlashCommand::Wake);
+        assert!(widget.bottom_pane.has_active_view());
+        assert!(operations.try_recv().is_err());
+        widget.handle_wake_command("form activate");
+        assert!(widget.bottom_pane.has_active_view());
+        assert!(operations.try_recv().is_err());
+    }
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn wake_governor_command_resolves_owned_control_alias() {
+        use std::os::unix::fs::PermissionsExt;
+        use std::os::unix::net::UnixListener;
+        const FIXTURE: &str = "WAKE_GOVERNOR_ALIAS_FIXTURE";
+        if let Some(directory) = std::env::var_os(FIXTURE) {
+            let directory = std::path::PathBuf::from(directory);
+            let alias = directory.join("control.sock");
+            let endpoint = format!("unix://{}", alias.display());
+            let (mut widget, _sender, mut events, mut operations) =
+                crate::chatwidget::tests::make_chatwidget_manual_with_sender().await;
+            widget.thread_id = Some(ThreadId::new());
+            widget.remote_connection =
+                crate::status::remote_connection::remote_connection_status_value(
+                    &crate::AppServerTarget::Remote {
+                        endpoint: crate::resolve_remote_addr(&endpoint).unwrap(),
+                    },
+                    None,
+                );
+            while operations.try_recv().is_ok() {}
+            widget.handle_wake_command("governor status");
+            tokio::time::timeout(Duration::from_secs(5), async {
+                while let Some(event) = events.recv().await {
+                    if matches!(event, AppEvent::WakeResult { .. }) {
+                        break;
+                    }
+                }
+            })
+            .await
+            .expect("public Wake command completed");
+            let arguments = std::fs::read_to_string(directory.join("arguments")).unwrap();
+            let arguments: Vec<_> = arguments.lines().collect();
+            let endpoint_index = arguments
+                .iter()
+                .position(|arg| *arg == "--endpoint")
+                .unwrap();
+            assert_eq!(
+                arguments[endpoint_index + 1],
+                format!("unix://{}", directory.join("native.sock").display())
+            );
+            assert!(
+                operations.try_recv().is_err(),
+                "governor status must not start model work"
+            );
+            return;
+        }
+        // Keep PATH changes in an isolated test process; the executable records
+        // the actual public command boundary, without supplying owner behavior.
+        let directory = tempfile::tempdir().unwrap();
+        let _listener = UnixListener::bind(directory.path().join("native.sock")).unwrap();
+        std::os::unix::fs::symlink("native.sock", directory.path().join("control.sock")).unwrap();
+        let executable = directory.path().join("codex-wake");
+        std::fs::write(&executable, "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$WAKE_ALIAS_CAPTURE\"\nprintf '{\"state\":\"disabled\"}\\n'\n").unwrap();
+        std::fs::set_permissions(&executable, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let path = std::env::join_paths(std::iter::once(directory.path().to_path_buf()).chain(
+            std::env::split_paths(&std::env::var_os("PATH").unwrap_or_default()),
+        ))
+        .unwrap();
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "chatwidget::wake_governor::tests::wake_governor_command_resolves_owned_control_alias", "--nocapture"])
+            .env(FIXTURE, directory.path()).env("WAKE_ALIAS_CAPTURE", directory.path().join("arguments"))
+            .env("PATH", path).output().unwrap();
+        assert!(
+            output.status.success(),
+            "{}",
+            format!(
+                "{}{}",
+                String::from_utf8_lossy(&output.stdout),
+                String::from_utf8_lossy(&output.stderr)
+            )
+        );
+    }
+
+    #[test]
+    fn direct_governor_grammar_never_executes_shell_or_accepts_authority_fields() {
+        let args = governor_argv(
+            "extend --add-tokens 50 --resume",
