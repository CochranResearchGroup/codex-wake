+    /// Exact native active task identity; unlike a listener projection this includes startup.
+    pub async fn active_turn_provenance(&self) -> Option<(String, String)> {
+        let active = self.session.active_turn.lock().await;
+        let task = active.as_ref()?.task.as_ref()?;
+        Some((
+            task.turn_context.sub_id.clone(),
+            task.turn_context.root_turn_id(),
+        ))
+    }
+    pub async fn active_governor_guard_ids(&self) -> Vec<String> {
+        let active = self.session.active_turn.lock().await;
+        let Some(task) = active.as_ref().and_then(|turn| turn.task.as_ref()) else {
+            return Vec::new();
+        };
+        let mut guards = crate::governor_guard::guards_for_root(
+            self.session.thread_id,
+            &task.turn_context.root_turn_id(),
+        );
+        if let Some(next) = task
+            .turn_context
+            .extension_data
+            .get::<crate::governor_guard::NextGovernorTurnGuards>()
+        {
+            guards.extend(next.0.clone());
+        }
+        crate::governor_guard::combine(guards)
+            .into_iter()
+            .map(|guard| guard.id)
+            .collect()
+    }
+    /// Attach only to the named existing task. Register the completion notification before
+    /// releasing the active-task lock, so natural completion cannot strand a lease monitor.
+    pub async fn attach_governor_guard(
+        &self,
+        expected: &str,
+        guard: &crate::governor_guard::GovernorTaskGuard,
+    ) -> Result<bool, String> {
+        let active = self.session.active_turn.lock().await;
+        let Some(task) = active
+            .as_ref()
+            .and_then(|turn| turn.task.as_ref())
+            .filter(|task| task.turn_context.sub_id == expected)
+        else {
+            return Ok(false);
+        };
+        if task
+            .turn_context
+            .extension_data
+            .get::<crate::governor_guard::NextGovernorTurnGuards>()
+            .is_some_and(|guards| guards.0.iter().any(|existing| existing.id == guard.id))
+        {
+            return Ok(true);
+        }
+        let root = task.turn_context.root_turn_id();
+        crate::governor_guard::bind_root(&root, guard)?;
+        crate::governor_guard::register_turn(
+            self.session.thread_id,
+            expected,
+            task.turn_context
+                .turn_metadata_state
+                .parent_turn_id()
+                .as_deref(),
+        );
+        let mut guards = crate::governor_guard::guards_for_root(self.session.thread_id, &root);
+        if let Some(current) = task
+            .turn_context
+            .extension_data
+            .get::<crate::governor_guard::NextGovernorTurnGuards>()
+        {
+            guards.extend(current.0.clone());
+        }
+        guards.push(guard.clone());
+        let guards = crate::governor_guard::combine(guards);
+        for guard in &guards {
+            if let Some(directory) = &guard.durable_directory {
+                crate::governor_guard::persist_membership(
+                    directory,
+                    self.session.thread_id,
+                    guard.scope,
+                    Some(expected),
+                    None,
+                    false,
+                )?;
+            }
+        }
+        crate::governor_guard::remember_turn_guards(
+            self.session.thread_id,
+            expected,
+            guards.clone(),
+        )?;
+        task.turn_context
+            .extension_data
+            .insert(crate::governor_guard::NextGovernorTurnGuards(
+                guards.clone(),
+            ));
+        self.session.services.thread_extension_data.insert(
+            crate::governor_guard::GovernorTurnGuards {
+                turn_id: expected.to_owned(),
+                guards,
+            },
+        );
+        let mut done = Box::pin(task.done.clone().notified_owned());
+        done.as_mut().enable();
+        let owner = Arc::clone(&self.session);
