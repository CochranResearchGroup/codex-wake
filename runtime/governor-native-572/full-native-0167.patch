+impl ChatWidget {
+    fn wake_selector(&self) -> Option<String> {
+        self.wake_governor
+            .selected
+            .clone()
+            .or_else(|| self.thread_id.map(|id| format!("thread:{id}")))
+    }
+    fn wake_endpoint(&self) -> Result<String, String> {
+        let endpoint = if let Some(endpoint) = &self.wake_governor.selected_endpoint {
+            endpoint.as_str()
+        } else {
+            self.remote_connection
+                .as_ref()
+                .map(|remote| remote.address.as_str())
+                .ok_or("Governor requires a qualified local Unix daemon connection")?
+        };
+        let path = endpoint
+            .strip_prefix("unix://")
+            .ok_or("Governor unsupported for this remote transport; isolation unqualified")?;
+        // The account control address may be a symlink. Wake requires the
+        // physical socket and still validates its owner, peer and generation.
+        let path = std::fs::canonicalize(path)
+            .map_err(|_| "Governor local Unix daemon endpoint unavailable")?;
+        Ok(format!("unix://{}", path.display()))
+    }
+    pub(crate) fn start_wake_governor_poll(&mut self) {
+        if let Some(poll) = self.wake_governor.poll.take() {
+            poll.abort();
+        }
+        self.wake_governor.snapshot = None;
+        self.wake_governor.error = None;
+        self.wake_governor.selected = None;
+        self.wake_governor.selected_endpoint = None;
+        self.wake_governor.selected_home = None;
+        let Some(thread_id) = self.thread_id else {
+            return;
+        };
+        let endpoint = match self.wake_endpoint() {
+            Ok(endpoint) => endpoint,
+            Err(error) => {
+                self.wake_governor.error = Some(error);
+                return;
+            }
+        };
+        let tx = self.app_event_tx.clone();
+        let refresh = self.wake_governor.refresh.clone();
+        self.wake_governor.poll = Some(tokio::spawn(async move {
+            let client = match reqwest::Client::builder()
+                .no_proxy()
+                .redirect(reqwest::redirect::Policy::none())
+                .timeout(Duration::from_secs(15))
+                .connect_timeout(Duration::from_secs(2))
+                .build()
+            {
+                Ok(client) => client,
+                Err(_) => {
+                    tx.send(AppEvent::WakeResult {
+                        thread_id,
+                        result: Err("Wake status HTTP client unavailable".into()),
+                        operation: false,
+                    });
+                    return;
+                }
+            };
+            let mut connection = None;
+            loop {
+                if connection.is_none() {
+                    match status_connection(thread_id).await {
+                        Ok(value) => connection = Some(value),
+                        Err(error) => {
+                            tx.send(AppEvent::WakeResult {
+                                thread_id,
+                                result: Err(error),
+                                operation: false,
+                            });
+                            tokio::time::sleep(Duration::from_secs(30)).await;
+                            continue;
+                        }
+                    }
+                }
+                let result = shared_status(
+                    &client,
+                    connection.as_ref().expect("connection checked"),
+                    thread_id,
+                    &endpoint,
+                )
+                .await;
+                let slow = result.is_err()
+                    || result.as_ref().ok().is_some_and(|value| {
+                        value.get("state").and_then(Value::as_str) == Some("disabled")
+                    });
+                if result.is_err() {
+                    connection = None;
+                }
+                tx.send(AppEvent::WakeResult {
+                    thread_id,
+                    result,
+                    operation: false,
+                });
+                tokio::select! { _ = tokio::time::sleep(Duration::from_secs(if slow {30} else {3})) => {}, _ = refresh.notified() => {} }
+            }
+        }));
+    }
+    pub(super) fn refresh_wake_governor(&self) {
+        self.wake_governor.refresh.notify_one();
+    }
+    pub(crate) fn handle_wake_command(&mut self, arguments: &str) {
+        let Some(thread_id) = self.thread_id else {
+            self.add_error_message("Wake requires a current thread; no target was inferred".into());
+            return;
+        };
+        let input = arguments.trim();
+        if input.is_empty() || input == "governor" {
+            self.show_wake_menu();
+            return;
+        }
+        if let Some(verb) = input.strip_prefix("form ") {
+            self.show_wake_form(verb);
+            return;
+        }
+        let catalog = match input {
+            "list" => Some(vec!["list", "--json"]),
+            "tabs list" => Some(vec!["tabs", "list", "--json"]),
+            "tabs sessions list" => Some(vec!["tabs", "sessions", "list", "--json"]),
+            "accounts list" => Some(vec!["accounts", "list", "--json"]),
+            _ => None,
+        };
+        if let Some(argv) = catalog {
+            self.run_wake_catalog(argv.into_iter().map(str::to_owned).collect(), thread_id);
+            return;
+        }
+        if input == "targets" {
+            self.run_wake_catalog(
+                vec!["control".into(), "list".into(), "--json".into()],
+                thread_id,
+            );
+            return;
+        }
+        if let Some(target) = input.strip_prefix("select ") {
+            // Only picker-generated qualified selectors enter here; direct text cannot select an arbitrary target.
+            self.add_error_message(format!(
+                "Use /wake targets to select a qualified target ({target})"
+            ));
+            return;
+        }
+        let input = input.strip_prefix("governor ").unwrap_or(input);
+        let endpoint = match self.wake_endpoint() {
+            Ok(value) => value,
+            Err(error) => {
+                self.add_error_message(error);
+                return;
+            }
+        };
+        let selector = self.wake_selector().expect("thread exists");
+        let revision = self
+            .wake_governor
+            .inspected
+            .as_ref()
+            .or(self.wake_governor.snapshot.as_ref())
+            .filter(|v| {
+                v.pointer("/scope/thread_id")
+                    .and_then(Value::as_str)
+                    .map(|id| format!("thread:{id}"))
+                    == Some(selector.clone())
+            })
+            .and_then(|v| v.get("revision"))
+            .and_then(Value::as_u64);
+        match governor_argv(input, &selector, &endpoint, revision) {
+            Ok(argv) => {
+                let target = self
+                    .wake_governor
+                    .selected
+                    .as_deref()
+                    .and_then(|selector| selector.strip_prefix("thread:"))
+                    .and_then(|id| ThreadId::from_string(id).ok())
+                    .unwrap_or(thread_id);
+                let home = self.wake_governor.selected_home.clone();
+                let tx = self.app_event_tx.clone();
+                tokio::spawn(async move {
+                    tx.send(AppEvent::WakeResult {
+                        thread_id,
+                        result: invoke_in_context(argv, target, home).await,
+                        operation: true,
+                    });
+                });
+            }
+            Err(error) => self.add_error_message(error),
+        }
+    }
+    fn show_wake_catalog_result(&mut self, value: &Value) {
+        let value = value.get("result").unwrap_or(value);
+        let rows = value.as_array().or_else(|| {
+            ["tabs", "sessions", "accounts", "records", "wakes"]
+                .iter()
+                .find_map(|key| value.get(*key).and_then(Value::as_array))
+        });
+        let lines=rows.map(|rows|rows.iter().take(100).map(|row|Line::from(format!("{} · {}",row.get("name").or_else(||row.get("title")).or_else(||row.get("id")).or_else(||row.get("thread_id")).and_then(Value::as_str).unwrap_or("Wake record"),row.get("status").or_else(||row.get("state")).and_then(Value::as_str).unwrap_or("available")))).collect::<Vec<_>>()).filter(|lines|!lines.is_empty()).unwrap_or_else(||vec![Line::from("Wake catalog returned no displayable rows; use the matching CLI --json for complete machine details")]);
+        self.add_plain_history_lines(lines);
+    }
+    fn run_wake_catalog(&self, argv: Vec<String>, thread_id: ThreadId) {
+        let targets = argv.get(0).map(String::as_str) == Some("control")
+            && argv.get(1).map(String::as_str) == Some("list");
+        let tx = self.app_event_tx.clone();
+        tokio::spawn(async move {
+            tx.send(AppEvent::WakeResult {
+                thread_id,
+                result: invoke(argv, thread_id).await.map(|mut value| {
+                    if targets && let Some(object) = value.as_object_mut() {
+                        object.insert("_native_target_inventory".into(), Value::Bool(true));
+                    }
+                    value
+                }),
+                operation: true,
+            });
+        });
+    }
+    pub(crate) fn apply_wake_result(
+        &mut self,
+        thread_id: ThreadId,
+        result: Result<Value, String>,
+        operation: bool,
+    ) {
+        if self.thread_id != Some(thread_id) {
+            return;
+        }
+        match result {
+            Ok(value) => {
+                if value
+                    .get("_native_target_inventory")
+                    .and_then(Value::as_bool)
+                    == Some(true)
+                {
+                    self.show_wake_targets(&value);
+                    return;
+                }
+                if value.get("state").is_none() {
+                    if !operation {
+                        self.wake_governor.error =
+                            Some("Wake status schema unavailable; accounting unknown".into());
+                        self.request_redraw();
+                        return;
+                    }
+                    if operation {
+                        self.show_wake_catalog_result(&value);
+                    }
+                    return;
+                }
+                if !operation
+                    && self
+                        .wake_governor
+                        .snapshot
+                        .as_ref()
+                        .is_some_and(|previous| {
+                            previous.pointer("/scope/allocation_id")
+                                == value.pointer("/scope/allocation_id")
+                                && previous
+                                    .get("revision")
+                                    .and_then(Value::as_u64)
+                                    .zip(value.get("revision").and_then(Value::as_u64))
+                                    .is_some_and(|(old, new)| old > new)
+                        })
+                {
+                    return;
+                }
+                let current_scope = value.pointer("/scope/thread_id").and_then(Value::as_str)
+                    == Some(thread_id.to_string().as_str());
+                if !operation && !current_scope {
+                    self.wake_governor.error =
+                        Some("Wake status scope changed; accounting unknown".into());
+                    self.request_redraw();
+                    return;
+                }
+                let state = text(&value, "state");
+                let notice = matches!(state.as_str(),"limit_reached"|"disconnected").then(|| format!("Governor {state}: {}. /wake governor offers extend, reset, disable, explicit resume and checkpoint details.",text(&value,"reason")));
+                if current_scope && notice != self.wake_governor.notice {
+                    if let Some(notice) = &notice {
+                        self.add_info_message(notice.clone(), None);
+                    }
+                    self.wake_governor.notice = notice;
+                }
+                if current_scope {
+                    self.wake_governor.error = None;
+                }
+                if operation {
+                    self.add_info_message(
+                        format!(
+                            "Wake {} · {} · {}",
+                            if value.get("status").and_then(Value::as_str) == Some("held") {
+                                "HELD".into()
+                            } else {
+                                state_label(&value)
+                            },
+                            scope_label(&value),
+                            reason_label(&value)
+                        ),
+                        None,
+                    );
+                }
+                if operation {
+                    self.refresh_wake_governor();
+                    self.wake_governor.inspected = Some(value.clone());
+                    self.show_wake_details(&value);
+                }
+                if current_scope {
+                    self.wake_governor.snapshot = Some(value);
+                }
+            }
+            Err(error) => {
+                if operation {
+                    self.add_error_message(error.clone());
+                }
+                let current_scope =
+                    !operation || self.wake_selector() == Some(format!("thread:{thread_id}"));
+                if current_scope && self.wake_governor.error.as_ref() != Some(&error) {
+                    self.add_info_message(format!("Governor disconnected · accounting unknown: {error}. /wake governor to inspect or repair; no advisory fallback."),None);
+                }
+                if current_scope {
+                    self.wake_governor.error = Some(error);
+                }
+            }
+        }
+        self.request_redraw();
+    }
+    pub(super) fn wake_governor_lines(&self) -> Vec<Line<'static>> {
+        if self.thread_id.is_none() {
