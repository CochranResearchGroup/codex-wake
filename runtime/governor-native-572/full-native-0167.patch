+/// Reload admission and read-only runtime inspection stay on the selected loaded thread.
+#[tokio::test]
+async fn thread_mcp_reload_preserves_peer_and_runtime_only_never_discovers_a_global_client()
+-> Result<()> {
+    let server = MockServer::start().await;
+    for (version, tool_name) in [("v1", "old_widget"), ("v2", "new_widget")] {
+        Mock::given(method("POST"))
+            .and(path(format!("/{version}")))
+            .respond_with(move |request: &wiremock::Request| {
+                let request: serde_json::Value = serde_json::from_slice(&request.body).unwrap();
+                let result = match request["method"].as_str() {
+                    Some("initialize") => json!({
+                        "protocolVersion": "2025-11-25",
+                        "capabilities": { "tools": {} },
+                        "serverInfo": { "name": "widget", "version": version }
+                    }),
+                    Some("tools/list") => json!({ "tools": [{
+                        "name": tool_name, "inputSchema": { "type": "object" }
+                    }] }),
+                    Some("resources/list") => json!({ "resources": [] }),
+                    Some("resources/templates/list") => json!({ "resourceTemplates": [] }),
+                    _ => return ResponseTemplate::new(202),
+                };
+                ResponseTemplate::new(200).set_body_json(json!({
+                    "jsonrpc": "2.0", "id": request["id"], "result": result
+                }))
+            })
+            .mount(&server)
+            .await;
+    }
+    let codex_home = TempDir::new()?;
+    let write_config = |version| {
+        mock_responses_config(&server.uri())
+            .with_extra_config(&format!(
+                "[mcp_servers.widget]\nurl = \"{}/{version}\"",
+                server.uri()
+            ))
+            .write(codex_home.path())
+    };
+    write_config("v1")?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(codex_home.path())
+        .build_initialized()
+        .await?;
+    let mut threads = Vec::new();
+    for _ in 0..2 {
+        let thread = app.start_thread(ThreadStartParams::default()).await?.thread;
+        timeout(
+            DEFAULT_READ_TIMEOUT,
+            app.read_stream_until_matching_notification("widget MCP ready", |notification| {
+                notification.method == "mcpServer/startupStatus/updated"
+                    && notification.params.as_ref().is_some_and(|params| {
+                        params["threadId"] == thread.id
+                            && params["name"] == "widget"
+                            && params["status"] == "ready"
+                    })
+            }),
+        )
+        .await??;
+        threads.push(thread.id);
+    }
+    async fn status(
+        app: &mut TestAppServer,
+        thread_id: &str,
+    ) -> Result<ListMcpServerStatusResponse> {
+        app.request(|request_id| ClientRequest::McpServerStatusList {
+            request_id,
+            params: ListMcpServerStatusParams {
+                thread_id: Some(thread_id.to_string()),
+                runtime_only: Some(true),
+                server_name: None,
+                detail: Some(McpServerStatusDetail::ToolsAndAuthOnly),
+                cursor: None,
+                limit: None,
+            },
+        })
+        .await
+    }
+    for thread in &threads {
+        let observed = status(&mut app, thread).await?;
+        assert_eq!(observed.data.len(), 1);
+        assert!(observed.data[0].tools.contains_key("old_widget"));
+    }
+    write_config("v2")?;
+    let inspected: ThreadMcpServerReloadResponse = app
+        .request(|request_id| ClientRequest::ThreadMcpServerReload {
+            request_id,
+            params: ThreadMcpServerReloadParams {
+                thread_id: threads[0].clone(),
+                dry_run: Some(true),
+            },
+        })
+        .await?;
+    assert!(!inspected.queued);
+    for thread in &threads {
+        assert!(
+            status(&mut app, thread).await?.data[0]
+                .tools
+                .contains_key("old_widget")
+        );
+    }
+    let admitted: ThreadMcpServerReloadResponse = app
+        .request(|request_id| ClientRequest::ThreadMcpServerReload {
+            request_id,
+            params: ThreadMcpServerReloadParams {
+                thread_id: threads[0].clone(),
+                dry_run: Some(false),
+            },
+        })
+        .await?;
+    assert!(admitted.queued);
+    assert_eq!(admitted.thread_id, threads[0]);
+    assert!(
+        status(&mut app, &threads[0]).await?.data[0]
+            .tools
+            .contains_key("new_widget")
+    );
+    assert!(
+        status(&mut app, &threads[1]).await?.data[0]
+            .tools
+            .contains_key("old_widget")
+    );
+    let missing_scope_id = app
+        .send_raw_request("mcpServerStatus/list", Some(json!({"runtimeOnly": true})))
+        .await?;
+    let missing_scope = timeout(
+        DEFAULT_READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(missing_scope_id)),
+    )
+    .await??;
+    assert_eq!(missing_scope.error.code, -32600);
+    assert!(missing_scope.error.message.contains("exact loaded thread"));
+    let requests = server
+        .received_requests()
+        .await
+        .expect("recorded MCP requests");
+    let startups = requests
+        .iter()
+        .filter(|request| {
+            serde_json::from_slice::<serde_json::Value>(&request.body)
+                .is_ok_and(|value| value["method"] == "initialize")
+        })
+        .count();
+    assert_eq!(startups, 3, "only the selected runtime may reconnect");
+    assert!(
+        !requests
+            .iter()
+            .any(|request| request.url.path().ends_with("/responses"))
+    );
+    Ok(())
+}
