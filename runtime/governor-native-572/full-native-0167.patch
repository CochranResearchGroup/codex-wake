+/// External goal controls advance a durable clock-independent generation, even paused→paused.
+pub fn goal_control_changed(home: &Path, thread: &str, generation: &str) -> Result<()> {
+    let root = home.join("daemon-upgrades");
+    if !root.try_exists()? {
+        return Ok(());
+    }
+    ensure!(
+        upgrade_checkpoints::valid_thread(thread),
+        "invalid goal control conversation"
+    );
+    private_dir(&root, false)?;
+    let controls = root.join("goal-controls");
+    private_dir(&controls, true)?;
+    upgrade_checkpoints::durable(
+        &controls.join(format!("{thread}.json")),
+        &json!({"generation":generation}),
+    )?;
+    #[cfg(unix)]
+    std::fs::File::open(root)?.sync_all()?;
+    Ok(())
