+            .await?
+            .result,
+        json!({"notice":{"eventId":event,"text":text},"modelContextAvailable":true})
+    );
+    let history = std::fs::read_to_string(thread.path.as_ref().expect("rollout path"))?;
+    assert_eq!(
+        history
+            .lines()
+            .filter(|line| line.contains("external_supervision") && line.contains(event))
+            .count(),
+        1
+    );
+    let rows = history
+        .lines()
+        .map(|line| serde_json::from_str::<serde_json::Value>(line).expect("valid rollout"))
+        .collect::<Vec<_>>();
+    let display_rows = rows
+        .iter()
+        .filter(|row| {
+            row["type"] == "event_msg"
+                && (row["payload"]["type"] == "agent_message" && row["payload"]["message"] == text
+                    || row["payload"]["type"] == "item_completed"
+                        && row["payload"]["item"]["type"] == "AgentMessage"
+                        && row["payload"]["item"]["id"] == event)
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(display_rows.len(), 1);
+    let display = &display_rows[0]["payload"];
+    if history_mode == Some(ThreadHistoryMode::Legacy) {
+        assert_eq!(display["type"], "agent_message");
+        assert_eq!(display["message"], text);
+    } else {
+        assert_eq!(display["type"], "item_completed");
+        assert_eq!(display["thread_id"], thread.id);
+        assert_eq!(display["turn_id"], event);
+        assert_eq!(display["item"]["type"], "AgentMessage");
+        assert_eq!(display["item"]["id"], event);
+        assert_eq!(
+            display["item"]["content"],
+            json!([{"type":"Text","text":text}])
+        );
+    }
+    assert!(!rows.iter().any(|row| row["type"] == "event_msg"
+        && matches!(
+            row["payload"]["type"].as_str(),
+            Some("task_started" | "token_count")
+        )));
+    let completions = rows
+        .iter()
+        .filter(|row| row["type"] == "event_msg" && row["payload"]["type"] == "task_complete")
+        .collect::<Vec<_>>();
+    if history_mode == Some(ThreadHistoryMode::Legacy) {
+        assert!(completions.is_empty());
+    } else {
+        assert_eq!(completions.len(), 1);
+        assert_eq!(
+            completions[0]["payload"],
+            json!({"type":"task_complete","root_turn_id":event,"turn_id":event,"last_agent_message":null})
+        );
+    }
+    // A new process must discover the persisted notice, not a live-session cache.
+    client.shutdown_gracefully().await?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized_with_timeout(Duration::from_secs(10))
+        .await?;
+    let resume = client
+        .send_raw_request("thread/resume", Some(json!({"threadId":thread.id})))
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(resume))
+        .await?;
+    let cold_read = client
+        .send_raw_request(
+            "thread/notice/read",
+            Some(json!({"threadId":thread.id,"eventId":event})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(cold_read))
+            .await?
+            .result,
+        json!({"notice":{"eventId":event,"text":text},"modelContextAvailable":true})
+    );
+    let cold_duplicate = client
+        .send_raw_request(
+            "thread/notice/append",
+            Some(json!({"threadId":thread.id,"eventId":event,"text":text})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(cold_duplicate))
+            .await?
+            .result,
+        json!({"eventId":event,"recorded":true,"modelContextAvailable":true,"notificationPublished":false,"alreadyRecorded":true})
+    );
+    assert_eq!(model.requests().len(), 0);
+    assert_eq!(
+        rpc(
+            &mut client,
+            "thread/goal/get",
+            json!({"threadId":thread.id})
+        )
+        .await?,
+        goal_before_notice
+    );
+    if history_mode != Some(ThreadHistoryMode::Legacy) {
+        let page = rpc(
+            &mut client,
+            "thread/turns/list",
+            json!({"threadId":thread.id}),
+        )
+        .await?;
+        let turns = page["data"].as_array().expect("public turn page");
+        assert_eq!(
+            turns.len(),
+            1,
+            "notice requires a cold-readable display container"
+        );
+        let container = &turns[0];
+        assert_eq!(container["id"], event);
+        assert_eq!(container["rootTurnId"], event);
+        assert_eq!(container["status"], "completed");
+        for field in ["startedAt", "completedAt", "durationMs", "error"] {
+            assert!(container[field].is_null(), "display container {field}");
+        }
+        let items = rpc(
+            &mut client,
+            "thread/items/list",
+            json!({"threadId":thread.id,"turnId":event}),
+        )
+        .await?;
+        let entries = items["data"].as_array().expect("public item page");
+        assert_eq!(entries.len(), 1);
+        assert_eq!(entries[0]["turnId"], event);
+        assert_eq!(entries[0]["item"]["id"], event);
+        assert_eq!(entries[0]["item"]["type"], "agentMessage");
+        assert_eq!(entries[0]["item"]["text"], text);
+    }
+    // Only this explicit operator continuation starts a local mock model request.
+    let turn = client
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Continue with approved operator work".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(turn))
+        .await?;
+    timeout(
+        Duration::from_secs(10),
+        client.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let flushed = client
+        .send_raw_request(
+            "thread/notice/read",
+            Some(json!({"threadId":thread.id,"eventId":event})),
+        )
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(flushed))
+        .await?;
+    let rows = std::fs::read_to_string(thread.path.as_ref().expect("rollout path"))?;
+    let usage_rows = rows
+        .lines()
+        .map(|line| serde_json::from_str::<serde_json::Value>(line).expect("valid rollout"))
+        .filter(|row| row.get("type") == Some(&json!("token_usage_record")))
+        .collect::<Vec<_>>();
+    assert_eq!(usage_rows.len(), 1);
+    assert_eq!(
+        usage_rows[0]["payload"]["response_id"],
+        json!("notice-response")
+    );
+    assert_eq!(usage_rows[0]["payload"]["thread_id"], json!(thread.id));
+    assert_eq!(
+        usage_rows[0]["payload"]["root_turn_id"],
+        usage_rows[0]["payload"]["turn_id"]
+    );
+    assert_eq!(
+        usage_rows[0]["payload"]["usage"],
+        json!({"input_tokens":20,"cached_input_tokens":10,"cache_write_input_tokens":0,
+        "output_tokens":5,"reasoning_output_tokens":0,"total_tokens":25})
+    );
+    let input = model.single_request().input();
+    assert!(input.iter().any(|item| {
+        item.get("content")
+            .and_then(|content| content.as_array())
+            .is_some_and(|parts| {
+                parts.iter().any(|part| {
+                    part.get("text")
+                        .and_then(|value| value.as_str())
+                        .is_some_and(|text| {
+                            text.contains("external_supervision") && text.contains(event)
+                        })
+                })
+            })
+    }));
+    Ok(())
