+/// Exercise deletion and recovery through their supported requests: deliberately missing
+/// history must be distinguishable from unexplained data loss before cold restoration.
+#[tokio::test]
+async fn deleted_recovery_conversation_does_not_require_its_history() -> Result<()> {
+    use codex_app_server_protocol::DaemonUpgradeRecoveryAction;
+    use codex_app_server_protocol::DaemonUpgradeRecoveryParams;
+    use codex_app_server_protocol::DaemonUpgradeRecoveryResponse;
