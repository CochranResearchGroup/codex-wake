diff --git a/codex-rs/app-server-daemon/src/upgrade_authority.rs b/codex-rs/app-server-daemon/src/upgrade_authority.rs
new file mode 100644
index 0000000000..c509c2e89c
--- /dev/null
+++ b/codex-rs/app-server-daemon/src/upgrade_authority.rs
@@ -0,0 +1,210 @@
+//! Host-owned original resource policy for upgrade recovery.
+//!
+//! A model's handoff describes work; it cannot declare external authority absent.
+use crate::upgrade_checkpoints;
+use crate::upgrade_recovery::goal_control_generation;
+use crate::upgrade_recovery::private_dir;
+use crate::upgrade_recovery::read;
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::ensure;
+use serde_json::Value;
+use serde_json::json;
+use std::path::Path;
+use std::path::PathBuf;
+
+/// Immutable resource scope shared by the two version-1 receipt representations.
+/// Value-backed views preserve the existing on-disk schema and comparison semantics.
+#[derive(PartialEq)]
+struct ImmutableGoalBinding<'a> {
+    goal_id: &'a Value,
+    objective: &'a Value,
+    token_limit: &'a Value,
+    created_at: &'a Value,
+}
+impl<'a> ImmutableGoalBinding<'a> {
+    fn native(snapshot: &'a Value) -> Self {
+        Self {
+            goal_id: &snapshot["goal_id"],
+            objective: &snapshot["goal"]["objective"],
+            token_limit: &snapshot["goal"]["tokenBudget"],
+            created_at: &snapshot["goal"]["createdAt"],
+        }
+    }
+    fn declaration(receipt: &'a Value) -> Self {
+        Self {
+            goal_id: &receipt["goal_id"],
+            objective: &receipt["objective"],
+            token_limit: &receipt["token_limit"],
+            created_at: &receipt["created_at"],
+        }
+    }
+}
+
+fn declaration_path(home: &Path, thread: &str) -> Result<PathBuf> {
+    ensure!(
+        upgrade_checkpoints::valid_thread(thread),
+        "invalid authority conversation"
+    );
+    let root = home.join("daemon-upgrades");
+    private_dir(&root, true)?;
+    let declarations = root.join("resource-authority");
+    private_dir(&declarations, true)?;
+    Ok(declarations.join(format!("{thread}.json")))
+}
+
+/// Invalidate before every external mutation, including a failed or identical pause.
+pub fn invalidate(home: &Path, thread: &str) -> Result<()> {
+    upgrade_checkpoints::durable(&declaration_path(home, thread)?, &Value::Null)
+}
+
+/// Only the validated user-facing goal mutation calls this; it does not change a grant.
+pub fn declare_native_only(home: &Path, thread: &str, goal: &Value, account: &Value) -> Result<()> {
+    ensure!(
+        !goal["goal_id"].is_null(),
+        "native recovery requires an existing goal identity"
+    );
+    let generation = goal_control_generation(home, thread)?;
+    ensure!(
+        generation.is_string(),
+        "native authority control generation missing"
+    );
+    let binding = ImmutableGoalBinding::native(goal);
+    upgrade_checkpoints::durable(
+        &declaration_path(home, thread)?,
+        &json!({
+            "version":1,"issuer":"userGoalMutation","policy":"nativeOnly","account":account,
+            "thread_id":thread,"tenant_home":home.canonicalize()?,
+            "goal_control":generation,"goal_id":binding.goal_id,
+            "objective":binding.objective,"token_limit":binding.token_limit,
+            "created_at":binding.created_at
+        }),
+    )
+}
+
+fn declaration(home: &Path, thread: &str, goal: &Value) -> Result<Value> {
+    // Absence is unknown authority, never an implicit native-only declaration.
+    let declaration = read(&declaration_path(home, thread)?)
+        .context("Original resource authority is unknown; work remains paused")?;
+    ensure!(
+        declaration["version"] == 1
+            && declaration["issuer"] == "userGoalMutation"
+            && declaration["policy"] == "nativeOnly",
+        "Original resource authority is unsupported or unverified"
+    );
+    ensure!(
+        declaration["thread_id"] == thread
+            && declaration["tenant_home"] == json!(home.canonicalize()?)
+            && declaration["goal_control"] == goal_control_generation(home, thread)?
+            && ImmutableGoalBinding::declaration(&declaration)
+                == ImmutableGoalBinding::native(goal),
+        "Original resource authority changed or is not bound to this goal"
+    );
+    Ok(declaration)
+}
+
+/// Seal host policy together with original account and cumulative native accounting.
+pub fn seal(home: &Path, thread: &str, goal: &Value, account: &Value) -> Result<Value> {
+    let authority = declaration(home, thread, goal)?;
+    ensure!(
+        authority["account"] == *account,
+        "Original account changed before checkpoint"
+    );
+    Ok(json!({"version":1,"authority":authority,
+        "account":account,"native_goal":goal,"external_deadline":null,
+        "verification":"hostNativeOnly"}))
+}
+
+/// Recheck at both fresh continuation and accepted-turn crash recovery admission.
+pub fn validate(
+    home: &Path,
+    thread: &str,
+    envelope: &Value,
+    goal: &Value,
+    account: &Value,
+    resources: &Value,
+) -> Result<()> {
+    let fields = envelope
+        .as_object()
+        .context("Original resource authority seal is missing")?;
+    ensure!(
+        fields.len() == 6
+            && fields.keys().all(|key| matches!(
+                key.as_str(),
+                "version"
+                    | "authority"
+                    | "account"
+                    | "native_goal"
+                    | "external_deadline"
+                    | "verification"
+            )),
+        "Resource authority seal contains unknown fields"
+    );
+    ensure!(
+        envelope["version"] == 1
+            && envelope["verification"] == "hostNativeOnly"
+            && envelope["external_deadline"].is_null(),
+        "External deadline or unsupported resource authority requires live qualification"
+    );
+    ensure!(
+        envelope["account"] == *account
+            && envelope["authority"] == declaration(home, thread, goal)?,
+        "Original account or resource authority changed"
+    );
+    let original = &envelope["native_goal"];
+    ensure!(
+        ImmutableGoalBinding::native(original) == ImmutableGoalBinding::native(goal),
+        "Original native resource scope changed"
+    );
+    let used = goal["goal"]["tokensUsed"]
+        .as_i64()
+        .context("Native cumulative accounting missing")?;
+    let original_used = original["goal"]["tokensUsed"]
+        .as_i64()
+        .context("Sealed cumulative accounting missing")?;
+    ensure!(
+        used >= original_used && used >= 0,
+        "Native cumulative accounting was reset"
+    );
+    if let Some(limit) = goal["goal"]["tokenBudget"].as_i64() {
+        ensure!(used < limit, "Original token allowance is exhausted");
+    }
+    let resources = resources
+        .as_object()
+        .context("Checkpoint resource declaration is missing")?;
+    ensure!(
+        resources.keys().all(|key| matches!(
+            key.as_str(),
+            "native_token_limit" | "scope" | "resume_allowed"
+        )),
+        "Unknown external deadline or resource authority in checkpoint; work remains paused"
+    );
+    if let Some(scope) = resources.get("scope") {
+        ensure!(
+            scope == "unchanged",
+            "Checkpoint resource scope is unsupported"
+        );
+    }
+    if let Some(allowed) = resources.get("resume_allowed") {
+        ensure!(
+            allowed.as_bool() == Some(true),
+            "Checkpoint requires work to remain paused or has invalid authority types"
+        );
+    }
+    if let Some(limit) = resources.get("native_token_limit") {
+        ensure!(
+            limit.is_null() || limit.as_i64().is_some_and(|n| n > 0),
+            "Invalid native resource limit type"
+        );
+        ensure!(
+            *limit == goal["goal"]["tokenBudget"],
+            "Checkpoint resource limit differs from original authority"
+        );
+    }
+    Ok(())
+}
+
+/// Non-secret tenant/account identity; never persist credentials or bearer material.
+pub fn account_scope(home: &Path, provider: &str, account_id: Option<String>) -> Result<Value> {
+    Ok(json!({"account_id":account_id,"provider":provider,"tenant_home":home.canonicalize()?}))
+}
diff --git a/codex-rs/app-server-daemon/src/upgrade_checkpoints.rs b/codex-rs/app-server-daemon/src/upgrade_checkpoints.rs
new file mode 100644
index 0000000000..9ff9af88ce
--- /dev/null
+++ b/codex-rs/app-server-daemon/src/upgrade_checkpoints.rs
@@ -0,0 +1,428 @@
+//! Cooperative, durable preparation before changing a running daemon's package.
+use crate::Daemon;
+use crate::client;
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::anyhow;
+use anyhow::ensure;
+use codex_app_server_protocol::JSONRPCMessage;
+use codex_app_server_protocol::JSONRPCNotification;
+use codex_app_server_protocol::JSONRPCRequest;
+use codex_app_server_protocol::RequestId;
+use codex_uds::UnixStream;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::Duration;
+use tokio::time::Instant;
+use tokio::time::sleep;
+use tokio::time::timeout;
+use tokio_tungstenite::WebSocketStream;
+
+pub(crate) enum Mode {
+    RequireHandoffs,
+    OnlyWhenUnused,
+}
+pub(crate) struct Preparation {
+    // Retain the connection-owned admission barrier until replacement or error.
+    _control: Control,
+    pub(crate) directory: PathBuf,
+}
+pub(crate) struct Control {
+    websocket: WebSocketStream<UnixStream>,
+    next_id: i64,
+}
+#[derive(Debug)]
+struct Rejection {
+    code: i64,
+    message: String,
+}
+impl std::fmt::Display for Rejection {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}", self.message)
+    }
+}
+impl std::error::Error for Rejection {}
+impl Control {
+    pub(crate) async fn connect(path: &Path) -> Result<Self> {
+        let mut websocket = client::connect(path).await?;
+        client::initialize(&mut websocket, true).await?;
+        client::send_message(
+            &mut websocket,
+            &JSONRPCMessage::Notification(JSONRPCNotification {
+                method: "initialized".into(),
+                params: None,
+            }),
+        )
+        .await?;
+        Ok(Self {
+            websocket,
+            next_id: 2,
+        })
+    }
+    pub(crate) async fn call(&mut self, method: &str, params: Value) -> Result<Value> {
+        let id = RequestId::Integer(self.next_id);
+        self.next_id += 1;
+        timeout(Duration::from_secs(8), async {
+            client::send_message(
+                &mut self.websocket,
+                &JSONRPCMessage::Request(JSONRPCRequest {
+                    id: id.clone(),
+                    method: method.into(),
+                    params: Some(params),
+                    trace: None,
+                }),
+            )
+            .await?;
+            loop {
+                match client::read_message(&mut self.websocket).await? {
+                    JSONRPCMessage::Response(response) if response.id == id => {
+                        return Ok(response.result);
+                    }
+                    JSONRPCMessage::Error(error) if error.id == id => {
+                        return Err(anyhow!(Rejection {
+                            code: error.error.code,
+                            message: error.error.message
+                        }));
+                    }
+                    _ => {}
+                }
+            }
+        })
+        .await
+        .with_context(|| format!("upgrade preparation timed out reading {method}"))?
+    }
+    async fn goal(&mut self, thread: &str) -> Result<Value> {
+        match self
+            .call("thread/goal/get", json!({"threadId":thread}))
+            .await
+        {
+            Ok(value) => Ok(value["goal"].clone()),
+            Err(error)
+                if error.downcast_ref::<Rejection>().is_some_and(|e| {
+                    e.code == -32600 && e.message == "goals feature is disabled"
+                }) =>
+            {
+                Ok(Value::Null)
+            }
+            Err(error) => Err(error),
+        }
+    }
+    async fn loaded(&mut self) -> Result<BTreeSet<String>> {
+        let mut result = BTreeSet::new();
+        let mut cursor = Value::Null;
+        let mut seen = BTreeSet::new();
+        for _ in 0..32 {
+            let page = self
+                .call("thread/loaded/list", json!({"limit":128,"cursor":cursor}))
+                .await?;
+            for id in page["data"]
+                .as_array()
+                .context("loaded conversation inventory unavailable")?
+            {
+                let id = id.as_str().context("conversation identity unavailable")?;
+                ensure!(
+                    valid_thread(id) && result.insert(id.to_owned()),
+                    "ambiguous conversation inventory"
+                );
+            }
+            cursor = page["nextCursor"].clone();
+            if cursor.is_null() {
+                return Ok(result);
+            }
+            ensure!(
+                seen.insert(cursor.to_string()),
+                "conversation inventory cursor repeated"
+            );
+        }
+        Err(anyhow!(
+            "conversation inventory exceeds upgrade preparation bound"
+        ))
+    }
+}
+pub(crate) fn valid_thread(value: &str) -> bool {
+    value.len() == 36
+        && value.bytes().enumerate().all(|(i, b)| {
+            if [8, 13, 18, 23].contains(&i) {
+                b == b'-'
+            } else {
+                b.is_ascii_hexdigit()
+            }
+        })
+}
+pub(crate) fn durable(path: &Path, value: &Value) -> Result<()> {
+    let parent = path.parent().context("checkpoint directory missing")?;
+    let mut file = tempfile::NamedTempFile::new_in(parent)?;
+    serde_json::to_writer_pretty(&mut file, value)?;
+    file.write_all(b"\n")?;
+    file.as_file().sync_all()?;
+    file.persist(path).map_err(|e| e.error)?;
+    #[cfg(unix)]
+    std::fs::File::open(parent)?.sync_all()?;
+    Ok(())
+}
+fn private_directory(home: &Path) -> Result<PathBuf> {
+    let root = home.join("daemon-upgrades");
+    if !root.exists() {
+        let mut builder = std::fs::DirBuilder::new();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        match builder.create(&root) {
+            Ok(()) => {}
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(e) => return Err(e.into()),
+        }
+    }
+    let info = root.symlink_metadata()?;
+    ensure!(
+        info.is_dir() && !info.file_type().is_symlink(),
+        "upgrade checkpoint directory must be a real directory"
+    );
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        ensure!(
+            info.uid() == unsafe { libc::geteuid() } && info.mode() & 0o077 == 0,
+            "upgrade checkpoint directory must be private and user-owned"
+        );
+    }
+    let directory = tempfile::Builder::new()
+        .prefix("upgrade-")
+        .tempdir_in(&root)?
+        .keep();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o700))?;
+    }
+    #[cfg(unix)]
+    {
+        std::fs::File::open(home)?.sync_all()?;
+        std::fs::File::open(&root)?.sync_all()?;
+    }
+    Ok(directory)
+}
+fn goal_preserved(before: &Value, after: &Value) -> bool {
+    if before.is_null() || after.is_null() {
+        return before == after;
+    }
+    ["threadId", "objective", "createdAt", "tokenBudget"]
+        .iter()
+        .all(|key| before[*key] == after[*key])
+        && ["tokensUsed", "timeUsedSeconds"].iter().all(
+            |key| matches!((before[*key].as_u64(),after[*key].as_u64()),(Some(a),Some(b)) if b>=a),
+        )
+        && after["status"] != "active"
+}
+fn handoff(value: &Value, operation: &str, thread: &str) -> bool {
+    value["upgrade_id"] == operation
+        && value["thread_id"] == thread
+        && value["ready"] == true
+        && ["objective", "authority", "resume_instructions"]
+            .iter()
+            .all(|key| value[*key].as_str().is_some_and(|s| !s.trim().is_empty()))
+        && ["completed", "remaining", "pending_operations"]
+            .iter()
+            .all(|key| value[*key].is_array())
+        && value["resource_state"].is_object()
+}
+async fn final_handoff(
+    control: &mut Control,
+    thread: &str,
+    turn: &str,
+    operation: &str,
+) -> Result<Option<Value>> {
+    let page = control
+        .call(
+            "thread/items/list",
+            json!({"threadId":thread,"turnId":turn,"limit":100,"sortDirection":"desc"}),
+        )
+        .await?;
+    for entry in page["data"]
+        .as_array()
+        .context("checkpoint response history unavailable")?
+    {
+        ensure!(
+            entry["turnId"] == turn,
+            "checkpoint history returned another turn"
+        );
+        let item = &entry["item"];
+        if item["type"] == "agentMessage" {
+            if let Some(text) = item["text"].as_str() {
+                if text.len() <= 1024 * 1024 {
+                    if let Ok(value) = serde_json::from_str::<Value>(text) {
+                        if value["upgrade_id"] == operation
+                            && value["thread_id"] == thread
+                            && value["ready"] == false
+                        {
+                            return Err(anyhow!(
+                                "conversation {thread} reported it cannot safely checkpoint; current daemon unchanged"
+                            ));
+                        }
+                        if handoff(&value, operation, thread) {
+                            return Ok(Some(value));
+                        }
+                    }
+                }
+            }
+        }
+    }
+    // A completed turn can become visible before its final history entry. Keep
+    // the old daemon running until the bound rather than inventing a handoff.
+    Ok(None)
+}
+
+pub(crate) async fn prepare(
+    daemon: &Daemon,
+    home: &Path,
+    candidate: &str,
+    mode: Mode,
+) -> Result<Option<Preparation>> {
+    prepare_with_timeout(daemon, home, candidate, mode, Duration::from_secs(120)).await
+}
+async fn prepare_with_timeout(
+    daemon: &Daemon,
+    home: &Path,
+    candidate: &str,
+    mode: Mode,
+    bound: Duration,
+) -> Result<Option<Preparation>> {
+    let mut control = Control::connect(&daemon.socket_path)
+        .await
+        .context("Upgrade held: cannot reach the running daemon; no replacement was made")?;
+    if matches!(mode, Mode::OnlyWhenUnused) && !control.loaded().await?.is_empty() {
+        tracing::info!(
+            "scheduled daemon update deferred: conversations are open; explicit update will request durable handoffs"
+        );
+        return Ok(None);
+    }
+    let directory = private_directory(home)?;
+    let operation = directory
+        .file_name()
+        .context("upgrade operation unavailable")?
+        .to_string_lossy()
+        .into_owned();
+    let receipt = directory.join("state.json");
+    let mut state = json!({"schema_version":2,"recovery_enabled":true,"operation_id":operation,"candidate":candidate,"phase":"preparing","threads":{}});
+    durable(&receipt, &state)?;
+    let prepared=async {
+        let barrier=control.call("daemon/upgrade/prepare",json!({"operationId":operation})).await.context("Upgrade held: running daemon lacks safe checkpoint preparation or is busy. No daemon was stopped or replaced; save work and stop an older daemon once before adopting cooperative upgrades")?;
+        ensure!(barrier==json!({"operationId":operation,"ready":true}),"upgrade admission barrier unverified");
+        let threads=control.loaded().await?;
+        if matches!(mode,Mode::OnlyWhenUnused) && !threads.is_empty() { return Ok(false); }
+        let deadline=Instant::now()+bound;
+        let mut waiting=BTreeMap::new();
+        // Publish to every affected conversation before steering any active work.
+        for thread in &threads {
+            ensure!(Instant::now()<deadline,"upgrade checkpoint preparation deadline reached");
+            let native=control.call("thread/read",json!({"threadId":thread,"includeTurns":false})).await?["thread"].clone();
+            ensure!(native["id"]==thread.as_str(),"upgrade conversation identity changed");
+            let goal=control.goal(thread).await?;
+            let event=format!("upgrade_{}_{}",operation,thread);
+            let text=format!("Daemon upgrade pending. Pause work at a safe point and prepare a durable handoff; preserve scope, counters and deadlines. The updater waits for checkpoints before replacing the daemon. Handoffs: {}. [External supervision event {event}]",directory.display());
+            ensure!(text.len()<=768,"checkpoint notice path exceeds native display bound");
+            let published=control.call("thread/notice/append",json!({"threadId":thread,"eventId":event,"text":text})).await?;
+            ensure!(published["recorded"]==true && published["modelContextAvailable"]==true,"upgrade prompt injection unverified for {thread}");
+            let file=directory.join(format!("{thread}.json"));
+            state["threads"][thread]=json!({"file":file,"goal_before":goal,"notice":published,"status":"notified"});
+            waiting.insert(thread.clone(),(native,goal,file));
+            durable(&receipt,&state)?;
+            if state["recovery_enabled"]==true {
+                match control.call("daemon/upgrade/recovery",json!({"operationId":operation,"threadId":thread,"action":"seal"})).await {
+                    Ok(response)=>ensure!(response["status"]=="observed","recovery control observation was not acknowledged"),
+                    Err(error) if error.downcast_ref::<Rejection>().is_some_and(|e|e.code == -32600 && e.message.starts_with("Invalid request: unknown variant `daemon/upgrade/recovery`")) => {
+                        state["recovery_enabled"]=json!(false);
+                        state["recovery_compatibility"]=json!("Running daemon lacks recovery seals; installation may proceed after handoffs, but work will remain paused for this adoption");
+                        eprintln!("Daemon upgrade: current version cannot seal automatic recovery. Handoffs will be saved; work remains paused after this first installation.");
+                    },
+                    Err(error)=>return Err(error.context("cannot observe goal controls before checkpoint")),
+                }
+                durable(&receipt,&state)?;
+            }
+        }
+        for (thread,(native,goal,file)) in &waiting {
+            let turns=control.call("thread/turns/list",json!({"threadId":thread,"limit":128,"sortDirection":"desc","itemsView":"notLoaded"})).await?;
+            let active:Vec<_>=turns["data"].as_array().context("turn inventory unavailable")?.iter().filter(|t|t["status"]=="inProgress").collect();
+            ensure!(active.len()<=1,"ambiguous active work for {thread}");
+            if let Some(turn)=active.first() {
+                let turn=turn["id"].as_str().context("active turn identity unavailable")?;
+                let request=json!({"upgrade_id":operation,"thread_id":thread,"handoff_file":file,"goal_before":goal});
+                let prompt=format!("DAEMON_UPGRADE_CHECKPOINT. Operator requests a graceful daemon upgrade. Stop starting work. Reach a safe pause point; do not abandon or duplicate uncertain external operations. Pause your active native goal with update_goal if one exists; do not create a goal, renew limits, or reset counters. Then return ONLY a JSON handoff as your final response: ready=true, upgrade_id and thread_id from the request, nonempty objective, authority, resume_instructions; arrays completed, remaining, pending_operations; object resource_state with existing allowance/deadline/counters and relevant workspace/git state. Include unresolved obligations and evidence paths. Never include secrets. If safe preparation is impossible, report ready=false and why. The host durably writes the file, so no filesystem write or extra controller enrollment is required. UPGRADE_REQUEST_JSON={request}");
+                control.call("turn/steer",json!({"threadId":thread,"expectedTurnId":turn,"input":[{"type":"text","text":prompt}]})).await?;
+                state["threads"][thread]["turn_id"]=json!(turn);
+                state["threads"][thread]["status"]=json!("checkpoint_requested");
+            } else {
+                let current=control.call("thread/read",json!({"threadId":thread,"includeTurns":false})).await?["thread"].clone();
+                ensure!(current["status"]["type"]=="idle","conversation {thread} has active work outside the bounded turn page");
+                if goal["status"]=="active" {control.call("thread/goal/set",json!({"threadId":thread,"status":"paused","origin":"automatic"})).await?;}
+                durable(file,&json!({"schema_version":1,"kind":"idle_snapshot","upgrade_id":operation,"thread_id":thread,"native":native,"goal_before":goal,"resume_instructions":"Resume the original conversation and inspect its retained upgrade notice; no resource renewal or new work is authorized"}))?;
+                state["threads"][thread]["status"]=json!("idle_snapshot_written");
+            }
+            durable(&receipt,&state)?;
+        }
+        state["phase"]=json!("waiting");durable(&receipt,&state)?;
+        eprintln!("Daemon upgrade: waiting for durable handoffs in {}. Current daemon remains running.",directory.display());
+        loop {
+            let pending:BTreeMap<_,_>=state["threads"].as_object().context("checkpoint inventory unavailable")?.iter().map(|(id,value)|(id,value["status"].clone())).collect();
+            ensure!(Instant::now()<deadline,"handoff deadline reached; conversation status: {pending:?}; no daemon replaced. Inspect {}",receipt.display());
+            let mut ready=true;
+            for (thread,(_,goal,file)) in &waiting {
+                let native=control.call("thread/read",json!({"threadId":thread,"includeTurns":false})).await?["thread"].clone();
+                if native["status"]["type"]!="idle" || native["status"]["activeFlags"].as_array().is_some_and(|v|!v.is_empty()) {ready=false;continue;}
+                let after=control.goal(thread).await?;
+                ensure!(goal_preserved(goal,&after),"conversation {thread} changed its goal authority or did not pause; current daemon unchanged");
+                if let Some(turn)=state["threads"][thread]["turn_id"].as_str() {
+                    if state["threads"][thread]["status"]!="handoff_written" {
+                        let Some(mut payload)=final_handoff(&mut control,thread,turn,&operation).await? else {ready=false;continue;};
+                        payload["schema_version"]=json!(1);payload["kind"]=json!("agent_handoff");
+                        durable(file,&payload)?;
+                        state["threads"][thread]["status"]=json!("handoff_written");
+                    }
+                }
+                state["threads"][thread]["goal_after"]=after;
+            }
+            durable(&receipt,&state)?;
+            if ready {break;}
+            sleep(Duration::from_millis(100)).await;
+        }
+        ensure!(control.loaded().await?==threads,"conversation inventory changed during upgrade preparation");
+        if state["recovery_enabled"]==true {
+            for thread in &threads {
+                let sealed=control.call("daemon/upgrade/recovery",json!({"operationId":operation,"threadId":thread,"action":"seal"})).await?;
+                ensure!(matches!(sealed["status"].as_str(),Some("sealed"|"skipped"|"held")),"recovery seal was not acknowledged");
+                state["threads"][thread]["recovery_seal"]=sealed;
+                durable(&receipt,&state)?;
+            }
+        }
+        state["phase"]=json!("ready");durable(&receipt,&state)?;
+        eprintln!("Daemon upgrade: all {} conversations checkpointed; handoffs saved in {}.",threads.len(),directory.display());
+        Ok(true)
+    }.await;
+    match prepared {
+        Ok(true) => Ok(Some(Preparation {
+            _control: control,
+            directory,
+        })),
+        Ok(false) => {
+            state["phase"] = json!("deferred");
+            durable(&receipt, &state)?;
+            Ok(None)
+        }
+        Err(error) => {
+            state["phase"] = json!("blocked");
+            state["reason"] = json!(format!("{error:#}"));
+            durable(&receipt, &state)?;
+            Err(error.context(format!(
+                "Upgrade held; current installation unchanged. Preparation details: {}",
+                receipt.display()
+            )))
+        }
+    }
+}
diff --git a/codex-rs/app-server-daemon/src/upgrade_lifecycle.rs b/codex-rs/app-server-daemon/src/upgrade_lifecycle.rs
new file mode 100644
index 0000000000..7ead3452ac
--- /dev/null
+++ b/codex-rs/app-server-daemon/src/upgrade_lifecycle.rs
@@ -0,0 +1,176 @@
+//! Host lifecycle evidence survives history deletion and does not infer rejection from absence.
+use crate::upgrade_checkpoints;
+use crate::upgrade_recovery::private_dir;
+use crate::upgrade_recovery::read;
+use anyhow::Result;
+use anyhow::ensure;
+use serde_json::Value;
+use serde_json::json;
+use std::path::Path;
+use std::path::PathBuf;
+
+fn directory(home: &Path, thread: &str, create: bool) -> Result<Option<PathBuf>> {
+    ensure!(
+        upgrade_checkpoints::valid_thread(thread),
+        "invalid lifecycle conversation"
+    );
+    let root = home.join("daemon-upgrades");
+    if !root.try_exists()? {
+        return Ok(None);
+    }
+    private_dir(&root, false)?;
+    let lifecycle = root.join("lifecycle");
+    if !create && !lifecycle.try_exists()? {
+        return Ok(None);
+    }
+    private_dir(&lifecycle, create)?;
+    let directory = lifecycle.join(thread);
+    if !create && !directory.try_exists()? {
+        return Ok(None);
+    }
+    private_dir(&directory, create)?;
+    // Persist newly created ancestors as well as the atomic evidence file itself.
+    #[cfg(unix)]
+    if create {
+        std::fs::File::open(&root)?.sync_all()?;
+        std::fs::File::open(&lifecycle)?.sync_all()?;
+    }
+    Ok(Some(directory))
+}
+fn terminal_name(turn: &str) -> Result<String> {
+    ensure!(
+        !turn.is_empty() && turn.len() <= 1024,
+        "invalid terminal turn identity"
+    );
+    Ok(format!(
+        "terminal-{}.json",
+        blake3::hash(turn.as_bytes()).to_hex()
+    ))
+}
+/// Called only for a trusted native terminal event, before its client notification.
+pub fn record_terminal(home: &Path, thread: &str, turn: &str) -> Result<()> {
+    let name = terminal_name(turn)?;
+    if let Some(directory) = directory(home, thread, true)? {
+        upgrade_checkpoints::durable(
+            &directory.join(name),
+            &json!({
+                "schema_version":1,"thread_id":thread,"turn_id":turn,"decision":"terminalTurn"
+            }),
+        )?;
+    }
+    Ok(())
+}
+/// A supported deletion request cancels future recovery before any history is removed.
+/// If deletion subsequently fails, retained data stays available but recovery remains canceled.
+pub fn record_deletion(home: &Path, thread: &str) -> Result<()> {
+    if let Some(directory) = directory(home, thread, true)? {
+        upgrade_checkpoints::durable(
+            &directory.join("deleted.json"),
+            &json!({
+                "schema_version":1,"thread_id":thread,"decision":"conversationDeleted"
+            }),
+        )?;
+    }
+    Ok(())
+}
+/// No content is retained here, and missing evidence never proves completion or deletion.
+pub fn is_deleted(home: &Path, thread: &str) -> Result<bool> {
+    let Some(directory) = directory(home, thread, false)? else {
+        return Ok(false);
+    };
+    let path = directory.join("deleted.json");
+    if !path.try_exists()? {
+        return Ok(false);
+    }
+    let evidence = read(&path)?;
+    ensure!(
+        evidence["schema_version"] == 1
+            && evidence["thread_id"] == thread
+            && evidence["decision"] == "conversationDeleted",
+        "invalid deletion lifecycle evidence"
+    );
+    Ok(true)
+}
+/// Completion settles only the exact accepted turn. A deletion cancels recovery, but
+/// does not turn an uncertain dispatch into an accepted or rejected submission.
+pub fn settled_reason(home: &Path, thread: &str, record: &Value) -> Result<Option<&'static str>> {
+    if is_deleted(home, thread)? {
+        return Ok(Some("conversationDeleted"));
+    }
+    if record["status"] != "resumed" {
+        return Ok(None);
+    }
+    let Some(turn) = record["turn_id"].as_str() else {
+        return Ok(None);
+    };
+    let Some(directory) = directory(home, thread, false)? else {
+        return Ok(None);
+    };
+    let path = directory.join(terminal_name(turn)?);
+    if !path.try_exists()? {
+        return Ok(None);
+    }
+    let evidence = read(&path)?;
+    ensure!(
+        evidence["schema_version"] == 1
+            && evidence["thread_id"] == thread
+            && evidence["turn_id"] == turn
+            && evidence["decision"] == "terminalTurn",
+        "invalid terminal lifecycle evidence"
+    );
+    Ok(Some("terminalTurn"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const THREAD: &str = "019abcde-0000-7000-8000-000000000001";
+
+    #[test]
+    fn native_terminal_evidence_settles_only_its_exact_accepted_turn() -> Result<()> {
+        let home = tempfile::tempdir()?;
+        private_dir(&home.path().join("daemon-upgrades"), true)?;
+        record_terminal(home.path(), THREAD, "accepted-a")?;
+        assert_eq!(
+            settled_reason(
+                home.path(),
+                THREAD,
+                &json!({"status":"resumed","turn_id":"accepted-a"})
+            )?,
+            Some("terminalTurn")
+        );
+        assert_eq!(
+            settled_reason(
+                home.path(),
+                THREAD,
+                &json!({"status":"resumed","turn_id":"accepted-b"})
+            )?,
+            None
+        );
+        assert_eq!(
+            settled_reason(
+                home.path(),
+                THREAD,
+                &json!({"status":"dispatching","turn_id":"accepted-a"})
+            )?,
+            None
+        );
+        Ok(())
+    }
+
+    #[test]
+    fn authoritative_deletion_survives_missing_history_without_inventing_acceptance() -> Result<()>
+    {
+        let home = tempfile::tempdir()?;
+        private_dir(&home.path().join("daemon-upgrades"), true)?;
+        let uncertain = json!({"status":"dispatching"});
+        assert_eq!(settled_reason(home.path(), THREAD, &uncertain)?, None);
+        record_deletion(home.path(), THREAD)?;
+        assert!(is_deleted(home.path(), THREAD)?);
+        assert_eq!(
+            settled_reason(home.path(), THREAD, &uncertain)?,
+            Some("conversationDeleted")
+        );
+        Ok(())
+    }
+}
diff --git a/codex-rs/app-server-daemon/src/upgrade_recovery.rs b/codex-rs/app-server-daemon/src/upgrade_recovery.rs
new file mode 100644
index 0000000000..deb9d31553
--- /dev/null
+++ b/codex-rs/app-server-daemon/src/upgrade_recovery.rs
@@ -0,0 +1,821 @@
+//! Durable upgrade recovery identity and acceptance, shared with the native request handler.
+use crate::upgrade_checkpoints;
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::ensure;
+use serde_json::Value;
+use serde_json::json;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::path::Path;
+use std::path::PathBuf;
+
+/// Shared process identity for startup scanning and native acceptance receipts.
+pub fn server_epoch() -> &'static str {
+    static EPOCH: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    EPOCH.get_or_init(|| uuid::Uuid::now_v7().to_string())
+}
+
+pub(crate) fn private_dir(path: &Path, create: bool) -> Result<()> {
+    if create && !path.exists() {
+        let mut builder = std::fs::DirBuilder::new();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        match builder.create(path) {
+            Ok(()) => {}
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {}
+            Err(e) => return Err(e.into()),
+        }
+    }
+    let metadata = path.symlink_metadata()?;
+    ensure!(
+        metadata.is_dir() && !metadata.file_type().is_symlink(),
+        "upgrade recovery directory is not a real directory"
+    );
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        ensure!(
+            metadata.uid() == unsafe { libc::geteuid() } && metadata.mode() & 0o077 == 0,
+            "upgrade recovery directory must be private and user-owned"
+        );
+    }
+    Ok(())
+}
+pub(crate) fn read(path: &Path) -> Result<Value> {
+    let metadata = path.symlink_metadata()?;
+    ensure!(
+        metadata.is_file()
+            && !metadata.file_type().is_symlink()
+            && metadata.len() <= 8 * 1024 * 1024,
+        "invalid upgrade recovery file"
+    );
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        ensure!(
+            metadata.uid() == unsafe { libc::geteuid() } && metadata.mode() & 0o077 == 0,
+            "upgrade recovery file must be private and user-owned"
+        );
+    }
+    serde_json::from_slice(&std::fs::read(path)?).context("invalid upgrade recovery JSON")
+}
+fn lock(path: &Path) -> Result<File> {
+    if path.symlink_metadata().is_ok() {
+        let m = path.symlink_metadata()?;
+        ensure!(
+            m.is_file() && !m.file_type().is_symlink(),
+            "invalid upgrade recovery lock"
+        );
+    }
+    let mut options = OpenOptions::new();
+    options.read(true).write(true).create(true).truncate(false);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let file = options.open(path)?;
+    file.try_lock()
+        .context("another upgrade recovery owns this conversation")?;
+    Ok(file)
+}
+fn operation_directory(home: &Path, operation: &str) -> Result<PathBuf> {
+    ensure!(
+        operation.starts_with("upgrade-")
+            && operation.len() <= 128
+            && operation
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-'),
+        "invalid upgrade recovery operation"
+    );
+    let root = home.join("daemon-upgrades");
+    private_dir(&root, false)?;
+    let directory = root.join(operation);
+    private_dir(&directory, false)?;
+    Ok(directory)
+}
+/// One serialized native operation/conversation record, independent of attached tabs.
+pub struct RecoveryFiles {
+    directory: PathBuf,
+    thread: String,
+    _lock: File,
