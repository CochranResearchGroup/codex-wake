+#[tokio::test]
+async fn host_recovery_admission_is_one_use_and_not_inherited() -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let _initial =
+        responses::mount_sse_once(&server, responses::sse_completed("host-recovery")).await;
+    let admission = Arc::new(TestAdmission(AtomicBool::new(false)));
+    let mut extensions = ExtensionRegistryBuilder::new();
+    extensions.turn_start_admission(admission.clone());
+    let test = test_codex()
+        .with_extensions(Arc::new(extensions.build()))
+        .build_with_auto_env(&server)
+        .await?;
+    let started = test
+        .codex
+        .start_turn_if_idle(user_message_request("original work"))
+        .await?;
+    let StartIfIdleSubmission::Started { turn_id, .. } = started else {
+        panic!("initial work not admitted")
+    };
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    admission.0.store(true, Ordering::SeqCst);
+    let response = responses::mount_sse_once(&server, responses::sse_completed("continued")).await;
+    let calls = Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let observed = calls.clone();
+    let ticket = codex_protocol::turn_input::TurnStartAdmissionToken::new(move || {
+        observed.fetch_add(1, Ordering::SeqCst);
+        Some(Box::new(()))
+    });
+    let reused = ticket.clone();
+    let request = TurnInputRequest::new(TurnInput::ResponseItem(responses::user_message_item(
+        "host recovery",
+    )))
+    .on_start(TurnStartOptions {
+        host_admission: Some(ticket),
+        ..Default::default()
+    });
+    let result = test.codex.continue_turn_if_idle(request, turn_id).await?;
+    let TurnInputSubmission::Started { turn_id, .. } = result else {
+        panic!("host admission not used")
+    };
+    wait_for_event(&test.codex, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(
+        reused.consume().is_none(),
+        "cloning cannot duplicate admission"
+    );
+    let result = test
+        .codex
+        .continue_turn_if_idle(
+            TurnInputRequest::new(TurnInput::ResponseItem(responses::user_message_item(
+                "unadmitted later work",
+            ))),
+            turn_id,
+        )
+        .await?;
+    assert_eq!(
+        result,
+        TurnInputSubmission::NotSubmitted {
+            reason: NotSubmittedReason::ServerDraining
+        }
+    );
+    assert_eq!(response.requests().len(), 1);
+    Ok(())
+}
