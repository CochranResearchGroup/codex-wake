+#[tokio::test]
+async fn upgrade_holds_new_work_allows_checkpoint_steering_and_releases_only_its_owner() {
+    use crate::outgoing_message::ConnectionId;
+    let admission = TurnAdmission::default();
+    let owner = ConnectionId(41);
+    let other = ConnectionId(42);
+    admission
+        .prepare_upgrade(owner, "upgrade-a")
+        .await
+        .expect("upgrade barrier");
+    assert!(admission.admit().is_err());
+    assert!(admission.admit_turn_start().is_none());
+    assert!(admission.admit_steer(other).is_err());
+    drop(admission.admit_steer(owner).expect("checkpoint steering"));
+    admission.release_upgrade(other);
+    assert!(admission.admit().is_err());
+    admission.release_upgrade(owner);
+    drop(
+        admission
+            .admit()
+            .expect("cancelled upgrade releases new work"),
+    );
+    admission
+        .prepare_upgrade(owner, "upgrade-b")
+        .await
+        .expect("second upgrade");
+    admission.begin_drain();
+    admission.release_upgrade(owner);
+    assert!(
+        admission.admit().is_err(),
+        "upgrade cancellation cannot undo shutdown"
+    );
+}
