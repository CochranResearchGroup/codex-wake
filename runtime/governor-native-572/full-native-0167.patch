+        );
+        let directory = operation_directory(home, operation)?;
+        let lock = lock(&directory.join(format!("{thread}.recovery.lock")))?;
+        Ok(Self {
+            directory,
+            thread: thread.into(),
+            _lock: lock,
+        })
+    }
+    pub fn operation(&self) -> Result<Value> {
