diff --git a/codex-rs/tui/src/chatwidget/wake_governor.rs b/codex-rs/tui/src/chatwidget/wake_governor.rs
new file mode 100644
index 0000000000..50ed3c5db3
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/wake_governor.rs
@@ -0,0 +1,1173 @@
+//! Native presentation only. Wake's Python owner remains the accounting and effect authority.
+use super::*;
+use ratatui::text::Span;
+use serde_json::Value;
+
+#[derive(Default)]
+pub(super) struct GovernorUi {
+    snapshot: Option<Value>,
+    inspected: Option<Value>,
+    error: Option<String>,
+    selected: Option<String>,
+    selected_endpoint: Option<String>,
+    selected_home: Option<String>,
+    poll: Option<tokio::task::JoinHandle<()>>,
+    notice: Option<String>,
+    refresh: Arc<tokio::sync::Notify>,
+}
+impl Drop for GovernorUi {
+    fn drop(&mut self) {
+        if let Some(poll) = self.poll.take() {
+            poll.abort();
+        }
+    }
+}
+
+const USAGE: &str = "/wake governor [status|activate|extend|reset|disable|resume|advisory] [--token-limit N --time-limit-seconds N | --add-tokens N --add-seconds N] [--resume]";
+const VERBS: &[&str] = &[
+    "status", "activate", "extend", "reset", "disable", "resume", "advisory",
+];
+
+/// Accept only the published governor grammar. Never invoke a shell or forward model text.
+fn governor_argv(
+    input: &str,
+    selector: &str,
+    endpoint: &str,
+    revision: Option<u64>,
+) -> Result<Vec<String>, String> {
+    let words: Vec<_> = input.split_whitespace().collect();
+    let verb = words.first().copied().unwrap_or("status");
+    if !VERBS.contains(&verb) {
+        return Err(USAGE.into());
+    }
+    let mut argv = vec![
+        "governor".into(),
+        verb.into(),
+        selector.into(),
+        "--json".into(),
+        "--endpoint".into(),
+        endpoint.into(),
+    ];
+    let mut pos = 1;
+    let mut seen = std::collections::HashSet::new();
+    while pos < words.len() {
+        let flag = words[pos];
+        if !seen.insert(flag) {
+            return Err("Duplicate governor argument".into());
+        }
+        if flag == "--resume" && matches!(verb, "extend" | "reset" | "disable" | "advisory") {
+            argv.push(flag.into());
+            pos += 1;
+            continue;
+        }
+        let permitted = match verb {
+            "activate" | "reset" => matches!(flag, "--token-limit" | "--time-limit-seconds"),
+            "extend" => matches!(flag, "--add-tokens" | "--add-seconds"),
+            _ => false,
+        };
+        if !permitted
+            || pos + 1 >= words.len()
+            || words[pos + 1]
+                .parse::<u64>()
+                .ok()
+                .filter(|v| *v > 0)
+                .is_none()
+        {
+            return Err(USAGE.into());
+        }
+        argv.extend([flag.into(), words[pos + 1].into()]);
+        pos += 2;
+    }
+    if verb != "status" {
+        argv.extend(["--request-id".into(), uuid::Uuid::new_v4().to_string()]);
+        if let Some(revision) = revision {
+            argv.extend(["--expected-revision".into(), revision.to_string()]);
+        }
+    }
+    Ok(argv)
+}
+
+async fn invoke(argv: Vec<String>, thread_id: ThreadId) -> Result<Value, String> {
+    invoke_in_context(argv, thread_id, None).await
+}
+async fn invoke_in_context(
+    argv: Vec<String>,
+    thread_id: ThreadId,
+    home: Option<String>,
+) -> Result<Value, String> {
+    let recovery = argv
+        .windows(2)
+        .find(|pair| pair[0] == "--request-id")
+        .map(|pair| format!(" · reconcile request {} before retrying", pair[1]))
+        .unwrap_or_default();
+    let mut command = tokio::process::Command::new("codex-wake");
+    if let Some(home) = home {
+        command.env("CODEX_HOME", home);
+    }
+    command
+        .args(argv)
+        .env("CODEX_THREAD_ID", thread_id.to_string())
+        .kill_on_drop(true);
+    let output = tokio::time::timeout(Duration::from_secs(15), command.output())
+        .await
+        .map_err(|_| format!("Wake request timed out{recovery}"))?
+        .map_err(|error| format!("Wake disconnected: {error}{recovery}"))?;
+    let value: Value = serde_json::from_slice(&output.stdout).map_err(|_| {
+        format!("Wake returned no valid JSON; enforcement/accounting unknown{recovery}")
+    })?;
+    if !output.status.success() && value.get("state").is_none() {
+        return Err(format!(
+            "Wake request refused: {}{recovery}",
+            value
+                .pointer("/error/message")
+                .and_then(Value::as_str)
+                .or_else(|| value.pointer("/error/code").and_then(Value::as_str))
+                .unwrap_or("inspect the durable operation result")
+        ));
+    }
+    Ok(value)
+}
+
+// Bootstrap is pipe-only and validates same-user server process identity. Never log this token.
+async fn status_connection(thread_id: ThreadId) -> Result<(String, String), String> {
+    let value = invoke(vec!["control".into(), "connection".into()], thread_id)
+        .await
+        .map_err(|_| {
+            "Wake shared controller unavailable; connect it or inspect /wake governor".to_string()
+        })?;
+    let address = value
+        .get("url")
+        .and_then(Value::as_str)
+        .ok_or("Wake connection URL unavailable")?;
+    let parsed = url::Url::parse(address).map_err(|_| "Wake connection URL invalid")?;
+    if parsed.scheme() != "http"
+        || !matches!(parsed.host_str(), Some("127.0.0.1" | "::1"))
+        || parsed.port().is_none()
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.query().is_some()
+        || parsed.fragment().is_some()
+        || parsed.path() != "/"
+    {
+        return Err("Wake status requires a qualified literal loopback connection".into());
+    }
+    #[cfg(unix)]
+    if value.get("uid").and_then(Value::as_u64) != Some(unsafe { libc::geteuid() } as u64) {
+        return Err("Wake status controller has a different owner".into());
+    }
+    let token = value
+        .get("token")
+        .and_then(Value::as_str)
+        .filter(|token| {
+            (32..=128).contains(&token.len())
+                && token
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+        })
+        .ok_or("Wake connection credential invalid")?;
+    Ok((address.to_owned(), token.to_owned()))
+}
+async fn shared_status(
+    client: &reqwest::Client,
+    connection: &(String, String),
+    thread_id: ThreadId,
+    endpoint: &str,
+) -> Result<Value, String> {
+    let mut response = client.post(format!("{}/operations",connection.0)).bearer_auth(&connection.1)
+        .json(&serde_json::json!({"operation":"local.governor.status","arguments":{"selector":format!("thread:{thread_id}"),"endpoint":endpoint}}))
+        .send().await.map_err(|_|"Wake status connection lost; accounting unknown".to_string())?;
+    if !response.status().is_success() {
+        return Err("Wake status request refused; reconnect required".into());
+    }
+    let mut body = Vec::new();
+    while let Some(chunk) = response
+        .chunk()
+        .await
+        .map_err(|_| "Wake status response interrupted")?
+    {
+        if body.len() + chunk.len() > 1024 * 1024 {
+            return Err("Wake status response exceeds bound".into());
+        }
+        body.extend_from_slice(&chunk);
+    }
+    serde_json::from_slice(&body).map_err(|_| "Wake status JSON invalid; accounting unknown".into())
+}
+
+fn text(value: &Value, key: &str) -> String {
+    value
+        .get(key)
+        .filter(|v| !v.is_null())
+        .map(|v| {
+            v.as_str()
+                .map(str::to_owned)
+                .unwrap_or_else(|| v.to_string())
+        })
+        .unwrap_or_else(|| "unknown".into())
+}
+fn numeric(value: &Value, key: &str) -> Option<f64> {
+    value
+        .get(key)
+        .and_then(Value::as_f64)
+        .filter(|value| value.is_finite() && *value >= 0.0)
+}
+fn duration(seconds: Option<f64>) -> String {
+    match seconds {
+        Some(seconds) => {
+            let seconds = seconds.floor() as u64;
+            let hours = seconds / 3600;
+            let minutes = seconds / 60 % 60;
+            let tail = seconds % 60;
+            if hours > 0 {
+                format!("{hours}h {minutes:02}m")
+            } else if minutes > 0 {
+                format!("{minutes}m {tail:02}s")
+            } else {
+                format!("{tail}s")
+            }
+        }
+        None => "unknown".into(),
+    }
+}
+fn remaining_seconds(value: &Value) -> Option<f64> {
+    numeric(&value["usage"], "remaining_seconds").or_else(|| {
+        numeric(&value["limits"], "time_limit_seconds")
+            .zip(numeric(&value["usage"], "elapsed_seconds"))
+            .map(|(limit, elapsed)| (limit - elapsed).max(0.0))
+    })
+}
+fn deadline(value: &Value) -> String {
+    let basis = value
+        .get("deadline_basis")
+        .and_then(Value::as_str)
+        .or_else(|| {
+            value
+                .pointer("/owner_receipt/time_basis")
+                .and_then(Value::as_str)
+        })
+        .unwrap_or("unknown");
+    if basis.contains("counter") || basis.contains("elapsed") {
+        return "Wall deadline unavailable · authenticated host elapsed time".into();
+    }
+    if !basis.to_ascii_lowercase().contains("utc") {
+        return "Wall deadline unavailable · clock basis unqualified".into();
+    }
+    let instant = value
+        .get("deadline")
+        .and_then(Value::as_f64)
+        .filter(|seconds| seconds.is_finite() && *seconds >= 0.0 && *seconds < i64::MAX as f64)
+        .and_then(|seconds| {
+            chrono::DateTime::<chrono::Utc>::from_timestamp(seconds.floor() as i64, 0)
+        })
+        .or_else(|| {
+            value
+                .get("deadline")
+                .and_then(Value::as_str)
+                .and_then(|value| chrono::DateTime::parse_from_rfc3339(value).ok())
+                .map(|value| value.with_timezone(&chrono::Utc))
+        });
+    instant
+        .map(|instant| {
+            instant
+                .with_timezone(&chrono::Local)
+                .format("%a %b %d %H:%M:%S %Z")
+                .to_string()
+        })
+        .unwrap_or_else(|| "Wall deadline unavailable".into())
+}
+fn state_label(value: &Value) -> String {
+    text(value, "state").replace('_', " ").to_uppercase()
+}
+fn reason_label(value: &Value) -> String {
+    match value.get("reason").and_then(Value::as_str) {
+        Some("not_enrolled") => {
+            "No limits enrolled; activate when exact task work is running".into()
+        }
+        Some("watcher_stale" | "watcher_lost" | "watcher_unavailable") => {
+            "Enforcement watcher unavailable; task is held".into()
+        }
+        Some(reason) => reason.replace('_', " "),
+        None => "No additional reason reported".into(),
+    }
+}
+fn scope_label(value: &Value) -> String {
+    let scope = &value["scope"];
+    let id = scope
+        .get("thread_id")
+        .and_then(Value::as_str)
+        .unwrap_or("unknown");
+    let members = scope.get("members").and_then(Value::as_array).map(Vec::len);
+    let mut label = format!(
+        "{} {}{}",
+        text(scope, "kind"),
+        id.chars().take(8).collect::<String>(),
+        members
+            .map(|count| format!(" · {count} member{}", if count == 1 { "" } else { "s" }))
+            .unwrap_or_default()
+    );
+    if let Some(limiting) = scope.get("limiting_scope").and_then(Value::as_str) {
+        label.push_str(&format!(" · limiting {limiting}"));
+    }
+    label
+}
+fn watcher_label(value: &Value) -> &'static str {
+    match value.pointer("/watcher/fresh").and_then(Value::as_bool) {
+        Some(true) => "Healthy",
+        Some(false) => "Lost",
+        None => "Unknown",
+    }
+}
+fn meter(used: Option<u64>, limit: Option<u64>, remaining: Option<u64>) -> String {
+    match (used, limit) {
+        (Some(used), Some(limit)) if limit > 0 => {
+            let filled = ((used as u128 * 8 / limit as u128).min(8)) as usize;
+            format!(
+                "[{}{}] {used}/{limit} · {} left",
+                "━".repeat(filled),
+                "·".repeat(8 - filled),
+                remaining
+                    .map(|tokens| tokens.to_string())
+                    .unwrap_or_else(|| "unknown".into())
+            )
+        }
+        (Some(used), _) => format!("{used} used · limit unknown"),
+        _ => "usage unknown".into(),
+    }
+}
