@@ -0,0 +1,160 @@
+//! Foreground-only health response construction; never reads or mutates user input.
+use codex_app_server_protocol::TuiHealthBinding;
+use codex_app_server_protocol::TuiHealthChallengeParams;
+use codex_app_server_protocol::TuiHealthResponse;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+pub(crate) fn binding(
+    home: &std::path::Path,
+    provider: &str,
+    backend_id: String,
+) -> Option<TuiHealthBinding> {
+    #[cfg(target_os = "linux")]
+    {
+        let stat = std::fs::read_to_string("/proc/self/stat").ok()?;
+        let start_ticks = stat
+            .rsplit_once(')')?
+            .1
+            .split_whitespace()
+            .nth(19)?
+            .to_string();
+        Some(TuiHealthBinding {
+            home: home.to_str()?.into(),
+            provider: provider.into(),
+            backend_id,
+            channel: "native_tui".into(),
+            pid: std::process::id(),
+            start_ticks,
+            boot_id: std::fs::read_to_string("/proc/sys/kernel/random/boot_id")
+                .ok()?
+                .trim()
+                .into(),
+            connection_generation: uuid::Uuid::new_v4().to_string(),
+        })
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = (home, provider, backend_id);
+        None
+    }
+}
+
+pub(crate) fn reply(
+    params: &TuiHealthChallengeParams,
+    binding: Option<&TuiHealthBinding>,
+    thread: Option<String>,
+    home: &std::path::Path,
+    provider: &str,
+    controlling: bool,
+) -> TuiHealthResponse {
+    let loop_tid = std::fs::read_link("/proc/thread-self")
+        .ok()
+        .and_then(|p| p.file_name()?.to_str()?.parse::<u32>().ok())
+        .unwrap_or(0);
+    let now = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .ok()
+        .map(|v| v.as_millis() as u64);
+    let responsive = controlling
+        && binding == Some(&params.binding)
+        && thread.as_deref() == Some(params.thread_id.as_str())
+        && home.to_string_lossy() == params.binding.home
+        && provider == params.binding.provider
+        && now.is_some_and(|v| v < params.expires_at_ms)
+        && loop_tid != 0;
+    TuiHealthResponse {
+        binding: params.binding.clone(),
+        thread_id: params.thread_id.clone(),
+        challenge: params.challenge.clone(),
+        state: if responsive { "responsive" } else { "unknown" }.into(),
+        evidence: if responsive {
+            "tui_main_loop_ack"
+        } else {
+            "none"
+        }
+        .into(),
+        loop_tid,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn expired_wrong_thread_or_generation_never_acknowledges() {
+        let home = std::path::Path::new("/fixture");
+        let Some(binding) = binding(home, "fixture", "backend".into()) else {
+            return;
+        };
+        let mut p = TuiHealthChallengeParams {
+            binding: binding.clone(),
+            thread_id: "thread".into(),
+            challenge: "a".repeat(64),
+            expires_at_ms: u64::MAX,
+        };
+        assert_eq!(
+            reply(
+                &p,
+                Some(&binding),
+                Some("thread".into()),
+                home,
+                "fixture",
+                true
+            )
+            .state,
+            "responsive"
+        );
+        assert_eq!(
+            reply(
+                &p,
+                Some(&binding),
+                Some("other".into()),
+                home,
+                "fixture",
+                true
+            )
+            .state,
+            "unknown"
+        );
+        assert_eq!(
+            reply(
+                &p,
+                Some(&binding),
+                Some("thread".into()),
+                home,
+                "fixture",
+                false
+            )
+            .state,
+            "unknown"
+        );
+        p.expires_at_ms = 0;
+        assert_eq!(
+            reply(
+                &p,
+                Some(&binding),
+                Some("thread".into()),
+                home,
+                "fixture",
+                true
+            )
+            .state,
+            "unknown"
+        );
+        p.expires_at_ms = u64::MAX;
+        p.binding.connection_generation = "replacement".into();
+        assert_eq!(
+            reply(
+                &p,
+                Some(&binding),
+                Some("thread".into()),
+                home,
+                "fixture",
+                true
+            )
+            .state,
+            "unknown"
+        );
+    }
+}
