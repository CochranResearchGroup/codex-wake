+/// A trusted host's one-use admission callback. This type is never serialized.
+/// Clones share consumption; the callback rechecks the host gate at acceptance.
+#[derive(Clone)]
+pub struct TurnStartAdmissionToken(std::sync::Arc<std::sync::Mutex<Option<HostAdmissionCallback>>>);
+type HostAdmissionCallback = Box<dyn FnOnce() -> Option<Box<dyn Send>> + Send + Sync>;
+impl std::fmt::Debug for TurnStartAdmissionToken {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str("TurnStartAdmissionToken(..)")
+    }
+}
+impl TurnStartAdmissionToken {
+    pub fn new(admit: impl FnOnce() -> Option<Box<dyn Send>> + Send + Sync + 'static) -> Self {
+        Self(std::sync::Arc::new(std::sync::Mutex::new(Some(Box::new(
+            admit,
+        )))))
+    }
+    pub fn consume(self) -> Option<Box<dyn Send>> {
+        let admit = self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()?;
+        admit()
+    }
+}
