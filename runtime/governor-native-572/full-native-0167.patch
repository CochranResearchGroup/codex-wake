+    let thread_id = create_delete_test_rollout(home.path(), 0, "finished recovered work")?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_auto_env()
+        .build_initialized()
+        .await?;
+    let operation = "upgrade-deleted-conversation";
+    seed_accepted_upgrade(home.path(), operation, &thread_id, "accepted-finished")?;
+    let _: ThreadDeleteResponse = app
+        .request(|request_id| ClientRequest::ThreadDelete {
+            request_id,
+            params: ThreadDeleteParams {
+                thread_id: thread_id.clone(),
+            },
+        })
+        .await?;
+    let recovered: DaemonUpgradeRecoveryResponse = app
+        .request(|request_id| ClientRequest::DaemonUpgradeRecovery {
+            request_id,
+            params: DaemonUpgradeRecoveryParams {
+                operation_id: operation.into(),
+                thread_id: thread_id.clone(),
+                action: DaemonUpgradeRecoveryAction::Resume,
+            },
+        })
+        .await?;
+    assert_eq!(recovered.status, "alreadyResumed");
+    assert_eq!(recovered.turn_id.as_deref(), Some("accepted-finished"));
+    assert!(
+        find_thread_path_by_id_str(home.path(), &thread_id, None)
+            .await?
+            .is_none()
+    );
+    app.shutdown_gracefully().await?;
+    let mut restarted = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    restarted.start_thread(ThreadStartParams::default()).await?;
+    restarted.shutdown_gracefully().await?;
+    Ok(())
+}
+
+fn seed_accepted_upgrade(home: &Path, operation: &str, thread: &str, turn: &str) -> Result<()> {
+    let root = home.join("daemon-upgrades");
+    let directory = root.join(operation);
+    std::fs::create_dir_all(&directory)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(&root, std::fs::Permissions::from_mode(0o700))?;
+        std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o700))?;
+    }
+    for (name, value) in [
+        (
+            "state.json".to_string(),
+            json!({"schema_version":2,"recovery_enabled":true,"operation_id":operation,"phase":"recovered","threads":{thread.to_owned():{}}}),
+        ),
+        (
+            format!("{thread}.recovery.json"),
+            json!({"schema_version":2,"status":"resumed","turn_id":turn,"runtime_epoch":"prior-process"}),
+        ),
+    ] {
+        let path = directory.join(name);
+        std::fs::write(&path, serde_json::to_vec(&value)?)?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+        }
+    }
+    Ok(())
+}
