@@ -0,0 +1,620 @@
+//! Fenced continuation of one durably checkpointed conversation after an upgrade.
+use super::ThreadRequestProcessor;
+use super::ThreadResumeTarget;
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::ensure;
+use codex_app_server_daemon::upgrade_recovery::RecoveryFiles;
+use codex_app_server_daemon::upgrade_recovery::goal_control_generation;
+use codex_app_server_daemon::upgrade_recovery::matches_current_executable;
+use codex_app_server_daemon::upgrade_recovery::server_epoch;
+use codex_app_server_protocol::DaemonUpgradeRecoveryAction;
+use codex_app_server_protocol::DaemonUpgradeRecoveryParams;
+use codex_app_server_protocol::DaemonUpgradeRecoveryResponse;
+use codex_app_server_protocol::ThreadEnvironment;
+use codex_app_server_protocol::ThreadResumeParams;
+use codex_core::TurnInput;
+use codex_core::TurnInputRequest;
+use codex_core::TurnInputSubmission;
+use codex_core::TurnStartOptions;
+use codex_core::context::ContextualUserFragment;
+use codex_core::context::InternalContextSource;
+use codex_core::context::InternalModelContextFragment;
+use codex_protocol::ThreadId;
+use codex_protocol::mcp::ClientMcpExtensions;
+use codex_protocol::protocol::EnvironmentConfigState;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ThreadGoalStatus;
+use codex_rollout::RolloutItem;
+use serde_json::Value;
+use serde_json::json;
+
+fn response(
+    status: &str,
+    turn: Option<String>,
+    reason: Option<String>,
+) -> DaemonUpgradeRecoveryResponse {
+    DaemonUpgradeRecoveryResponse {
+        status: status.into(),
+        turn_id: turn,
+        reason,
+    }
+}
+impl ThreadRequestProcessor {
+    pub(crate) fn next_upgrade_recovery(&self) -> Option<String> {
+        codex_app_server_daemon::upgrade_recovery::pending_work_operations(&self.config.codex_home)
+            .map(|operations| operations.into_iter().next())
+            .unwrap_or_else(|_| Some("upgrade-recovery-unavailable".into()))
+    }
+    pub(crate) async fn restore_idle_active_goals_after_upgrade(&self) {
+        for thread_id in self.thread_manager.list_thread_ids().await {
+            let Ok(thread) = self.thread_manager.get_thread(thread_id).await else {
+                continue;
+            };
+            if !matches!(
+                thread.agent_status().await,
+                codex_protocol::protocol::AgentStatus::Completed(_)
+            ) {
+                continue;
+            }
+            let _guard = self.thread_state_manager.lock_goal_resume(thread_id).await;
+            if self
+                .thread_goal_processor
+                .upgrade_goal_state(thread_id)
+                .await
+                .is_ok_and(|state| state["goal"]["status"] == "active")
+            {
+                self.thread_goal_processor
+                    .restore_inherited_goal_runtime(thread_id)
+                    .await;
+                thread
+                    .emit_thread_idle_lifecycle_if_idle(
+                        codex_extension_api::ThreadIdleCause::Completed,
+                    )
+                    .await;
+            }
+        }
+    }
+
+    pub(crate) async fn upgrade_recovery(
+        &self,
+        params: DaemonUpgradeRecoveryParams,
+        admission: codex_protocol::turn_input::TurnStartAdmissionToken,
+    ) -> Result<DaemonUpgradeRecoveryResponse> {
+        let thread_id = ThreadId::from_string(&params.thread_id)?;
+        let home = &self.config.codex_home;
+        let files = RecoveryFiles::open(home, &params.operation_id, &params.thread_id)?;
+        let operation = files.operation()?;
+        ensure!(
+            operation["schema_version"] == 2
+                && operation["recovery_enabled"] == true
+                && operation["operation_id"] == params.operation_id,
+            "upgrade recovery authority is unavailable"
+        );
+        let entry = &operation["threads"][&params.thread_id];
+        ensure!(entry.is_object(), "conversation is not part of the upgrade");
+        let old_record = files.record()?;
+        let target_matches = params.action == DaemonUpgradeRecoveryAction::Seal
+            || matches_current_executable(&operation)?;
+        if params.action == DaemonUpgradeRecoveryAction::Resume
+            && let Some(result) = settle_lifecycle_before_restore(
+                home,
+                &params.thread_id,
+                &files,
+                old_record.as_ref(),
+            )?
+        {
+            return Ok(result);
+        }
+        if params.action == DaemonUpgradeRecoveryAction::Resume {
+            if let Some(record) = &old_record {
+                if record["status"] == "skipped" || record["status"] == "held" {
+                    return Ok(response(
+                        record["status"].as_str().unwrap_or("held"),
+                        None,
+                        record["reason"].as_str().map(str::to_owned),
+                    ));
+                }
+                if target_matches
+                    && record["status"] == "resumed"
+                    && record["runtime_epoch"] == server_epoch()
+                {
+                    // Same-process replay cannot recreate a turn, even after response loss.
+                    let mut record = record.clone();
+                    let state = self.thread_state_manager.thread_state(thread_id).await;
+                    if state.lock().await.last_terminal_turn_id.as_deref()
+                        == record["turn_id"].as_str()
+                    {
+                        record["settled"] = json!("terminalTurn");
+                        files.save(&record)?;
+                    }
+                    return Ok(response(
+                        "alreadyResumed",
+                        record["turn_id"].as_str().map(str::to_owned),
+                        None,
+                    ));
+                }
+                if target_matches
+                    && record["server_epoch"] == server_epoch()
+                    && operation["no_replacement_verified"] != true
+                {
+                    return Ok(response(
+                        "waitingReplacement",
+                        None,
+                        Some("Checkpoint saved; replacement daemon has not restarted".into()),
+                    ));
+                }
+            }
+        }
+        // Internal cold restore preserves saved runtime permissions; it is not direct user input.
+        self.thread_resume(
+            ThreadResumeTarget::DaemonRecovery(None),
+            ThreadResumeParams {
+                thread_id: params.thread_id.clone(),
+                exclude_turns: true,
+                ..Default::default()
+            },
+            None,
+            None,
+            ClientMcpExtensions::default(),
+        )
+        .await
+        .map_err(|e| anyhow::anyhow!(e.message))?;
+        let _goal_guard = self.thread_state_manager.lock_goal_resume(thread_id).await;
+        // Deletion may have won lifecycle ownership while cold resume was waiting.
+        if params.action == DaemonUpgradeRecoveryAction::Resume
+            && let Some(result) = settle_lifecycle_before_restore(
+                home,
+                &params.thread_id,
+                &files,
+                old_record.as_ref(),
+            )?
+        {
+            return Ok(result);
+        }
+        let thread = self.thread_manager.get_thread(thread_id).await?;
+        thread.flush_rollout().await?;
+        let path = thread
+            .rollout_path()
+            .context("upgrade recovery requires persistent history")?;
+        let (history, _, _) = codex_rollout::RolloutRecorder::load_rollout_items(&path).await?;
+        let latest = history.iter().rev().find_map(|item| match item {
+            RolloutItem::EventMsg(EventMsg::TurnStarted(e)) => Some(e.turn_id.clone()),
+            _ => None,
+        });
+        let native_goal = self
+            .thread_goal_processor
+            .upgrade_goal_state(thread_id)
+            .await?;
+        let generation = goal_control_generation(home, &params.thread_id)?;
+        let account = codex_app_server_daemon::upgrade_authority::account_scope(
+            home,
+            &self.config.model_provider_id,
+            self.auth_manager
+                .auth_cached()
+                .as_ref()
+                .and_then(|auth| auth.get_account_id()),
+        )?;
+        if params.action == DaemonUpgradeRecoveryAction::Resume && !target_matches {
+            let mut record = old_record.context("upgrade recovery seal missing")?;
+            if matches!(record["status"].as_str(), Some("dispatching" | "resumed"))
+                && generation == record["goal_control"]
+                && native_goal["goal_id"] == record["native_goal"]["goal_id"]
+                && native_goal["goal"]["status"] == "active"
+            {
+                self.thread_goal_processor
+                    .upgrade_goal_status(thread_id, ThreadGoalStatus::Paused)
+                    .await?;
+            }
+            if record["status"] != "resumed" {
+                record["previous_status"] = record["status"].clone();
+                record["status"] = json!("held");
+            }
+            if record["status"] == "resumed" {
+                record["settled"] = json!("replacementMismatch");
+            }
+            record["reason"] = json!(
+                "Replacement executable does not match the qualified upgrade; original work remains paused"
+            );
+            files.save(&record)?;
+            return Ok(response(
+                "held",
+                record["turn_id"].as_str().map(str::to_owned),
+                record["reason"].as_str().map(str::to_owned),
+            ));
+        }
+
+        let originally_eligible = (entry["turn_id"].is_string()
+            && (entry["goal_before"].is_null() || entry["goal_before"]["status"] == "active"))
+            || entry["goal_before"]["status"] == "active";
+        if params.action == DaemonUpgradeRecoveryAction::Seal
+            && old_record.is_none()
+            && entry["status"] == "notified"
+        {
+            // Observe before steering, including an identical independent pause.
+            let control_changed = entry["goal_before"]["status"] != native_goal["goal"]["status"];
+            let config = thread.config_snapshot().await;
+            let environment = match config.environment_selections() {
+                [environment] => serde_json::to_value(ThreadEnvironment::from(environment))?,
+                _ => Value::Null,
+            };
+            files.save(&json!({"schema_version":2,"operation_id":params.operation_id,"thread_id":params.thread_id,"status":"observed","goal_control":generation,"native_goal_before":native_goal,"control_changed":control_changed,"native_environment":environment,"server_epoch":server_epoch()}))?;
+            return Ok(response("observed", None, None));
+        }
+        let handoff = files.handoff()?;
+        ensure!(
+            handoff["upgrade_id"] == params.operation_id
+                && handoff["thread_id"] == params.thread_id,
+            "handoff identity changed"
+        );
+        if params.action == DaemonUpgradeRecoveryAction::Seal {
+            let observed =
+                old_record.context("recovery control was not observed before checkpoint")?;
+            if observed["status"] == "sealed"
+                || observed["status"] == "skipped"
+                || observed["status"] == "held"
+            {
+                return Ok(response(
+                    observed["status"].as_str().unwrap_or("held"),
+                    None,
+                    observed["reason"].as_str().map(str::to_owned),
+                ));
+            }
+            ensure!(
+                observed["status"] == "observed",
+                "upgrade recovery cannot be resealed after a dispatch attempt"
+            );
+            let controls_match = generation == observed["goal_control"]
+                && observed["control_changed"] != true
+                && native_goal["goal_id"] == observed["native_goal_before"]["goal_id"];
+            let eligible = originally_eligible
+                && (native_goal["goal"].is_null() || native_goal["goal"]["status"] == "paused");
+            let status = if !controls_match {
+                "held"
+            } else if eligible {
+                "sealed"
+            } else {
+                "skipped"
+            };
+            let reason = if !controls_match {
+                json!("User or governor goal control changed during checkpoint")
+            } else if !eligible {
+                json!("Conversation was already paused, idle, exhausted or completed")
+            } else {
+                Value::Null
+            };
+            let checkpoint = if eligible {
+                latest.context("conversation has no recoverable turn context")?
+            } else {
+                latest.unwrap_or_default()
+            };
+            if eligible {
+                ensure!(
+                    handoff["kind"] == "idle_snapshot" || handoff["ready"] == true,
+                    "handoff did not accept recovery"
+                );
+            }
+            let authority = codex_app_server_daemon::upgrade_authority::seal(
+                home,
+                &params.thread_id,
+                &native_goal,
+                &account,
+            );
+            let (resource_authority, authority_reason) = match authority {
+                Ok(envelope) => (envelope, Value::Null),
+                Err(error) => (Value::Null, json!(format!("{error:#}"))),
+            };
+            files.save(&json!({"resource_authority":resource_authority,"authority_reason":authority_reason,"schema_version":2,"operation_id":params.operation_id,"thread_id":params.thread_id,"status":status,"reason":reason,"checkpoint_turn_id":checkpoint,"goal_control":observed["goal_control"],"native_goal":native_goal,"handoff":handoff,"native_environment":observed["native_environment"],"server_epoch":observed["server_epoch"]}))?;
+            return Ok(response(status, None, reason.as_str().map(str::to_owned)));
+        }
+        ensure!(
+            matches!(
+                operation["phase"].as_str(),
+                Some("installing" | "recovering" | "recovered" | "recoveryHeld")
+            ),
+            "upgrade replacement has not been selected"
+        );
+        let mut record = old_record
+            .context("upgrade did not produce a recovery seal; conversation stays paused")?;
+        ensure!(
+            record["schema_version"] == 2,
+            "checkpoint recovery seal version is not supported"
+        );
+        if record["status"] == "resumed" {
+            let accepted = record["turn_id"]
+                .as_str()
+                .context("accepted continuation identity missing")?
+                .to_owned();
+            let terminal = history.iter().any(|item| match item {
+                RolloutItem::EventMsg(EventMsg::TurnComplete(event)) => event.turn_id == accepted,
+                RolloutItem::EventMsg(EventMsg::TurnAborted(event)) => {
+                    event.turn_id.as_deref() == Some(accepted.as_str())
+                }
+                _ => false,
+            });
+            if latest.as_deref() != Some(accepted.as_str())
+                || terminal
+                || (!native_goal["goal"].is_null() && native_goal["goal"]["status"] != "active")
+                || generation != record["goal_control"]
+            {
+                record["settled"] = json!(if terminal {
+                    "terminalTurn"
+                } else {
+                    "stoppedOrSuperseded"
+                });
+                files.save(&record)?;
+                return Ok(response("alreadyResumed", Some(accepted), None));
+            }
+            let context = history
+                .iter()
+                .rev()
+                .find_map(|item| match item {
+                    RolloutItem::TurnContext(c)
+                        if c.turn_id.as_deref() == Some(accepted.as_str()) =>
+                    {
+                        Some(c)
+                    }
+                    _ => None,
+                })
+                .context("accepted turn context is not durable; recovery remains unconfirmed")?;
+            let config = thread.config_snapshot().await;
+            let environment = match config.environment_selections() {
+                [environment] => serde_json::to_value(ThreadEnvironment::from(environment))?,
+                _ => Value::Null,
+            };
+            if native_goal["goal_id"] != record["native_goal"]["goal_id"]
+                || environment != record["native_environment"]
+                || context.permission_profile() != config.permission_profile
+            {
+                if generation == record["goal_control"]
+                    && native_goal["goal_id"] == record["native_goal"]["goal_id"]
+                    && native_goal["goal"]["status"] == "active"
+                {
+                    self.thread_goal_processor
+                        .upgrade_goal_status(thread_id, ThreadGoalStatus::Paused)
+                        .await?;
+                }
+                record["settled"] = json!("authorityChanged");
+                files.save(&record)?;
+                return Ok(response(
+                    "held",
+                    Some(accepted),
+                    Some("Accepted work has changed authority; no recovery was submitted".into()),
+                ));
+            }
+            if let (Some(limit), Some(used)) = (
+                native_goal["goal"]["tokenBudget"].as_i64(),
+                native_goal["goal"]["tokensUsed"].as_i64(),
+            ) {
+                if used >= limit {
+                    if native_goal["goal"]["status"] == "active" {
+                        self.thread_goal_processor
+                            .upgrade_goal_status(thread_id, ThreadGoalStatus::Paused)
+                            .await?;
+                    }
+                    record["settled"] = json!("allowanceExhausted");
+                    files.save(&record)?;
+                    return Ok(response(
+                        "held",
+                        Some(accepted),
+                        Some("Original token allowance is exhausted".into()),
+                    ));
+                }
+            }
+            if let Err(error) = codex_app_server_daemon::upgrade_authority::validate(
+                home,
+                &params.thread_id,
+                &record["resource_authority"],
+                &native_goal,
+                &account,
+                &handoff["resource_state"],
+            ) {
+                if generation == record["goal_control"] && native_goal["goal"]["status"] == "active"
+                {
+                    self.thread_goal_processor
+                        .upgrade_goal_status(thread_id, ThreadGoalStatus::Paused)
+                        .await?;
+                }
+                record["settled"] = json!("authorityUnverified");
+                record["reason"] = json!(format!("{error:#}"));
+                files.save(&record)?;
+                return Ok(response(
+                    "held",
+                    Some(accepted),
+                    record["reason"].as_str().map(str::to_owned),
+                ));
+            }
+            let result = thread
+                .recover_turn_if_idle_with_admission(
+                    codex_protocol::turn_input::RecoverTurnRequest {
+                        turn_id: accepted.clone(),
+                        thread_settings: Default::default(),
+                        trace: None,
+                        cyber_access_program: context.cyber_access_program.clone().map(Into::into),
+                    },
+                    admission,
+                )
+                .await?;
+            match result {
+                codex_protocol::turn_input::StartIfIdleSubmission::Started { turn_id, .. } => {
+                    ensure!(
+                        turn_id == accepted,
+                        "accepted recovery turn identity changed"
+                    );
+                    record["last_recovery_epoch"] = json!(server_epoch());
+                    record["runtime_epoch"] = json!(server_epoch());
+                    files.save(&record)?;
+                    return Ok(response(
+                        "alreadyResumed",
+                        Some(accepted),
+                        Some(
+                            "Interrupted accepted work continued under its original turn identity"
+                                .into(),
+                        ),
+                    ));
+                }
+                codex_protocol::turn_input::StartIfIdleSubmission::NotSubmitted { reason } => {
+                    return Ok(response(
+                        "held",
+                        Some(accepted),
+                        Some(format!(
+                            "Accepted turn recovery was not admitted: {reason:?}"
+                        )),
+                    ));
+                }
+            }
+        }
+        let expected = record["checkpoint_turn_id"]
+            .as_str()
+            .context("checkpoint turn missing")?
+            .to_owned();
+        let marker = format!(
+            "DAEMON_UPGRADE_RESUME:{}:{}",
+            params.operation_id, params.thread_id
+        );
+        let mut activated = false;
+        let attempt=async {
+            ensure!(record["handoff"]==handoff,"durable handoff changed after sealing");
+            ensure!(generation==record["goal_control"],"User or governor goal control changed after checkpoint");
+            ensure!(native_goal["goal_id"]==record["native_goal"]["goal_id"],"original native goal was replaced");
+            if record["status"]=="dispatching" {
+                let later=history.iter().enumerate().filter_map(|(index,item)|match item {RolloutItem::EventMsg(EventMsg::TurnStarted(event))=>Some((index,event)),_=>None})
+                    .skip_while(|(_,event)|event.turn_id!=expected).skip(1).collect::<Vec<_>>();
+                if let [(index,candidate)]=later.as_slice() {
+                    let attributed=candidate.turn_attribution.as_ref().is_some_and(|attribution|
+                        attribution.turn_id==candidate.turn_id && attribution.turn_trigger.as_deref()==Some("daemon_upgrade")
+                        && attribution.root_turn_id.as_deref()==record["root_turn_id"].as_str());
+                    let prefix=format!("<codex_internal_context source=\"daemon_upgrade\">\n{marker}.");
+                    let marked=history[index+1..].iter().take_while(|item|!matches!(item,RolloutItem::EventMsg(EventMsg::TurnStarted(_)))).any(|item|{
+                        let RolloutItem::ResponseItem(envelope)=item else {return false;};
+                        let codex_protocol::models::ResponseItem::Message {role,content,internal_chat_message_metadata_passthrough,..}=&envelope.item else {return false;};
+                        role=="user" && internal_chat_message_metadata_passthrough.as_ref().and_then(|metadata|metadata.content_item_kinds.as_ref()).is_some_and(|kinds|
+                            kinds.len()==content.len() && content.iter().zip(kinds).any(|(item,kind)|kind.0=="daemon_upgrade.internal_context"
+                                && matches!(item,codex_protocol::models::ContentItem::InputText{text} if text.starts_with(&prefix))))
+                    });
+                    if attributed && marked {return Ok(candidate.turn_id.clone());}
+                }
+                anyhow::bail!("Recovery delivery is unknown; no duplicate continuation was submitted");
+            }
+            ensure!(record["status"]=="sealed","recovery acceptance record is not eligible");
+            ensure!(matches!(files.operation()?["phase"].as_str(),Some("installing"|"recovering")),"upgrade recovery was stopped before delivery");
+            ensure!(!matches!(thread.agent_status().await,codex_protocol::protocol::AgentStatus::Running),"conversation already has active work");
+            ensure!(latest.as_deref()==Some(&expected),"Newer work superseded the checkpoint");
+            ensure!(native_goal==record["native_goal"],"native goal authority or accounting changed after sealing");
+            let goal=&native_goal["goal"];
+            ensure!(goal.is_null() || goal["status"]=="paused","native goal did not remain paused");
+            if let (Some(limit),Some(used))=(goal["tokenBudget"].as_i64(),goal["tokensUsed"].as_i64()) {ensure!(used<limit,"Original token allowance is exhausted");}
+            codex_app_server_daemon::upgrade_authority::validate(home, &params.thread_id, &record["resource_authority"], &native_goal, &account, &handoff["resource_state"])?;
+            let context=history.iter().rev().find_map(|item|match item {RolloutItem::TurnContext(c) if c.turn_id.as_deref()==Some(&expected)=>Some(c),_=>None}).context("original turn context is unavailable")?;
+            let config=thread.config_snapshot().await;
+            let [environment]=config.environment_selections() else {anyhow::bail!("ambiguous executor selection")};
+            ensure!(environment.environment_id==codex_exec_server::LOCAL_ENVIRONMENT_ID && environment.config==EnvironmentConfigState::FromThread,"upgrade recovery requires the original local executor");
+            ensure!(context.permission_profile()==config.permission_profile,"saved permission policy changed");
+            ensure!(serde_json::to_value(ThreadEnvironment::from(environment))?==record["native_environment"],"original executor selection changed");
+            let root_turn_id=context.root_turn_id.clone().or_else(||history.iter().find_map(|item|match item {RolloutItem::EventMsg(EventMsg::TurnStarted(event)) if event.turn_id==expected=>event.root_turn_id.clone(),_=>None}));
+            ensure!(root_turn_id.is_some(),"original root turn attribution is unavailable");
+            record["root_turn_id"]=json!(root_turn_id);
+            record["status"]=json!("dispatching");record["dispatch_epoch"]=json!(server_epoch()); files.save(&record)?;
+            if !goal.is_null() {
+                activated=true;
+                self.thread_goal_processor.upgrade_goal_status(thread_id,ThreadGoalStatus::Active).await?;
+            }
+            let packet=json!({"operation_id":params.operation_id,"thread_id":params.thread_id,"checkpoint_turn_id":expected,"handoff":handoff,"goal_before":entry["goal_before"]});
+            let continuation=ContextualUserFragment::into(InternalModelContextFragment::new(InternalContextSource::from_static("daemon_upgrade"),&format!("{marker}. The qualified daemon upgrade completed. Read this durable handoff, recheck existing authority and pending operations, and continue only the original unfinished work. No new scope, grant, deadline or budget is authorized. Reconcile uncertain actions before repetition. UPGRADE_RECOVERY_JSON={packet}")));
+            let request=TurnInputRequest::new(TurnInput::ResponseItem(continuation)).on_start(TurnStartOptions {host_admission:Some(admission),turn_trigger:Some("daemon_upgrade".into()),root_turn_id,..Default::default()});
+            match thread.continue_turn_if_idle(request,expected.clone()).await? {
+                TurnInputSubmission::Started{turn_id,..}=>Ok(turn_id),
+                TurnInputSubmission::NotSubmitted{reason}=>anyhow::bail!("Continuation was not admitted: {reason:?}"),
+                TurnInputSubmission::Steered{..}=>anyhow::bail!("recovery cannot steer unrelated work"),
+            }
+        }.await;
+        match attempt {
+            Ok(turn_id) => {
+                record["status"] = json!("resumed");
+                record["turn_id"] = json!(turn_id);
+                record["acceptance_epoch"] = record["dispatch_epoch"].clone();
+                record["runtime_epoch"] = record["dispatch_epoch"].clone();
+                // A fast turn can complete before its submission response is journaled.
+                if let Some(reason) = codex_app_server_daemon::upgrade_lifecycle::settled_reason(
+                    home,
+                    &params.thread_id,
+                    &record,
+                )? {
+                    record["settled"] = json!(reason);
+                }
+                files.save(&record)?;
+                if let Err(error) = thread.flush_rollout().await {
+                    tracing::warn!(%thread_id,%error,"upgrade continuation accepted; history flush failed");
+                }
+                crate::extensions::send_thread_warning(
+                    &self.outgoing,
+                    &self.thread_state_manager,
+                    thread_id,
+                    "Resuming work from the daemon upgrade handoff; original limits preserved"
+                        .into(),
+                )
+                .await;
+                Ok(response("resumed", Some(turn_id), None))
+            }
+            Err(error) => {
+                if (activated || record["status"] == "dispatching")
+                    && !native_goal["goal"].is_null()
+                    && native_goal["goal_id"] == record["native_goal"]["goal_id"]
+                    && generation == record["goal_control"]
+                {
+                    self.thread_goal_processor
+                        .upgrade_goal_status(thread_id, ThreadGoalStatus::Paused)
+                        .await?;
+                }
+                let reason = format!("{error:#}");
+                record["status"] = json!("held");
+                record["reason"] = json!(reason);
+                files.save(&record)?;
+                crate::extensions::send_thread_warning(
+                    &self.outgoing,
+                    &self.thread_state_manager,
+                    thread_id,
+                    format!("Upgrade recovery paused: {reason}"),
+                )
+                .await;
+                Ok(response("held", None, Some(reason)))
+            }
+        }
+    }
+}
+
+/// Resolve authoritative lifecycle evidence without requiring history that deletion removed.
+fn settle_lifecycle_before_restore(
+    home: &std::path::Path,
+    thread: &str,
+    files: &RecoveryFiles,
+    record: Option<&Value>,
+) -> Result<Option<DaemonUpgradeRecoveryResponse>> {
+    let source = record.cloned().unwrap_or(Value::Null);
+    let Some(reason) =
+        codex_app_server_daemon::upgrade_lifecycle::settled_reason(home, thread, &source)?
+    else {
+        return Ok(None);
+    };
+    let mut settled = source;
+    if settled.is_null() {
+        settled = json!({"schema_version":2,"status":"skipped"});
+    }
+    settled["settled"] = json!(reason);
+    settled["reason"] = json!(if reason == "conversationDeleted" {
+        "Conversation was deliberately deleted; automatic recovery is canceled"
+    } else {
+        "Accepted recovery turn reached a native terminal event"
+    });
+    // Preserve dispatching/unknown state and accepted identity rather than inventing rejection.
+    files.save(&settled)?;
+    Ok(Some(response(
+        if settled["status"] == "resumed" {
+            "alreadyResumed"
+        } else {
+            "skipped"
+        },
+        settled["turn_id"].as_str().map(str::to_owned),
+        settled["reason"].as_str().map(str::to_owned),
+    )))
+}
diff --git a/codex-rs/app-server/src/tui_health.rs b/codex-rs/app-server/src/tui_health.rs
new file mode 100644
index 0000000000..6fab66443c
--- /dev/null
+++ b/codex-rs/app-server/src/tui_health.rs
@@ -0,0 +1,234 @@
+//! Connection-scoped read-only foreground-loop challenges. Metadata is never liveness.
+use crate::outgoing_message::ConnectionId;
+use crate::outgoing_message::OutgoingMessageSender;
+use codex_app_server_protocol::*;
+use std::collections::HashMap;
+use std::collections::VecDeque;
+use std::time::Duration;
+use std::time::Instant;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+use tokio::sync::Mutex;
+
+pub(crate) struct TuiHealth {
+    state: Mutex<State>,
+    home: std::path::PathBuf,
+}
+#[derive(Default)]
+struct State {
+    bindings: HashMap<ConnectionId, TuiHealthBinding>,
+    // Timed-out requests stay bounded until the loop drains them or disconnects.
+    pending: HashMap<RequestId, ConnectionId>,
+    seen: HashMap<ConnectionId, VecDeque<(String, Instant)>>,
+}
+fn error(message: &str) -> JSONRPCErrorError {
+    JSONRPCErrorError {
+        code: -32001,
+        message: message.into(),
+        data: None,
+    }
+}
+impl TuiHealth {
+    pub(crate) fn new(home: std::path::PathBuf) -> Self {
+        Self {
+            state: Mutex::new(State::default()),
+            home,
+        }
+    }
+    pub(crate) async fn register(
+        &self,
+        connection: ConnectionId,
+        peer_pid: Option<u32>,
+        params: TuiHealthRegisterParams,
+    ) -> std::result::Result<TuiHealthRegisterResponse, JSONRPCErrorError> {
+        let b = params.binding;
+        if self.home.to_str() != Some(b.home.as_str()) {
+            return Err(error(
+                "TUI account home differs from owning native server or is not UTF-8",
+            ));
+        }
+        if peer_pid != Some(b.pid) {
+            return Err(error(
+                "TUI binding requires exact kernel-observed local process",
+            ));
+        }
+        #[cfg(target_os = "linux")]
+        {
+            let identity = std::fs::read_to_string(format!("/proc/{}/stat", b.pid))
+                .ok()
+                .and_then(|v| {
+                    v.rsplit_once(')')
+                        .and_then(|(_, fields)| fields.split_whitespace().nth(19))
+                        .map(str::to_string)
+                });
+            let boot = std::fs::read_to_string("/proc/sys/kernel/random/boot_id").ok();
+            if identity.as_deref() != Some(b.start_ticks.as_str())
+                || boot.as_deref().map(str::trim) != Some(b.boot_id.as_str())
+            {
+                return Err(error("TUI process generation unavailable"));
+            }
+        }
+        #[cfg(not(target_os = "linux"))]
+        {
+            return Err(error("TUI process generation unsupported on this platform"));
+        }
+        if [
+            &b.home,
+            &b.provider,
+            &b.backend_id,
+            &b.start_ticks,
+            &b.boot_id,
+            &b.connection_generation,
+        ]
+        .iter()
+        .any(|v| v.is_empty() || v.len() > 4096)
+            || b.channel != "native_tui"
+            || b.pid == 0
+        {
+            return Err(error("unsupported TUI binding"));
+        }
+        let mut state = self.state.lock().await;
+        if state.bindings.contains_key(&connection) || state.bindings.len() >= 256 {
+            return Err(error(
+                "TUI binding already registered or capacity exhausted",
+            ));
+        }
+        state.bindings.insert(connection, b);
+        Ok(TuiHealthRegisterResponse { registered: true })
+    }
+    pub(crate) async fn describe(
+        &self,
+        params: TuiHealthDescribeParams,
+    ) -> TuiHealthDescribeResponse {
+        TuiHealthDescribeResponse {
+            bindings: self
+                .state
+                .lock()
+                .await
+                .bindings
+                .values()
+                .filter(|v| v.pid == params.pid)
+                .cloned()
+                .collect(),
+        }
+    }
+    pub(crate) async fn retire(&self, connection: ConnectionId, id: &RequestId) {
+        let mut state = self.state.lock().await;
+        if state.pending.get(id) == Some(&connection) {
+            state.pending.remove(id);
+        }
+    }
+    pub(crate) async fn disconnect(
+        &self,
+        connection: ConnectionId,
+        outgoing: &OutgoingMessageSender,
+    ) {
+        let ids = {
+            let mut state = self.state.lock().await;
+            state.bindings.remove(&connection);
+            state.seen.remove(&connection);
+            let ids: Vec<_> = state
+                .pending
+                .iter()
+                .filter(|(_, c)| **c == connection)
+                .map(|(id, _)| id.clone())
+                .collect();
+            for id in &ids {
+                state.pending.remove(id);
+            }
+            ids
+        };
+        for id in ids {
+            outgoing.cancel_request(&id).await;
+        }
+    }
+    pub(crate) async fn probe(
+        &self,
+        params: TuiHealthProbeParams,
+        outgoing: &OutgoingMessageSender,
+    ) -> std::result::Result<TuiHealthResponse, JSONRPCErrorError> {
+        if !(50..=5000).contains(&params.timeout_ms)
+            || params.challenge.len() != 64
+            || !params.challenge.bytes().all(|b| b.is_ascii_hexdigit())
+            || params.thread_id.len() > 128
+        {
+            return Err(error("invalid bounded health challenge"));
+        }
+        // Serialize registration and dispatch, limiting queued foreground events even after timeout.
+        let mut state = self.state.lock().await;
+        let matches: Vec<_> = state
+            .bindings
+            .iter()
+            .filter(|(_, b)| **b == params.binding)
+            .map(|(c, _)| *c)
+            .collect();
+        if matches.len() != 1 {
+            return Err(error("exact TUI connection unavailable or ambiguous"));
+        }
+        let connection = matches[0];
+        let seen = state.seen.entry(connection).or_default();
+        let now = Instant::now();
+        while seen
+            .front()
+            .is_some_and(|(_, at)| now.duration_since(*at) >= Duration::from_secs(30))
+        {
+            seen.pop_front();
+        }
+        if seen.len() >= 64 || seen.iter().any(|(nonce, _)| nonce == &params.challenge) {
+            return Err(error("duplicate challenge or challenge rate exhausted"));
+        }
+        seen.push_back((params.challenge.clone(), now));
+        if state.pending.values().filter(|c| **c == connection).count() >= 8 {
+            return Err(error("foreground challenge capacity exhausted"));
+        }
+        let expires_at_ms = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(|_| error("clock unavailable"))?
+            .as_millis() as u64
+            + u64::from(params.timeout_ms);
+        let request = TuiHealthChallengeParams {
+            binding: params.binding.clone(),
+            thread_id: params.thread_id.clone(),
+            challenge: params.challenge.clone(),
+            expires_at_ms,
+        };
+        let (id, receiver) = outgoing
+            .send_request_to_connections(
+                Some(&[connection]),
+                ServerRequestPayload::TuiHealthChallenge(request),
+                None,
+            )
+            .await;
+        state.pending.insert(id.clone(), connection);
+        drop(state);
+        let result = tokio::time::timeout(
+            Duration::from_millis(u64::from(params.timeout_ms)),
+            receiver,
+        )
+        .await;
+        // Callback is removed on deadline. The bounded tombstone remains until a late reply or disconnect.
+        outgoing.cancel_request(&id).await;
+        match result {
+            Ok(Ok(Ok(value))) => {
+                self.retire(connection, &id).await;
+                let response: TuiHealthResponse =
+                    serde_json::from_value(value).map_err(|_| error("invalid foreground reply"))?;
+                if response.binding != params.binding
+                    || response.thread_id != params.thread_id
+                    || response.challenge != params.challenge
+                    || response.evidence != "tui_main_loop_ack"
+                    || response.state != "responsive"
+                    || response.loop_tid == 0
+                {
+                    return Err(error("foreground reply mismatch or unavailable"));
+                }
+                Ok(response)
+            }
+            Ok(_) => {
+                self.retire(connection, &id).await;
+                Err(error("foreground reply unavailable"))
+            }
+            Err(_) => Err(error("foreground loop deadline expired")),
+        }
+    }
+}
diff --git a/codex-rs/app-server/src/tui_health_tests.rs b/codex-rs/app-server/src/tui_health_tests.rs
new file mode 100644
index 0000000000..e732cd0535
--- /dev/null
+++ b/codex-rs/app-server/src/tui_health_tests.rs
@@ -0,0 +1,267 @@
+//! Routing/bounds tests use the real outgoing owner. They do not qualify a TUI loop.
+use super::tui_health::TuiHealth;
+use crate::outgoing_message::ConnectionId;
+use crate::outgoing_message::OutgoingEnvelope;
+use crate::outgoing_message::OutgoingMessageSender;
+use codex_analytics::AnalyticsEventsClient;
+use codex_app_server_protocol::*;
+use codex_protocol::ThreadId;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::mpsc;
+
+fn binding() -> TuiHealthBinding {
+    TuiHealthBinding {
+        home: "/synthetic".into(),
+        provider: "synthetic".into(),
+        backend_id: "backend".into(),
+        channel: "native_tui".into(),
+        pid: std::process::id(),
+        start_ticks: std::fs::read_to_string("/proc/self/stat")
+            .unwrap()
+            .rsplit_once(')')
+            .unwrap()
+            .1
+            .split_whitespace()
+            .nth(19)
+            .unwrap()
+            .into(),
+        boot_id: std::fs::read_to_string("/proc/sys/kernel/random/boot_id")
+            .unwrap()
+            .trim()
+            .into(),
+        connection_generation: "generation".into(),
+    }
+}
+fn params(binding: &TuiHealthBinding, nonce: u32) -> TuiHealthProbeParams {
+    TuiHealthProbeParams {
+        binding: binding.clone(),
+        thread_id: ThreadId::new().to_string(),
+        challenge: format!("{nonce:064x}"),
+        timeout_ms: 50,
+    }
+}
+
+#[tokio::test]
+async fn health_challenge_owner_cannot_be_resolved_by_other_connections_or_replayed_as_input() {
+    let (sender, mut messages) = mpsc::channel(16);
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        sender,
+        AnalyticsEventsClient::disabled(),
+    ));
+    let service = Arc::new(TuiHealth::new("/synthetic".into()));
+    let binding = binding();
+    let owner = ConnectionId(1);
+    let other = ConnectionId(2);
+    assert!(
+        service
+            .register(
+                owner,
+                Some(binding.pid + 1),
+                TuiHealthRegisterParams {
+                    binding: binding.clone()
+                }
+            )
+            .await
+            .is_err()
+    );
+    let mut other_account = binding.clone();
+    other_account.home = "/different-native-account".into();
+    assert!(
+        service
+            .register(
+                owner,
+                Some(binding.pid),
+                TuiHealthRegisterParams {
+                    binding: other_account
+                }
+            )
+            .await
+            .is_err()
+    );
+    service
+        .register(
+            owner,
+            Some(binding.pid),
+            TuiHealthRegisterParams {
+                binding: binding.clone(),
+            },
+        )
+        .await
+        .unwrap();
+    let mut p = params(&binding, 1);
+    p.timeout_ms = 5000;
+    let expected = p.clone();
+    let (s, o) = (service.clone(), outgoing.clone());
+    let mut probe = tokio::spawn(async move { s.probe(p, &o).await });
+    let message = messages.recv().await.unwrap();
+    let id = match message {
+        OutgoingEnvelope::ToConnection {
+            connection_id,
+            message: codex_app_server_transport::OutgoingMessage::Request(request),
+            ..
+        } => {
+            assert_eq!(connection_id, owner);
+            assert!(matches!(&request, ServerRequest::TuiHealthChallenge { .. }));
+            request.id().clone()
+        }
+        _ => panic!("health request not targeted"),
+    };
+    assert!(
+        outgoing
+            .pending_requests_for_thread(ThreadId::from_string(&expected.thread_id).unwrap())
+            .await
+            .is_empty()
+    );
+    let response = TuiHealthResponse {
+        binding: binding.clone(),
+        thread_id: expected.thread_id,
+        challenge: expected.challenge,
+        state: "responsive".into(),
+        evidence: "tui_main_loop_ack".into(),
+        loop_tid: 1,
+    };
+    outgoing
+        .notify_client_response(other, id.clone(), serde_json::to_value(&response).unwrap())
+        .await;
+    outgoing
+        .notify_client_error(
+            other,
+            id.clone(),
+            JSONRPCErrorError {
+                code: -32001,
+                message: "wrong peer".into(),
+                data: None,
+            },
+        )
+        .await;
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), &mut probe)
+            .await
+            .is_err()
+    );
+    outgoing
+        .replay_requests_to_connection_for_thread(other, ThreadId::new())
+        .await;
+    assert!(messages.try_recv().is_err());
+    outgoing
+        .notify_client_response(owner, id, serde_json::to_value(response).unwrap())
+        .await;
+    assert!(probe.await.unwrap().is_ok());
+}
+
+#[tokio::test]
+async fn expired_foreground_events_are_bounded_until_exact_origin_drains_or_disconnects() {
+    let (sender, mut messages) = mpsc::channel(16);
+    let outgoing = OutgoingMessageSender::new(sender, AnalyticsEventsClient::disabled());
+    let service = TuiHealth::new("/synthetic".into());
+    let binding = binding();
+    let owner = ConnectionId(1);
+    let other = ConnectionId(2);
+    service
+        .register(
+            owner,
+            Some(binding.pid),
+            TuiHealthRegisterParams {
+                binding: binding.clone(),
+            },
+        )
+        .await
+        .unwrap();
+    let mut ids = Vec::new();
+    for nonce in 0..8 {
+        assert!(
+            service
+                .probe(params(&binding, nonce), &outgoing)
+                .await
+                .unwrap_err()
+                .message
+                .contains("deadline")
+        );
+        if let OutgoingEnvelope::ToConnection {
+            message: codex_app_server_transport::OutgoingMessage::Request(request),
+            ..
+        } = messages.recv().await.unwrap()
+        {
+            ids.push(request.id().clone());
+        }
+    }
+    assert_eq!(ids.len(), 8);
+    assert!(
+        service
+            .probe(params(&binding, 9), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("capacity")
+    );
+    service.retire(other, &ids[0]).await;
+    assert!(
+        service
+            .probe(params(&binding, 10), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("capacity")
+    );
+    service.retire(owner, &ids[0]).await;
+    assert!(
+        service
+            .probe(params(&binding, 11), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("deadline")
+    );
+    service.disconnect(owner, &outgoing).await;
+    assert!(
+        service
+            .describe(TuiHealthDescribeParams { pid: binding.pid })
+            .await
+            .bindings
+            .is_empty()
+    );
+    assert!(
+        service
+            .probe(params(&binding, 12), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("unavailable")
+    );
+}
+
+#[tokio::test]
+async fn full_outgoing_channel_refuses_health_without_waiting_for_foreground() {
+    let (sender, _messages) = mpsc::channel(1);
+    let outgoing = OutgoingMessageSender::new(sender, AnalyticsEventsClient::disabled());
+    let service = TuiHealth::new("/synthetic".into());
+    let binding = binding();
+    let owner = ConnectionId(1);
+    service
+        .register(
+            owner,
+            Some(binding.pid),
+            TuiHealthRegisterParams {
+                binding: binding.clone(),
+            },
+        )
+        .await
+        .unwrap();
+    assert!(
+        service
+            .probe(params(&binding, 1), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("deadline")
+    );
+    let refused = tokio::time::timeout(
+        Duration::from_secs(1),
+        service.probe(params(&binding, 2), &outgoing),
+    )
+    .await
+    .unwrap()
+    .unwrap_err();
+    assert!(refused.message.contains("reply unavailable"));
+}
diff --git a/codex-rs/app-server/src/turn_admission.rs b/codex-rs/app-server/src/turn_admission.rs
index 552875473b..9271cadba0 100644
--- a/codex-rs/app-server/src/turn_admission.rs
+++ b/codex-rs/app-server/src/turn_admission.rs
@@ -8,12 +8,16 @@ use tokio::sync::watch;
 
 use crate::error_code::invalid_request;
 use crate::error_code::server_draining_error;
+use crate::outgoing_message::ConnectionId;
 
 #[derive(Debug, Default)]
 struct AdmissionState {
     closed: bool,
     paused: bool,
+    upgrade: Option<(Option<ConnectionId>, String)>,
     active: usize,
+    release_when_idle: bool,
+    release_to_boot: Option<String>,
 }
 
 #[derive(Clone, Debug)]
@@ -42,7 +46,7 @@ impl TurnAdmission {
                 .state
                 .lock()
                 .unwrap_or_else(std::sync::PoisonError::into_inner);
-            if state.closed || state.paused {
+            if state.closed || state.paused || state.upgrade.is_some() {
                 return Err(invalid_request("Runtime changes are already paused"));
             }
             state.paused = true;
@@ -58,11 +62,66 @@ impl TurnAdmission {
         Ok(pause)
     }
 
+    pub(crate) fn with_pending_upgrade(operation: Option<String>) -> Self {
+        let admission = Self::default();
+        if let Some(operation) = operation {
+            admission
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .upgrade = Some((None, operation));
+        }
+        admission
+    }
+
+    /// Only the native recovery driver may advance an unattached startup fence.
+    /// A connection-owned operation and an actual shutdown drain always retain custody.
+    pub(crate) fn reconcile_boot_upgrade(&self, pending: Option<String>) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !state.closed
+            && state.active == 0
+            && state
+                .upgrade
+                .as_ref()
+                .is_some_and(|(owner, _)| owner.is_none())
+        {
+            state.upgrade = pending.map(|operation| (None, operation));
+            self.active_tx.send_modify(|_| {});
+        }
+    }
+
+    pub(crate) async fn admit_after_upgrade_recovery(
+        &self,
+    ) -> Result<TurnPermit, JSONRPCErrorError> {
+        let mut changes = self.subscribe_active();
+        loop {
+            if let Ok(permit) = self.admit() {
+                return Ok(permit);
+            }
+            if self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .closed
+            {
+                return Err(server_draining_error());
+            }
