+        let mut listener = codex_uds::UnixListener::bind(&socket).await.unwrap();
+        let seen = Arc::new(Mutex::new(Vec::new()));
+        let server_seen = Arc::clone(&seen);
+        let server = tokio::spawn(async move {
+            loop {
+                let connection = listener.accept().await.unwrap();
+                let mut websocket = tokio_tungstenite::accept_async(connection).await.unwrap();
+                while let Some(Ok(frame)) = websocket.next().await {
+                    let Ok(text) = frame.to_text() else { break };
+                    let request: Value = serde_json::from_str(text).unwrap();
+                    let result = match request["method"].as_str() {
+                        Some("initialize") => {
+                            json!({"userAgent":"qualification","codexHome":"/isolated","platformFamily":"unix","platformOs":std::env::consts::OS})
+                        }
+                        Some("initialized") => continue,
+                        Some("daemon/upgrade/prepare") => json!({"ready":true}),
+                        Some("daemon/upgrade/recovery") => {
+                            let thread = request["params"]["threadId"].as_str().unwrap();
+                            server_seen.lock().unwrap().push(thread.to_string());
+                            // The native boundary writes its acceptance disposition before replying.
+                            upgrade_checkpoints::durable(
+                                &directory.join(format!("{thread}.recovery.json")),
+                                &json!({"status":"skipped"}),
+                            )
+                            .unwrap();
+                            json!({"status":"skipped"})
+                        }
+                        method => panic!("unexpected control method: {method:?}"),
+                    };
+                    if websocket
+                        .send(tokio_tungstenite::tungstenite::Message::Text(
+                            json!({"id":request["id"],"result":result})
+                                .to_string()
+                                .into(),
+                        ))
+                        .await
+                        .is_err()
+                    {
+                        break;
+                    }
+                }
+            }
+        });
+
+        resume_pending(home.path()).await.unwrap();
+        assert_eq!(seen.lock().unwrap().len(), 16);
+        assert_eq!(pending_work_operations(home.path()).unwrap().len(), 1);
+        resume_pending(home.path()).await.unwrap();
+        assert!(pending_work_operations(home.path()).unwrap().is_empty());
+        let calls = seen.lock().unwrap();
+        assert_eq!(calls.len(), 17);
+        assert_eq!(calls.iter().collect::<BTreeSet<_>>().len(), 17);
+        server.abort();
+    }
+
+    #[test]
+    fn mixed_held_operation_keeps_unfinished_accepted_work_pending_after_restart() {
+        let home = tempfile::tempdir().unwrap();
+        let root = home.path().join("daemon-upgrades");
+        private_dir(&root, true).unwrap();
+        let operation = "upgrade-mixed-outcomes";
+        let directory = root.join(operation);
+        private_dir(&directory, true).unwrap();
+        let thread = "019abcde-0000-7000-8000-000000000001".to_string();
+        upgrade_checkpoints::durable(&directory.join("state.json"),&json!({"schema_version":2,"recovery_enabled":true,"phase":"recoveryHeld","threads":{thread.clone():{}}})).unwrap();
+        let receipt = directory.join(format!("{thread}.recovery.json"));
+        let mut record = json!({"status":"resumed","runtime_epoch":"previous-process","turn_id":"accepted-original","settled":null});
+        upgrade_checkpoints::durable(&receipt, &record).unwrap();
+        assert_eq!(
+            pending_operations(home.path()).unwrap(),
+            vec![operation.to_string()]
+        );
+        record["settled"] = json!("terminalTurn");
+        upgrade_checkpoints::durable(&receipt, &record).unwrap();
+        assert!(pending_operations(home.path()).unwrap().is_empty());
+    }
+}
