+#[derive(Clone, serde::Serialize, serde::Deserialize)]
+struct GuardedStartJournal {
+    root: ThreadId,
+    lease_id: String,
+    controller_generation: String,
+    enrollment_revision: u64,
+    request_id: String,
+    text_hash: String,
+    start_state: String,
+    started_turn_id: Option<String>,
+}
+impl ThreadGoalRequestProcessor {
+    fn start_journal_path(&self, root: ThreadId, request: &str) -> std::path::PathBuf {
+        use sha2::Digest;
+        self.lease_directory().join(format!(
+            "start-{:x}.json",
+            sha2::Sha256::digest(format!("{root}:{request}").as_bytes())
+        ))
+    }
+    fn read_start_journal(
+        &self,
+        root: ThreadId,
+        request: &str,
+    ) -> Result<Option<GuardedStartJournal>, JSONRPCErrorError> {
+        let path = self.start_journal_path(root, request);
+        match std::fs::symlink_metadata(&path) {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(_) => return Err(internal_error("Cannot inspect guarded-start journal")),
+            Ok(meta) if !meta.is_file() || meta.file_type().is_symlink() || meta.len() > 16384 => {
+                return Err(internal_error("Invalid guarded-start journal"));
+            }
+            Ok(_) => {}
+        }
+        serde_json::from_slice(
+            &std::fs::read(path)
+                .map_err(|_| internal_error("Cannot read guarded-start journal"))?,
+        )
+        .map(Some)
+        .map_err(|_| {
+            internal_error("Malformed guarded-start journal; never replay an uncertain request")
+        })
+    }
+    fn check_start_request(
+        request: &ThreadGovernorGuardedStartParams,
+    ) -> Result<(), JSONRPCErrorError> {
+        if request.request_id.is_empty()
+            || request.request_id.len() > 256
+            || request.request_id.chars().any(char::is_control)
+            || request.text.trim().is_empty()
+            || request.text.len() > 8192
+        {
+            return Err(invalid_request(
+                "Bounded explicit guarded-start request required",
+            ));
+        }
+        Ok(())
+    }
+    async fn guarded_start(
+        &self,
+        root: ThreadId,
+        lease_id: &str,
+        controller: &str,
+        revision: u64,
+        request: ThreadGovernorGuardedStartParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        use sha2::Digest;
+        Self::check_start_request(&request)?;
+        let text_hash = format!("{:x}", sha2::Sha256::digest(request.text.as_bytes()));
+        let _goal_lock = self.thread_state_manager.lock_goal_resume(root).await;
+        let mut state = self.governor_leases.lock().await;
+        let lease = state
+            .entries
+            .get_mut(&root)
+            .ok_or_else(|| invalid_request("Native guarded-start lease unavailable"))?;
+        if lease.lease_id != lease_id
+            || lease.controller_generation != controller
+            || lease.enrollment_revision != revision
+        {
+            return Err(invalid_request("Native guarded-start enrollment changed"));
+        }
+        if let Some(journal) = self.read_start_journal(root, &request.request_id)? {
+            if journal.lease_id != lease_id
+                || journal.controller_generation != controller
+                || journal.enrollment_revision != revision
+                || journal.text_hash != text_hash
+            {
+                return Err(invalid_request(
+                    "Guarded-start request already belongs to another exact operation",
+                ));
+            }
+            let mut response = lease.response();
+            response.guard_request_id = Some(request.request_id);
+            response.started_turn_id = journal.started_turn_id;
+            response.start_state = Some(if journal.start_state == "reserved" {
+                "uncertain".into()
+            } else {
+                journal.start_state
+            });
+            return Ok(Some(response.into()));
+        }
+        if lease.expired
+            || lease.released
+            || lease.deadline_boottime_ms <= lease_clock_ms()?
+            || lease.guards.iter().any(|guard| guard.token.is_cancelled())
+        {
+            return Err(invalid_request(
+                "Native guarded-start allowance is held or expired",
+            ));
+        }
+        let thread = self
+            .thread_manager
+            .get_thread(root)
+            .await
+            .map_err(|_| invalid_request("Native guarded-start thread unavailable"))?;
+        let mut guards = lease.guards.clone();
+        let inherited = self.member_roots(root)?;
+        for membership in inherited {
+            if membership.root == root {
+                continue;
+            }
+            if let Some(parent) = state.entries.get(&membership.root) {
+                if parent.released {
+                    continue;
+                }
+                if parent.expired
+                    || parent.deadline_boottime_ms <= lease_clock_ms()?
+                    || parent.guards.iter().any(|guard| guard.token.is_cancelled())
+                {
+                    return Err(invalid_request(
+                        "Inherited native governor is held; repair its exact scope before resuming",
+                    ));
+                }
+                guards.extend(parent.guards.clone());
+            } else if self
+                .read_guard_mark(membership.root)?
+                .is_some_and(|parent| !parent.released)
+            {
+                return Err(invalid_request(
+                    "Inherited native governor needs explicit repair after restart",
+                ));
+            }
+        }
+        let guards = codex_core::governor_guard::combine(guards);
+        let mut journal = GuardedStartJournal {
+            root,
+            lease_id: lease_id.into(),
+            controller_generation: controller.into(),
+            enrollment_revision: revision,
+            request_id: request.request_id.clone(),
+            text_hash,
+            start_state: "reserved".into(),
+            started_turn_id: None,
+        };
+        self.write_guard_value(self.start_journal_path(root, &request.request_id), &journal)?;
+        if let Some(lease) = state.entries.get_mut(&root) {
+            lease.guard_request_id = Some(request.request_id.clone());
+            lease.start_state = Some("reserved".into());
+            self.write_guard_mark(lease)?;
+        }
+        drop(state); // The independent BOOTTIME watchdog must run while Core prepares/starts.
+        thread
+            .thread_extension_data()
+            .insert(codex_core::governor_guard::NextGovernorTurnGuards(guards));
+        let submission = thread
+            .start_turn_if_idle(
+                codex_core::TurnInputRequest::new(codex_core::TurnInput::ResponseItem(
+                    codex_protocol::models::ResponseItem::Message {
+                        encrypted_content: None,
+                        status: None,
+                        id: None,
+                        role: "developer".into(),
+                        content: vec![codex_protocol::models::ContentItem::InputText {
+                            text: request.text,
+                        }],
+                        phase: None,
+                        internal_chat_message_metadata_passthrough: None,
+                    },
+                ))
+                .on_start(codex_core::TurnStartOptions {
+                    turn_trigger: Some(format!("governor:{}", request.request_id)),
+                    ..Default::default()
+                }),
+            )
+            .await;
+        match submission {
+            Ok(codex_core::StartIfIdleSubmission::Started { turn_id, .. }) => {
+                journal.started_turn_id = Some(turn_id);
+                journal.start_state = "started".into();
+            }
+            Ok(codex_core::StartIfIdleSubmission::NotSubmitted { .. }) => {
+                journal.start_state = "busy".into();
+                thread
+                    .thread_extension_data()
+                    .remove::<codex_core::governor_guard::NextGovernorTurnGuards>();
+            }
+            Err(_) => {
+                journal.start_state = "uncertain".into();
+            }
+        }
+        let mut state = self.governor_leases.lock().await;
+        let lease = state.entries.get_mut(&root).ok_or_else(|| {
+            internal_error("Native guarded-start lease disappeared; reconcile exact request")
+        })?;
+        if lease.lease_id != lease_id
+            || lease.controller_generation != controller
+            || lease.enrollment_revision != revision
+        {
+            return Err(invalid_request(
+                "Native guarded-start enrollment changed; reconcile original request",
+            ));
+        }
+        if lease.expired || lease.deadline_boottime_ms <= lease_clock_ms()? {
+            journal.start_state = "expired".into();
+        }
+        lease.guard_request_id = Some(request.request_id.clone());
+        lease.started_turn_id = journal.started_turn_id.clone();
+        lease.start_state = Some(journal.start_state.clone());
+        if let Some(turn) = &journal.started_turn_id
+            && let Some(member) = lease
+                .members
+                .iter_mut()
+                .find(|member| member.thread_id == root)
+        {
+            if !member.turn_ids.contains(turn) {
+                member.turn_ids.push(turn.clone());
+            }
+        }
+        self.write_start_result(lease, &journal)?;
+        Ok(Some(lease.response().into()))
+    }
+    fn write_start_result(
+        &self,
+        lease: &Lease,
+        journal: &GuardedStartJournal,
+    ) -> Result<(), JSONRPCErrorError> {
+        self.write_guard_value(
+            self.start_journal_path(journal.root, &journal.request_id),
+            journal,
+        )?;
+        self.index_guard_members(lease)?;
+        self.write_guard_mark(lease)
+    }
+}
+impl ThreadGoalRequestProcessor {
+    fn guarded_query(
+        &self,
+        mut response: ThreadGovernorLeaseSetResponse,
+        root: ThreadId,
+        controller: &str,
+        revision: u64,
+        request: &ThreadGovernorGuardedStartParams,
+    ) -> Result<ThreadGovernorLeaseSetResponse, JSONRPCErrorError> {
+        Self::check_start_request(request)?;
+        response.guard_request_id = Some(request.request_id.clone());
+        response.start_state = Some("not_started".into());
+        if let Some(journal) = self.read_start_journal(root, &request.request_id)? {
+            if journal.lease_id != response.lease_id
+                || journal.controller_generation != controller
+                || journal.enrollment_revision != revision
+            {
+                response.start_state = Some("context_changed".into());
+                response.armed = false;
+                response.reason =
+                    Some("Guarded-start request belongs to a previous exact enrollment".into());
+            } else {
+                response.started_turn_id = journal.started_turn_id;
+                response.start_state = Some(if journal.start_state == "reserved" {
+                    "uncertain".into()
+                } else {
+                    journal.start_state
+                });
+            }
+        }
+        Ok(response)
+    }
+    async fn arm_guarded_start(
+        &self,
+        params: ThreadGovernorLeaseSetParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let root = parse_thread_id_for_request(&params.thread_id)?;
+        let request = params
+            .guarded_start
+            .clone()
+            .ok_or_else(|| invalid_request("Explicit guarded-start request required"))?;
+        Self::check_start_request(&request)?;
+        let ttl = params
+            .ttl_ms
+            .filter(|ttl| (1..=10000).contains(ttl))
+            .ok_or_else(|| invalid_request("Native guarded-start ttlMs must be 1..10000"))?;
+        let now = lease_clock_ms()?;
+        let received = Instant::now();
+        let thread = self
+            .thread_manager
+            .get_thread(root)
+            .await
+            .map_err(|_| invalid_request("Owned loaded guarded-start thread required"))?;
+        if thread.multi_agent_version() == Some(codex_protocol::protocol::MultiAgentVersion::V1) {
+            return Err(invalid_request("legacy_delegation_isolation_unsupported"));
+        }
+        let mut registry = self.governor_leases.lock().await;
+        let existing = registry
+            .entries
+            .get(&root)
+            .cloned()
+            .or(self.read_guard_mark(root)?);
+        if existing.as_ref().is_some_and(|lease| lease.expiry_pending) {
+            return Err(invalid_request("native_guard_expiry_pending"));
+        }
+        if let Some(journal) = self.read_start_journal(root, &request.request_id)? {
+            let Some(lease) = existing.as_ref() else {
+                return Err(invalid_request(
+                    "Guarded-start enrollment receipt unavailable; never replay",
+                ));
+            };
+            if journal.lease_id != params.lease_id
+                || journal.controller_generation != params.controller_generation
+                || journal.enrollment_revision != params.enrollment_revision
+            {
+                return Err(invalid_request(
+                    "Guarded-start request context changed; never replay",
+                ));
+            }
+            return Ok(Some(
+                self.guarded_query(
+                    lease.response(),
+                    root,
+                    &params.controller_generation,
+                    params.enrollment_revision,
+                    &request,
+                )?
+                .into(),
+            ));
+        }
+        if let Some(old) = &existing {
+            let same = old.lease_id == params.lease_id
+                && old.controller_generation == params.controller_generation
+                && old.enrollment_revision == params.enrollment_revision
+                && old.server_instance == registry.instance;
+            if same
+                && (old.expired
+                    || old.released
+                    || old.deadline_boottime_ms <= now
+                    || old.guards.iter().any(|guard| guard.token.is_cancelled()))
+            {
+                return Err(invalid_request(
+                    "native_guard_expired: explicit newer enrollment required",
+                ));
+            }
+            if !same && params.enrollment_revision <= old.enrollment_revision {
+                return Err(invalid_request(
+                    "Guarded-start repair requires a newer enrollment revision",
+                ));
+            }
+        }
+        if !registry.entries.contains_key(&root) && registry.entries.len() >= 128 {
+            if let Some(evict) = registry
+                .entries
+                .iter()
+                .find(|(_, lease)| {
+                    !lease.expiry_pending
+                        && (lease.released || lease.expired && lease.stop_verified)
+                })
+                .map(|(id, _)| *id)
+            {
+                registry.entries.remove(&evict);
+            } else {
+                return Err(invalid_request(
+                    "Native governor concurrent task capacity reached",
+                ));
+            }
+        }
+        let mut guards = existing
+            .as_ref()
+            .filter(|old| {
+                old.server_instance == registry.instance
+                    && !old.expired
+                    && !old.released
+                    && old.guards.iter().all(|guard| !guard.token.is_cancelled())
+            })
+            .map(|old| old.guards.clone())
+            .unwrap_or_default();
+        if guards.is_empty() {
+            let mut guard = GovernorTaskGuard::new(root);
+            guard.durable_directory = Some(self.lease_directory());
+            guards.push(guard);
+        }
+        let members = existing
+            .as_ref()
+            .map(|old| old.members.clone())
+            .filter(|members| !members.is_empty())
+            .unwrap_or_else(|| {
+                vec![Member {
+                    thread_id: root,
+                    turn_ids: Vec::new(),
+                    goal_id: None,
+                    goal_created_at: None,
+                }]
+            });
+        let deadline = received + Duration::from_millis(ttl);
+        let lease = Lease {
+            thread_id: root,
+            lease_id: params.lease_id.clone(),
+            controller_generation: params.controller_generation.clone(),
+            enrollment_revision: params.enrollment_revision,
+            server_instance: registry.instance.clone(),
+            ttl_ms: ttl,
+            deadline_boottime_ms: now.saturating_add(ttl),
+            guards,
+            members,
+            released: false,
+            expired: false,
+            expiry_pending: false,
+            stop_verified: false,
+            outcomes: Vec::new(),
+            deadline: Some(deadline),
+            guard_request_id: None,
+            started_turn_id: None,
+            start_state: None,
+        };
+        self.index_guard_members(&lease)?;
+        self.write_guard_mark(&lease)?;
+        registry.entries.insert(root, lease);
+        self.start_governor_timer(root, deadline);
+        drop(registry);
+        self.guarded_start(
+            root,
+            &params.lease_id,
+            &params.controller_generation,
+            params.enrollment_revision,
+            request,
+        )
+        .await
+    }
+}
