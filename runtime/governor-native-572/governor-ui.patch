+            )),
+            Line::from(format!(
+                "Tokens: {} used · {} remaining · {} lifetime",
+                text(&value["usage"], "used_tokens"),
+                text(&value["usage"], "remaining_tokens"),
+                text(&value["usage"], "lifetime_used_tokens")
+            )),
+            Line::from(format!(
+                "Time: {} elapsed · {} remaining",
+                duration(numeric(&value["usage"], "elapsed_seconds")),
+                duration(remaining_seconds(value))
+            )),
+            Line::from(format!("Deadline: {}", deadline(value))),
+            Line::from(format!(
+                "Enforcement: watcher {} · accounting {accounting} · revision {}",
+                watcher_label(value),
+                text(value, "revision")
+            )),
+            Line::from(format!(
+                "Scope: {} · selected {}",
+                scope_label(value),
+                self.wake_selector().unwrap_or_else(|| "unknown".into())
+            )),
+            Line::from(format!("Reason: {}", reason_label(value))),
+        ];
+        if let Some(operation) = value.get("operation") {
+            lines.push(Line::from(format!(
+                "Continuation: {} · {}",
+                if operation.get("resumed").and_then(Value::as_bool) == Some(true) {
+                    "Submitted"
+                } else {
+                    "Not resumed"
+                },
