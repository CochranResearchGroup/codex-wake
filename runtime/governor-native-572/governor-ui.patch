diff --git a/codex-rs/core/src/governor_guard.rs b/codex-rs/core/src/governor_guard.rs
new file mode 100644
index 0000000000..7f395a80c7
--- /dev/null
+++ b/codex-rs/core/src/governor_guard.rs
@@ -0,0 +1,310 @@
+//! Native task-family cancellation. This is an enforcement lease, never an accounting owner.
+use codex_protocol::ThreadId;
+use std::collections::{HashMap, HashSet};
+use std::sync::{Mutex, OnceLock};
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone, Debug)]
+pub struct GovernorTaskGuard {
+    pub scope: ThreadId,
+    pub id: String,
+    pub token: CancellationToken,
+    pub durable_directory: Option<std::path::PathBuf>,
+}
+impl GovernorTaskGuard {
+    pub fn new(scope: ThreadId) -> Self {
+        Self {
+            scope,
+            id: uuid::Uuid::new_v4().to_string(),
+            token: CancellationToken::new(),
+            durable_directory: None,
+        }
+    }
+}
+#[derive(Clone, Debug, Default)]
+pub struct NextGovernorTurnGuards(pub Vec<GovernorTaskGuard>);
+#[derive(Clone, Debug, Default)]
+pub struct GovernorTurnGuards {
+    pub turn_id: String,
+    pub guards: Vec<GovernorTaskGuard>,
+}
+#[derive(Default)]
+struct Registry {
+    parents: HashMap<ThreadId, Option<ThreadId>>,
+    turn_owners: HashMap<String, ThreadId>,
+    roots: HashMap<(ThreadId, String), GovernorTaskGuard>,
+    turn_guards: HashMap<String, (ThreadId, Vec<GovernorTaskGuard>)>,
+}
+fn registry() -> &'static Mutex<Registry> {
+    static VALUE: OnceLock<Mutex<Registry>> = OnceLock::new();
+    VALUE.get_or_init(|| Mutex::new(Registry::default()))
+}
+pub(crate) fn register_thread(id: ThreadId, parent: Option<ThreadId>) {
+    registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .parents
+        .insert(id, parent);
+}
+pub(crate) fn register_turn(id: ThreadId, turn: &str, parent_turn: Option<&str>) {
+    let mut values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    if let Some(parent) = parent_turn
+        .and_then(|turn| values.turn_owners.get(turn))
+        .copied()
+        && parent != id
+        && values.parents.get(&id).is_none_or(Option::is_none)
+    {
+        values.parents.insert(id, Some(parent));
+    }
+    values.turn_owners.insert(turn.to_owned(), id);
+}
+pub fn existing_guard(scope: ThreadId, root: &str) -> Option<GovernorTaskGuard> {
+    registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .roots
+        .get(&(scope, root.to_owned()))
+        .cloned()
+}
+pub fn bind_root(root: &str, guard: &GovernorTaskGuard) -> Result<(), String> {
+    let mut values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let key = (guard.scope, root.to_owned());
+    if let Some(existing) = values.roots.get(&key) {
+        if existing.id != guard.id {
+            return Err("Governor task root already belongs to another lease token".into());
+        }
+        return Ok(());
+    }
+    if values.roots.len() >= 8192 {
+        return Err("Governor task root capacity reached".into());
+    }
+    values.roots.insert(key, guard.clone());
+    Ok(())
+}
+pub fn guards_for_root(thread: ThreadId, root: &str) -> Vec<GovernorTaskGuard> {
+    let values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut scopes = HashSet::new();
+    let mut next = Some(thread);
+    while let Some(id) = next {
+        if !scopes.insert(id) || scopes.len() > 128 {
+            break;
+        }
+        next = values.parents.get(&id).copied().flatten();
+    }
+    values
+        .roots
+        .iter()
+        .filter(|((scope, key), _)| key == root && scopes.contains(scope))
+        .map(|(_, guard)| guard.clone())
+        .collect()
+}
+pub fn combine(guards: impl IntoIterator<Item = GovernorTaskGuard>) -> Vec<GovernorTaskGuard> {
+    let mut seen = HashSet::new();
+    guards
+        .into_iter()
+        .filter(|guard| seen.insert(guard.id.clone()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn governor_guard_causal_root_inherits_to_late_child_but_preserves_operator_and_sibling() {
+        let parent = ThreadId::new();
+        let child = ThreadId::new();
+        let peer = ThreadId::new();
+        register_thread(parent, None);
+        register_thread(child, Some(parent));
+        register_thread(peer, None);
+        let root = uuid::Uuid::new_v4().to_string();
+        let guard = GovernorTaskGuard::new(parent);
+        bind_root(&root, &guard).unwrap();
+        guard.token.cancel();
+        assert!(
+            guards_for_root(child, &root)
+                .iter()
+                .any(|guard| guard.token.is_cancelled())
+        );
+        assert!(guards_for_root(parent, "fresh-operator-turn").is_empty());
+        assert!(guards_for_root(peer, &root).is_empty());
+        let child_limit = GovernorTaskGuard::new(child);
+        let other_child = ThreadId::new();
+        register_thread(other_child, Some(parent));
+        bind_root(&root, &child_limit).unwrap();
+        assert!(
+            !guards_for_root(other_child, &root)
+                .iter()
+                .any(|guard| guard.id == child_limit.id)
+        );
+    }
+}
+
+pub fn is_descendant(thread: ThreadId, scope: ThreadId) -> bool {
+    let values = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut next = Some(thread);
+    let mut seen = HashSet::new();
+    while let Some(id) = next {
+        if id == scope {
+            return true;
+        }
+        if !seen.insert(id) || seen.len() > 128 {
+            return false;
+        }
+        next = values.parents.get(&id).copied().flatten();
+    }
+    false
+}
+
+#[derive(Clone, Debug, serde::Serialize, serde::Deserialize)]
+pub struct GovernorMembership {
+    pub root: ThreadId,
+    pub goal_id: Option<String>,
+    pub turn_ids: Vec<String>,
+}
+pub fn read_memberships(
+    directory: &std::path::Path,
+    id: ThreadId,
+) -> Result<Vec<GovernorMembership>, String> {
+    let path = directory.join(format!("{id}.members.json"));
+    match std::fs::symlink_metadata(&path) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(_) => return Err("Cannot inspect native task membership".into()),
+        Ok(meta)
+            if !meta.is_file() || meta.file_type().is_symlink() || meta.len() > 1024 * 1024 =>
+        {
+            return Err("Invalid native task membership".into());
+        }
+        Ok(_) => {}
+    }
+    let values: Vec<GovernorMembership> = serde_json::from_slice(
+        &std::fs::read(path).map_err(|_| "Cannot read native task membership")?,
+    )
+    .map_err(|_| "Malformed native task membership")?;
+    if values.len() > 128 {
+        return Err("Native task membership scope capacity reached".into());
+    }
+    Ok(values)
+}
+pub fn persist_membership(
+    directory: &std::path::Path,
+    id: ThreadId,
+    root: ThreadId,
+    turn: Option<&str>,
+    goal: Option<&str>,
+    replace_goal: bool,
+) -> Result<(), String> {
+    use std::io::Write;
+    let _serialized = registry()
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner);
+    let mut values = read_memberships(directory, id)?;
+    let index = match values.iter().position(|member| member.root == root) {
+        Some(index) => index,
+        None => {
+            if values.len() >= 128 {
+                return Err("Native task membership scope capacity reached".into());
+            }
+            values.push(GovernorMembership {
+                root,
+                goal_id: None,
+                turn_ids: Vec::new(),
+            });
+            values.len() - 1
+        }
+    };
+    let entry = &mut values[index];
+    let mut changed = false;
+    if replace_goal && entry.goal_id.as_deref() != goal {
+        entry.goal_id = goal.map(str::to_owned);
+        changed = true;
+    }
+    if let Some(turn) = turn
+        && !entry.turn_ids.iter().any(|id| id == turn)
+    {
+        if entry.turn_ids.len() >= 8192 {
+            return Err("Native task membership turn capacity reached".into());
+        }
+        entry.turn_ids.push(turn.to_owned());
+        changed = true;
+    }
+    if !changed {
+        return Ok(());
+    }
+    std::fs::create_dir_all(directory)
+        .map_err(|_| "Cannot create native task membership directory")?;
+    if std::fs::symlink_metadata(directory)
+        .map_err(|_| "Cannot inspect native task membership directory")?
+        .file_type()
+        .is_symlink()
+    {
+        return Err("Native task membership directory cannot be a symlink".into());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(directory, std::fs::Permissions::from_mode(0o700))
+            .map_err(|_| "Cannot protect native task membership")?;
+    }
+    let mut file = tempfile::NamedTempFile::new_in(directory)
+        .map_err(|_| "Cannot stage native task membership")?;
+    serde_json::to_writer(file.as_file_mut(), &values)
+        .map_err(|_| "Cannot encode native task membership")?;
+    file.flush()
+        .map_err(|_| "Cannot flush native task membership")?;
+    file.as_file()
+        .sync_all()
+        .map_err(|_| "Cannot sync native task membership")?;
+    file.persist(directory.join(format!("{id}.members.json")))
+        .map_err(|_| "Cannot publish native task membership")?;
+    #[cfg(unix)]
+    std::fs::File::open(directory)
+        .and_then(|directory| directory.sync_all())
+        .map_err(|_| "Cannot sync native task membership directory")?;
+    Ok(())
+}
+
+pub(crate) fn remember_turn_guards(
+    thread: ThreadId,
+    turn: &str,
+    guards: Vec<GovernorTaskGuard>,
+) -> Result<(), String> {
+    let mut state = registry()
