+        .turn_guards
+        .get(turn)
+        .filter(|(owner, _)| *owner == thread)
+        .map(|(_, guards)| guards.clone())
+        .unwrap_or_default();
+    for guard in &guards {
+        if let Some(directory) = &guard.durable_directory
+            && let Err(error) =
+                persist_membership(directory, thread, guard.scope, Some(turn), Some(goal), true)
+        {
+            for guard in &guards {
+                guard.token.cancel();
+            }
+            return Err(error);
+        }
+    }
