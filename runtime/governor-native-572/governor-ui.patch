+//! App-server-owned task lease. UI closure and watcher SIGKILL cannot cancel its timer.
+use super::*;
+use codex_app_server_protocol::{
+    ThreadGovernorGuardedStartParams, ThreadGovernorLeaseMember, ThreadGovernorLeaseMemberOutcome,
+    ThreadGovernorLeaseSetParams, ThreadGovernorLeaseSetResponse,
+};
+use codex_core::governor_guard::GovernorTaskGuard;
+use serde::{Deserialize, Serialize};
+use std::collections::{HashMap, HashSet};
+use std::io::Write;
+use std::time::Duration;
+use std::time::Instant;
+
+fn lease_clock_ms() -> Result<u64, JSONRPCErrorError> {
+    #[cfg(target_os = "linux")]
+    {
+        let mut value = libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        };
+        if unsafe { libc::clock_gettime(libc::CLOCK_BOOTTIME, &mut value) } != 0
+            || value.tv_sec < 0
+            || value.tv_nsec < 0
+        {
+            return Err(invalid_request(
+                "Native governor requires qualified CLOCK_BOOTTIME",
+            ));
+        }
+        return u64::try_from(value.tv_sec as u128 * 1000 + value.tv_nsec as u128 / 1_000_000)
+            .map_err(|_| invalid_request("Native governor clock exceeds bound"));
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        Err(invalid_request(
+            "Native governor host clock isolation is unsupported",
+        ))
+    }
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+struct Member {
+    thread_id: ThreadId,
+    turn_ids: Vec<String>,
+    goal_id: Option<String>,
+    goal_created_at: Option<f64>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+struct Lease {
+    thread_id: ThreadId,
+    lease_id: String,
+    controller_generation: String,
+    enrollment_revision: u64,
+    server_instance: String,
+    ttl_ms: u64,
+    deadline_boottime_ms: u64,
+    #[serde(skip)]
+    guards: Vec<GovernorTaskGuard>,
+    members: Vec<Member>,
+    released: bool,
+    expired: bool,
+    #[serde(skip)]
+    expiry_pending: bool,
+    stop_verified: bool,
+    outcomes: Vec<ThreadGovernorLeaseMemberOutcome>,
+    guard_request_id: Option<String>,
+    started_turn_id: Option<String>,
+    start_state: Option<String>,
+    #[serde(skip)]
+    deadline: Option<Instant>,
+}
+impl Lease {
+    fn response(&self) -> ThreadGovernorLeaseSetResponse {
+        ThreadGovernorLeaseSetResponse {
+            release_verified: self.released && !self.expiry_pending,
+            lease_id: self.lease_id.clone(),
+            guard_request_id: self.guard_request_id.clone(),
+            started_turn_id: self.started_turn_id.clone(),
+            start_state: self.start_state.clone(),
+            supported: lease_clock_ms().is_ok(),
+            reason: (self.released && self.expiry_pending)
+                .then(|| "native_lease_release_pending".to_owned()),
+            armed: !self.expired
+                && !self.released
+                && !self.guards.iter().any(|guard| guard.token.is_cancelled())
+                && lease_clock_ms().is_ok_and(|now| now < self.deadline_boottime_ms),
+            expired: self.expired
+                || self.guards.iter().any(|guard| guard.token.is_cancelled())
+                || lease_clock_ms()
+                    .map(|now| now >= self.deadline_boottime_ms)
+                    .unwrap_or(true),
+            stop_verified: self.stop_verified,
+            ttl_ms: self.ttl_ms,
+            member_outcomes: self.outcomes.clone(),
+        }
+    }
+}
+pub(super) struct GovernorLeases {
+    instance: String,
+    entries: HashMap<ThreadId, Lease>,
+}
+impl Default for GovernorLeases {
+    fn default() -> Self {
+        Self {
+            instance: uuid::Uuid::new_v4().to_string(),
+            entries: HashMap::new(),
+        }
+    }
+}
+
+impl ThreadGoalRequestProcessor {
+    fn lease_directory(&self) -> std::path::PathBuf {
+        self.config.codex_home.join("governor-leases").to_path_buf()
+    }
+    fn lease_path(&self, id: ThreadId) -> std::path::PathBuf {
+        self.lease_directory().join(format!("{id}.json"))
+    }
+    fn read_guard_mark(&self, id: ThreadId) -> Result<Option<Lease>, JSONRPCErrorError> {
+        let path = self.lease_path(id);
+        match std::fs::symlink_metadata(&path) {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+            Err(_) => return Err(internal_error("Cannot inspect native governor guard mark")),
+            Ok(metadata)
+                if !metadata.is_file()
+                    || metadata.file_type().is_symlink()
+                    || metadata.len() > 1024 * 1024 =>
+            {
+                return Err(internal_error("Invalid native governor guard mark"));
+            }
+            Ok(_) => {}
+        }
+        let data = std::fs::read(path)
+            .map_err(|_| internal_error("Cannot read native governor guard mark"))?;
+        serde_json::from_slice(&data).map(Some).map_err(|_| {
+            internal_error("Malformed native governor guard mark; automatic recovery remains held")
+        })
+    }
+    fn write_guard_value<T: Serialize>(
+        &self,
+        path: std::path::PathBuf,
+        value: &T,
+    ) -> Result<(), JSONRPCErrorError> {
+        let dir = self.lease_directory();
+        std::fs::create_dir_all(&dir)
+            .map_err(|_| internal_error("Cannot create native governor guard directory"))?;
+        if std::fs::symlink_metadata(&dir)
+            .map_err(|_| internal_error("Cannot inspect native governor guard directory"))?
+            .file_type()
+            .is_symlink()
+        {
+            return Err(internal_error(
+                "Native governor guard directory cannot be a symlink",
+            ));
+        }
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700))
+                .map_err(|_| internal_error("Cannot protect native governor guard directory"))?;
+        }
+        let mut file = tempfile::NamedTempFile::new_in(&dir)
+            .map_err(|_| internal_error("Cannot stage native governor guard mark"))?;
+        serde_json::to_writer(file.as_file_mut(), value)
+            .map_err(|_| internal_error("Cannot encode native governor guard mark"))?;
+        file.as_file_mut()
+            .flush()
+            .map_err(|_| internal_error("Cannot flush native governor guard mark"))?;
+        file.as_file()
+            .sync_all()
+            .map_err(|_| internal_error("Cannot persist native governor guard mark"))?;
+        file.persist(path)
+            .map_err(|_| internal_error("Cannot publish native governor guard mark"))?;
+        #[cfg(unix)]
+        std::fs::File::open(&dir)
+            .and_then(|directory| directory.sync_all())
+            .map_err(|_| internal_error("Cannot sync native governor guard directory"))?;
+        Ok(())
+    }
+    fn write_guard_mark(&self, lease: &Lease) -> Result<(), JSONRPCErrorError> {
+        self.write_guard_value(self.lease_path(lease.thread_id), lease)
+    }
+    fn member_roots(
+        &self,
+        id: ThreadId,
+    ) -> Result<Vec<codex_core::governor_guard::GovernorMembership>, JSONRPCErrorError> {
+        codex_core::governor_guard::read_memberships(&self.lease_directory(), id)
+            .map_err(internal_error)
+    }
+    fn index_guard_members(&self, lease: &Lease) -> Result<(), JSONRPCErrorError> {
+        for member in &lease.members {
+            for turn in member
+                .turn_ids
+                .iter()
+                .map(Some)
+                .chain(std::iter::once(None))
+            {
+                codex_core::governor_guard::persist_membership(
+                    &self.lease_directory(),
+                    member.thread_id,
+                    lease.thread_id,
+                    turn.map(String::as_str),
+                    member.goal_id.as_deref(),
+                    member.goal_id.is_some(),
+                )
+                .map_err(internal_error)?;
+            }
+        }
+        Ok(())
+    }
+    // Called while the cold-resume goal lock is held, before Core creates the runtime.
+    pub(crate) async fn reconcile_governor_before_cold_resume(
+        &self,
+        id: ThreadId,
+        automatic: bool,
+        recovery_turn: Option<&str>,
+    ) -> Result<(), JSONRPCErrorError> {
+        let instance = self.governor_leases.lock().await.instance.clone();
+        for membership in self.member_roots(id)? {
+            let root = membership.root;
+            let lease = self.read_guard_mark(root)?.ok_or_else(|| {
+                internal_error(
+                    "Scoped native governor guard mark is missing; recovery remains held",
+                )
+            })?;
+            if lease.released || lease.server_instance == instance && !lease.expired {
+                continue;
+            }
+            let expected_goal = membership.goal_id.as_ref().or_else(|| {
+                lease
+                    .members
+                    .iter()
+                    .find(|member| member.thread_id == id)
+                    .and_then(|member| member.goal_id.as_ref())
+            });
+            if automatic
+                && (recovery_turn.is_none() && expected_goal.is_some()
+                    || recovery_turn
+                        .is_some_and(|turn| membership.turn_ids.iter().any(|id| id == turn)))
+            {
+                return Err(invalid_request(
+                    "Native governor lease expired across server restart; explicit task repair is required before automatic recovery",
+                ));
+            }
+            if let Some(expected) = expected_goal {
+                let db = self
+                    .state_db
+                    .as_ref()
+                    .ok_or_else(|| internal_error("Cannot verify guarded goal before resume"))?;
+                db.thread_goals()
+                    .update_thread_goal(
+                        id,
+                        codex_state::GoalUpdate {
+                            objective: None,
+                            status: Some(codex_state::ThreadGoalStatus::Paused),
+                            token_budget: None,
+                            expected_goal_id: Some(expected.clone()),
+                        },
+                    )
+                    .await
+                    .map_err(|_| internal_error("Cannot pause guarded goal before resume"))?;
+            }
+        }
+        Ok(())
+    }
+    async fn qualified_lease_member(
+        &self,
+        root: ThreadId,
+        input: &ThreadGovernorLeaseMember,
+    ) -> Result<Member, JSONRPCErrorError> {
+        let id = parse_thread_id_for_request(&input.thread_id)?;
+        let thread = self
+            .thread_manager
+            .get_thread(id)
+            .await
+            .map_err(|_| invalid_request("Native governor member is not loaded"))?;
+        if !codex_core::governor_guard::is_descendant(id, root) {
+            return Err(invalid_request(
+                "Native governor member is outside the exact native task lineage",
+            ));
+        }
+        if input.turn_ids.len() > 64
+            || input
+                .turn_ids
+                .iter()
+                .any(|id| id.is_empty() || id.len() > 256 || id.chars().any(char::is_control))
+        {
+            return Err(invalid_request("Bounded exact governor turn IDs required"));
+        }
+        let active = thread.active_turn_id().await;
+        if active
+            .as_ref()
+            .is_some_and(|active| !input.turn_ids.contains(active))
+        {
+            return Err(invalid_request(
+                "Native governor active turn changed before lease arm",
+            ));
+        }
+        let snapshot = self
+            .upgrade_goal_state(id)
+            .await
+            .map_err(|_| invalid_request("Cannot qualify native governor goal identity"))?;
+        let created = snapshot
+            .pointer("/goal/createdAt")
+            .and_then(serde_json::Value::as_f64);
+        if created != input.goal_created_at {
+            return Err(invalid_request(
+                "Native governor goal identity changed before lease arm",
+            ));
+        }
+        let goal_id = snapshot
+            .get("goal_id")
+            .and_then(serde_json::Value::as_str)
+            .map(str::to_owned);
+        if id == root && active.is_none() && goal_id.is_none() {
+            return Err(invalid_request(
+                "idle_session_future_task_isolation_unsupported",
+            ));
+        }
+        let _ = thread; // Loading the exact native runtime is part of qualification.
+        Ok(Member {
+            thread_id: id,
+            turn_ids: input.turn_ids.clone(),
+            goal_id,
+            goal_created_at: created,
+        })
+    }
+    pub(crate) async fn thread_governor_lease_set(
+        &self,
+        params: ThreadGovernorLeaseSetParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let received_at = Instant::now();
+        let received_boot = lease_clock_ms()?;
+        if let Some(request) = &params.guarded_start {
+            Self::check_start_request(request)?;
+            if params.release {
+                return Err(invalid_request(
+                    "Lease release cannot dispatch guarded work",
+                ));
+            }
+        }
+
+        let root = parse_thread_id_for_request(&params.thread_id)?;
+        if params.lease_id.is_empty()
+            || params.lease_id.len() > 256
+            || params.controller_generation.is_empty()
+            || params.controller_generation.len() > 256
+            || params.release && params.query
+        {
+            return Err(invalid_request(
+                "Bounded exact native governor lease identity required",
+            ));
+        }
+        let mut registry = self.governor_leases.lock().await;
+        let existing = match registry.entries.get(&root).cloned() {
+            Some(value) => Some(value),
+            None => self.read_guard_mark(root)?.map(|mut mark| {
+                if mark.server_instance != registry.instance || !mark.released {
+                    mark.expired = !mark.released;
+                    mark.stop_verified = false;
+                }
+                mark
+            }),
+        };
+        if params.query || params.release {
+            let Some(mut lease) = existing else {
+                if params.release {
+                    return Err(invalid_request("Native governor lease is unknown"));
+                }
+                let thread = self
+                    .thread_manager
+                    .get_thread(root)
+                    .await
+                    .map_err(|_| invalid_request("Owned loaded native thread required"))?;
+                let snapshot = self
+                    .upgrade_goal_state(root)
+                    .await
+                    .map_err(|_| invalid_request("Cannot qualify native governor isolation"))?;
+                let reason = if thread.multi_agent_version()
+                    == Some(codex_protocol::protocol::MultiAgentVersion::V1)
+                {
+                    Some("legacy_delegation_isolation_unsupported".to_owned())
+                } else if params.guarded_start.is_none()
+                    && thread.active_turn_id().await.is_none()
+                    && snapshot
+                        .get("goal_id")
+                        .is_none_or(serde_json::Value::is_null)
+                {
+                    Some("idle_session_future_task_isolation_unsupported".to_owned())
+                } else {
+                    None
+                };
+                return Ok(Some(
+                    ThreadGovernorLeaseSetResponse {
+                        release_verified: false,
+                        lease_id: params.lease_id.clone(),
+                        guard_request_id: params
+                            .guarded_start
+                            .as_ref()
+                            .map(|request| request.request_id.clone()),
+                        started_turn_id: None,
+                        start_state: params.guarded_start.as_ref().map(|_| "not_started".into()),
+                        supported: reason.is_none(),
+                        reason,
+                        armed: false,
+                        expired: false,
+                        stop_verified: false,
+                        ttl_ms: 0,
+                        member_outcomes: Vec::new(),
+                    }
+                    .into(),
+                ));
+            };
+            if lease.lease_id != params.lease_id
+                || lease.controller_generation != params.controller_generation
+                || lease.enrollment_revision != params.enrollment_revision
+            {
+                if params.query {
+                    return Ok(Some(
+                        ThreadGovernorLeaseSetResponse {
+                            release_verified: false,
+                            lease_id: params.lease_id.clone(),
+                            guard_request_id: params
+                                .guarded_start
+                                .as_ref()
+                                .map(|request| request.request_id.clone()),
+                            started_turn_id: None,
+                            start_state: params
+                                .guarded_start
+                                .as_ref()
+                                .map(|_| "not_started".into()),
+                            supported: true,
+                            reason: None,
+                            armed: false,
+                            expired: false,
+                            stop_verified: false,
+                            ttl_ms: 0,
+                            member_outcomes: Vec::new(),
+                        }
+                        .into(),
+                    ));
+                }
+                return Err(invalid_request("Native governor lease identity changed"));
+            }
+            if params.release {
+                lease.released = true;
+                self.write_guard_mark(&lease)?;
+                if registry.entries.contains_key(&root) {
+                    registry.entries.insert(root, lease.clone());
+                }
+            }
+            let mut response = lease.response();
+            if let Some(request) = &params.guarded_start {
+                response = self.guarded_query(
+                    response,
+                    root,
+                    &params.controller_generation,
+                    params.enrollment_revision,
+                    request,
+                )?;
+            }
+            return Ok(Some(response.into()));
+        }
+        if existing.as_ref().is_some_and(|lease| lease.expiry_pending) {
+            return Err(invalid_request("native_guard_expiry_pending"));
+        }
+        if params.guarded_start.is_some() {
+            drop(registry);
+            return self.arm_guarded_start(params).await;
+        }
+        if params.ttl_ms == Some(1)
+            && let Some(mut lease) = existing.clone().filter(|lease| {
+                lease.lease_id == params.lease_id
+                    && lease.controller_generation == params.controller_generation
+                    && lease.enrollment_revision == params.enrollment_revision
+            })
+        {
+            if !lease.expired && !lease.released {
+                let deadline = Instant::now() + Duration::from_millis(1);
+                lease.deadline_boottime_ms = lease
+                    .deadline_boottime_ms
+                    .min(received_boot.saturating_add(1));
+                lease.deadline = Some(deadline);
+                lease.ttl_ms = 1;
+                self.write_guard_mark(&lease)?;
+                registry.entries.insert(root, lease.clone());
+                self.start_governor_timer(root, deadline);
+            }
+            return Ok(Some(lease.response().into()));
+        }
+        let ttl = params
+            .ttl_ms
+            .filter(|ttl| (1..=10000).contains(ttl))
+            .ok_or_else(|| invalid_request("Native governor ttlMs must be 1..10000"))?;
+        if let Some(mut lease) = existing.clone().filter(|lease| {
+            lease.lease_id == params.lease_id
+                && lease.controller_generation == params.controller_generation
+                && lease.enrollment_revision == params.enrollment_revision
+        }) {
+            if lease.expired
+                || lease.released
+                || lease.deadline_boottime_ms <= received_boot
+                || lease.guards.iter().any(|guard| guard.token.is_cancelled())
+            {
+                return Err(invalid_request(
+                    "native_guard_expired: explicit newer enrollment required",
+                ));
+            }
+            let deadline = received_at + Duration::from_millis(ttl);
+            lease.deadline = Some(deadline);
+            lease.ttl_ms = ttl;
+            lease.deadline_boottime_ms = received_boot.saturating_add(ttl);
+            self.write_guard_mark(&lease)?;
+            registry.entries.insert(root, lease.clone());
+            self.start_governor_timer(root, deadline);
+            return Ok(Some(lease.response().into()));
+        }
+        let inputs = params
+            .member_turns
+            .as_ref()
+            .filter(|m| !m.is_empty() && m.len() <= 128)
+            .ok_or_else(|| {
+                invalid_request("Complete bounded native governor task members required")
+            })?;
+        if !inputs.iter().any(|m| m.thread_id == params.thread_id) {
+            return Err(invalid_request("Native governor root member required"));
+        }
+        if let Some(existing) = &existing {
+            if existing.lease_id == params.lease_id {
+                if existing.expired
+                    || existing.released
+                    || received_boot >= existing.deadline_boottime_ms
+                {
+                    return Err(invalid_request(
+                        "native_guard_expired: explicit new enrollment revision required",
+                    ));
+                }
+                if existing.controller_generation != params.controller_generation
+                    || existing.enrollment_revision != params.enrollment_revision
+                {
+                    return Err(invalid_request(
+                        "Native governor controller generation changed",
+                    ));
+                }
+            } else if params.enrollment_revision <= existing.enrollment_revision {
+                return Err(invalid_request(
+                    "Native governor replacement requires a newer enrollment revision",
+                ));
+            }
+        }
+        if !registry.entries.contains_key(&root) && registry.entries.len() >= 128 {
+            if let Some(evict) = registry
+                .entries
+                .iter()
+                .find(|(_, lease)| {
+                    !lease.expiry_pending
+                        && (lease.released || lease.expired && lease.stop_verified)
+                })
+                .map(|(id, _)| *id)
+            {
+                registry.entries.remove(&evict);
+            } else {
+                return Err(invalid_request(
+                    "Native governor concurrent task lease capacity reached",
+                ));
+            }
+        }
+        let retaining = existing.as_ref().filter(|old| !old.released).filter(|old| {
+            inputs
+                .iter()
+                .find(|input| input.thread_id == params.thread_id)
+                .is_some_and(|input| {
+                    old.members
+                        .iter()
+                        .find(|member| member.thread_id == root)
+                        .is_some_and(|member| {
+                            input
+                                .turn_ids
+                                .iter()
+                                .all(|turn| member.turn_ids.contains(turn))
+                        })
+                })
+        });
+        let mut members = if let Some(old) = retaining {
+            old.members.clone()
+        } else {
+            Vec::new()
+        };
+        if retaining.is_none() {
+            for input in inputs {
+                let member = self.qualified_lease_member(root, input).await?;
+                if members
+                    .iter()
+                    .any(|m: &Member| m.thread_id == member.thread_id)
+                {
+                    return Err(invalid_request("Duplicate native governor member"));
+                }
+                if let Some(previous) = existing
+                    .as_ref()
+                    .filter(|old| old.lease_id == params.lease_id)
+                    .and_then(|old| old.members.iter().find(|m| m.thread_id == member.thread_id))
+                {
+                    if previous.goal_id != member.goal_id {
+                        return Err(invalid_request(
+                            "Native governor goal generation changed; explicit enrollment repair required",
+                        ));
+                    }
+                }
+                members.push(member);
+            }
+        }
+        let root_thread = self
+            .thread_manager
+            .get_thread(root)
+            .await
+            .map_err(|_| invalid_request("Native governor root unavailable"))?;
+        if root_thread.multi_agent_version()
+            == Some(codex_protocol::protocol::MultiAgentVersion::V1)
+        {
+            return Err(invalid_request("legacy_delegation_isolation_unsupported"));
+        }
+        let mut roots = HashSet::new();
+        for member in &members {
+            if let Ok(thread) = self.thread_manager.get_thread(member.thread_id).await
+                && let Some((_, root_turn)) = thread.active_turn_provenance().await
+            {
+                if member
+                    .turn_ids
+                    .contains(&thread.active_turn_id().await.unwrap_or_default())
+                    || existing.as_ref().is_some_and(|old| {
+                        old.guards.iter().any(|guard| {
+                            codex_core::governor_guard::guards_for_root(
+                                member.thread_id,
+                                &root_turn,
+                            )
+                            .iter()
+                            .any(|current| current.id == guard.id)
+                        })
+                    })
+                {
+                    roots.insert(root_turn);
+                }
+            }
+        }
+        let mut guards: Vec<GovernorTaskGuard> = existing
+            .as_ref()
+            .filter(|old| old.lease_id == params.lease_id)
+            .map(|old| old.guards.clone())
+            .unwrap_or_default();
+        for root_turn in &roots {
+            if let Some(guard) = codex_core::governor_guard::existing_guard(root, root_turn) {
+                if guard.token.is_cancelled() {
+                    return Err(invalid_request("Native causal task guard already expired"));
+                }
+                guards.push(guard);
+            }
+        }
+        if guards.is_empty() {
+            let mut guard = GovernorTaskGuard::new(root);
+            guard.durable_directory = Some(self.lease_directory());
+            guards.push(guard);
+        }
+        guards = codex_core::governor_guard::combine(guards);
+        let provisional = Lease {
+            thread_id: root,
+            lease_id: params.lease_id.clone(),
+            controller_generation: params.controller_generation.clone(),
+            enrollment_revision: params.enrollment_revision,
+            server_instance: registry.instance.clone(),
+            ttl_ms: ttl,
+            deadline_boottime_ms: received_boot.saturating_add(ttl),
+            guards: guards.clone(),
+            members: members.clone(),
+            released: false,
+            expired: false,
+            expiry_pending: false,
+            stop_verified: false,
+            outcomes: Vec::new(),
+            guard_request_id: None,
+            started_turn_id: None,
+            start_state: None,
+            deadline: Some(received_at + Duration::from_millis(ttl)),
+        };
+        self.index_guard_members(&provisional)?;
+        self.write_guard_mark(&provisional)?;
+        registry.entries.insert(root, provisional.clone());
+        self.start_governor_timer(
+            root,
+            provisional.deadline.expect("provisional deadline set"),
+        );
+        for root_turn in &roots {
+            let guard = codex_core::governor_guard::existing_guard(root, root_turn)
+                .unwrap_or_else(|| guards[0].clone());
+            codex_core::governor_guard::bind_root(root_turn, &guard).map_err(invalid_request)?;
+        }
+        for member in &members {
+            if let Ok(thread) = self.thread_manager.get_thread(member.thread_id).await
+                && let Some((turn, root_turn)) = thread.active_turn_provenance().await
+                && member.turn_ids.contains(&turn)
+            {
+                let guard = codex_core::governor_guard::existing_guard(root, &root_turn)
+                    .unwrap_or_else(|| guards[0].clone());
+                thread
+                    .attach_governor_guard(&turn, &guard)
+                    .await
+                    .map_err(invalid_request)?;
+            }
+        }
+        if existing
+            .as_ref()
+            .is_none_or(|old| old.lease_id != params.lease_id)
+        {
+            for id in self.thread_manager.list_thread_ids().await {
+                if members.iter().any(|member| member.thread_id == id)
+                    || !codex_core::governor_guard::is_descendant(id, root)
+                {
+                    continue;
+                }
+                if let Ok(thread) = self.thread_manager.get_thread(id).await
+                    && let Some((turn, root_turn)) = thread.active_turn_provenance().await
+                    && roots.contains(&root_turn)
+                {
+                    let snapshot = self.upgrade_goal_state(id).await.map_err(|_| {
+                        invalid_request("Cannot qualify newly spawned native task member")
+                    })?;
+                    let member = self
+                        .qualified_lease_member(
+                            root,
+                            &ThreadGovernorLeaseMember {
+                                thread_id: id.to_string(),
+                                turn_ids: vec![turn],
+                                goal_created_at: snapshot
+                                    .pointer("/goal/createdAt")
+                                    .and_then(serde_json::Value::as_f64),
+                            },
+                        )
+                        .await?;
+                    members.push(member);
+                }
+            }
+        }
+        for member in &members {
+            if let Some(goal) = &member.goal_id {
+                self.goal_service
+                    .bind_governor_goal(member.thread_id, goal, guards.clone());
+            }
+        }
+        let deadline = received_at + Duration::from_millis(ttl);
+        if Instant::now() >= deadline {
+            return Err(invalid_request(
+                "Native governor allowance expired during isolation qualification",
+            ));
+        }
+        let lease = Lease {
+            thread_id: root,
+            lease_id: params.lease_id,
+            controller_generation: params.controller_generation,
+            enrollment_revision: params.enrollment_revision,
+            server_instance: registry.instance.clone(),
+            ttl_ms: ttl,
+            deadline_boottime_ms: received_boot.saturating_add(ttl),
+            guards,
+            members,
+            released: false,
+            expired: false,
+            expiry_pending: false,
+            stop_verified: false,
+            outcomes: Vec::new(),
+            guard_request_id: None,
+            started_turn_id: None,
+            start_state: None,
+            deadline: Some(deadline),
+        };
+        self.index_guard_members(&lease)?;
+        self.write_guard_mark(&lease)?;
+        registry.entries.insert(root, lease.clone());
+        drop(registry);
+        Ok(Some(lease.response().into()))
+    }
+    fn start_governor_timer(&self, root: ThreadId, deadline: Instant) {
+        let owner = self.clone();
+        tokio::spawn(async move {
+            loop {
+                let remaining = {
+                    let state = owner.governor_leases.lock().await;
+                    let Some(lease) = state.entries.get(&root) else {
+                        return;
+                    };
+                    if lease.deadline != Some(deadline) || lease.released || lease.expired {
+                        return;
+                    }
+                    lease
+                        .deadline_boottime_ms
+                        .saturating_sub(lease_clock_ms().unwrap_or(u64::MAX))
+                };
+                if remaining == 0 {
+                    owner.expire_governor_lease(root, deadline).await;
+                    return;
+                }
+                tokio::time::sleep(Duration::from_millis(remaining.min(100))).await;
+            }
+        });
+    }
+    async fn expire_governor_lease(&self, root: ThreadId, deadline: Instant) {
+        let lease = {
+            let mut registry = self.governor_leases.lock().await;
+            let Some(lease) = registry.entries.get_mut(&root) else {
+                return;
+            };
+            if lease.deadline != Some(deadline) || lease.released || lease.expired {
+                return;
+            }
+            lease.expired = true;
+            lease.expiry_pending = true;
+            lease.stop_verified = false;
+            for guard in &lease.guards {
+                guard.token.cancel();
+            }
+            let lease = lease.clone();
+            if self.write_guard_mark(&lease).is_err() {
+                tracing::error!("native governor expiry could not persist its guard mark");
+            }
+            lease
+        };
+        for guard in &lease.guards {
+            guard.token.cancel();
+        }
+        let mut stopped_members = lease.members.clone();
+        for member in &mut stopped_members {
+            if let Ok(links) = self.member_roots(member.thread_id)
+                && let Some(link) = links.into_iter().find(|link| link.root == lease.thread_id)
+            {
+                if link.goal_id.is_some() {
+                    member.goal_id = link.goal_id;
+                }
+            }
+        }
+
+        let guard_ids: HashSet<_> = lease.guards.iter().map(|guard| guard.id.clone()).collect();
+        for id in self.thread_manager.list_thread_ids().await {
+            if let Ok(thread) = self.thread_manager.get_thread(id).await
+                && thread
+                    .active_governor_guard_ids()
+                    .await
+                    .iter()
+                    .any(|id| guard_ids.contains(id))
+                && let Some(turn) = thread.active_turn_id().await
+            {
+                let snapshot = self.upgrade_goal_state(id).await.ok();
+                if let Some(member) = stopped_members
+                    .iter_mut()
+                    .find(|member| member.thread_id == id)
+                {
+                    if !member.turn_ids.contains(&turn) {
+                        member.turn_ids.push(turn);
+                    }
+                    continue;
+                }
+                stopped_members.push(Member {
+                    thread_id: id,
+                    turn_ids: vec![turn],
+                    goal_id: snapshot
+                        .as_ref()
+                        .and_then(|value| value.get("goal_id"))
+                        .and_then(serde_json::Value::as_str)
+                        .map(str::to_owned),
+                    goal_created_at: snapshot
+                        .as_ref()
+                        .and_then(|value| value.pointer("/goal/createdAt"))
+                        .and_then(serde_json::Value::as_f64),
+                });
+            }
+        }
+        let mut outcomes = futures::future::join_all(stopped_members.iter().map(|member| {
+            self.stop_expired_governor_member(member, root, &lease.lease_id, deadline)
+        }))
+        .await;
+        // Yielded exec sessions can outlive their originating turn. The Core manager
+        // fences in-flight starts and selects handles by the existing causal guards.
+        let tools_stopped = tokio::time::timeout(Duration::from_secs(5), async {
+            let ids = self.thread_manager.list_thread_ids().await;
+            futures::future::join_all(ids.into_iter().map(|id| {
+                let guard_ids = &guard_ids;
+                async move {
+                    match self.thread_manager.get_thread(id).await {
+                        Ok(thread) => thread.terminate_governor_execs(guard_ids).await,
+                        Err(_) => false,
+                    }
+                }
+            }))
+            .await
+            .into_iter()
+            .all(|stopped| stopped)
+        })
+        .await
+        .unwrap_or(false);
+        if !tools_stopped {
+            for outcome in &mut outcomes {
+                outcome.stop_verified = false;
+                outcome.error.get_or_insert_with(|| {
+                    "Could not verify exact task-owned exec process exit".into()
+                });
+            }
+        }
+        let mut registry = self.governor_leases.lock().await;
+        if let Some(current) = registry.entries.get_mut(&root)
+            && current.lease_id == lease.lease_id
+            && current.deadline == Some(deadline)
+        {
+            current.expiry_pending = false;
+            if !current.released {
+                current.members = stopped_members;
+                current.stop_verified =
+                    tools_stopped && outcomes.iter().all(|outcome| outcome.stop_verified);
+                if self.index_guard_members(current).is_err() {
+                    current.stop_verified = false;
+                }
+                current.outcomes = outcomes;
+            }
+            if self.write_guard_mark(current).is_err() {
+                current.stop_verified = false;
+            }
+        }
+    }
+    async fn stop_expired_governor_member(
+        &self,
+        member: &Member,
+        root: ThreadId,
+        lease_id: &str,
+        deadline: Instant,
+    ) -> ThreadGovernorLeaseMemberOutcome {
+        let mut result = ThreadGovernorLeaseMemberOutcome {
+            thread_id: member.thread_id.to_string(),
+            goal_paused: false,
+            goal_preserved: false,
+            interrupted_turn_ids: Vec::new(),
+            stop_verified: true,
+            error: None,
+        };
+        let _guard = self
+            .thread_state_manager
+            .lock_goal_resume(member.thread_id)
+            .await;
+        if !self
+            .governor_leases
+            .lock()
+            .await
+            .entries
+            .get(&root)
+            .is_some_and(|lease| {
+                lease.lease_id == lease_id && lease.deadline == Some(deadline) && !lease.released
+            })
+        {
+            return result;
+        }
+
+        let thread = match self.thread_manager.get_thread(member.thread_id).await {
+            Ok(thread) => thread,
+            Err(_) => {
+                result.goal_preserved = true;
+                return result;
+            }
+        };
+        let mut automatic = None;
+        let mut updated_goal = None;
+        if let Some(expected) = &member.goal_id {
+            match self
+                .state_db_for_materialized_thread(member.thread_id, GoalAccess::Mutate)
+                .await
+            {
+                Ok(db) => match self
+                    .goal_service
+                    .pause_exact_goal_for_guard(&db, member.thread_id, expected)
+                    .await
+                {
+                    Ok((outcome, turn)) => {
+                        result.goal_paused = outcome.is_some();
+                        result.goal_preserved = outcome.is_none();
+                        updated_goal = outcome;
+                        automatic = turn;
+                    }
+                    Err(_) => {
+                        result.stop_verified = false;
+                        result.error = Some("Could not pause exact guarded goal".into());
+                    }
+                },
+                Err(_) => {
+                    result.stop_verified = false;
+                    result.error = Some("Could not verify guarded goal identity".into());
+                }
+            }
+        }
+        // Select and cancel the exact Core task atomically; a later operator turn is untouched.
+        if let Some(turn) = thread.active_turn_id().await
+            && (member.turn_ids.contains(&turn) || automatic.as_deref() == Some(turn.as_str()))
+        {
+            if thread.stop_guarded_turn_if_current(&turn).await {
+                result.interrupted_turn_ids.push(turn.clone());
+            }
+            if thread.active_turn_id().await.as_deref() == Some(turn.as_str()) {
+                result.stop_verified = false;
+                result.error = Some("Exact guarded turn remains active".into());
+            }
+        }
+        if let Some(outcome) = updated_goal {
+            if thread
+                .append_rollout_items(&[outcome.thread_goal_updated_item()])
+                .await
+                .is_err()
+                || thread.flush_rollout().await.is_err()
+            {
+                result.stop_verified = false;
+                result.error = Some("Could not retain guarded goal pause history".into());
+            }
+            self.emit_thread_goal_snapshot(member.thread_id).await;
+        }
+        result
+    }
+}
