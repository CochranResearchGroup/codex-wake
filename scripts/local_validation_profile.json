          "scripts/validation_preflight.py",
          "--tier",
          "comprehensive"
        ]
      },
      {
        "name": "pinned lint",
        "axis": "lint",
        "argv": [
          "{runtime}",
          "-m",
          "ruff",
          "check",
          "--select",
          "F821,F822,F823",
          "src",
          "scripts",
          "tests",
          ".codex/hooks"
        ]
      },
      {
        "name": "policy wiring",
        "axis": "policy",
        "argv": [
          "{runtime}",
          "scripts/check_policy_wiring.py"
        ]
      },
      {
        "name": "active planning audit",
        "axis": "planning",
        "argv": [
          "{runtime}",
          ".codex/skills/repo-policy-selector/scripts/audit_planning_contract.py",
          "--repo-root",
          ".",
          "--active-only",
          "--json"
        ]
      },
      {
        "name": "compilation",
        "axis": "compile",
        "argv": [
          "{runtime}",
          "-m",
          "compileall",
          "-q",
          "src",
          "tests",
          ".codex/hooks"
        ]
      },
      {
        "name": "public Python suite",
        "axis": "tests",
        "argv": [
          "{runtime}",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_*.py"
