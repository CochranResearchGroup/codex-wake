          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_local_validation.py"
        ]
      },
      {
        "name": "cleanup public regressions",
        "axis": "tests",
        "argv": [
          "{runtime}",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_cleanup_worktrees.py"
        ]
      },
      {
        "name": "summary public regressions",
        "axis": "tests",
        "argv": [
          "{runtime}",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_summarize_receipt.py"
        ]
      },
      {
        "name": "package build",
        "axis": "packaging",
        "argv": [
          "{runtime}",
          "scripts/validation_build.py",
          "--outdir",
          "{artifacts}"
        ]
      }
    ],
    "comprehensive": [
