diff --git a/codex-rs/app-server/src/request_processors/thread_notice.rs b/codex-rs/app-server/src/request_processors/thread_notice.rs
new file mode 100644
index 0000000000000000000000000000000000000000..758e7ce6df655c70c26114de63c298970277445b
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/thread_notice.rs
@@ -0,0 +1,121 @@
+//! Exact-thread notice publication; native control remains a separate operation.
+use super::*;
+use codex_app_server_protocol::ItemCompletedNotification;
+use codex_app_server_protocol::ThreadNotice;
+use codex_app_server_protocol::ThreadNoticeAppendParams;
+use codex_app_server_protocol::ThreadNoticeAppendResponse;
+use codex_app_server_protocol::ThreadNoticeReadParams;
+use codex_app_server_protocol::ThreadNoticeReadResponse;
+
+fn valid_event_id(event_id: &str) -> bool {
+    !event_id.is_empty()
+        && event_id.len() <= 128
+        && event_id
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'_' || byte == b'-')
+}
+
+impl TurnRequestProcessor {
+    pub(crate) async fn thread_notice_read(
+        &self,
+        params: ThreadNoticeReadParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        if !valid_event_id(&params.event_id) {
+            return Err(invalid_request("bounded notice event id required"));
+        }
+        let (_, thread) = self.load_thread(&params.thread_id).await?;
+        let retained = thread
+            .external_notice(&params.event_id)
+            .await
+            .map_err(|error| internal_error(format!("notice read failed: {error}")))?;
+        let model_context_available = retained.as_ref().is_some_and(|(_, available)| *available);
+        let notice = retained.map(|(text, _)| ThreadNotice {
+            event_id: params.event_id,
+            text,
+        });
+        Ok(Some(
+            ThreadNoticeReadResponse {
+                model_context_available,
+                notice,
+            }
+            .into(),
+        ))
+    }
+
+    pub(crate) async fn thread_notice_append(
+        &self,
+        params: ThreadNoticeAppendParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        if !valid_event_id(&params.event_id)
+            || params.text.is_empty()
+            || params.text.len() > 768
+            || !params
+                .text
+                .ends_with(&format!("[External supervision event {}]", params.event_id))
+        {
+            return Err(invalid_request(
+                "bounded event id and marked notice text required",
+            ));
+        }
+        let (thread_id, thread) = self.load_thread(&params.thread_id).await?;
+        let prior = thread
+            .external_notice(&params.event_id)
+            .await
+            .map_err(|error| internal_error(format!("notice history unavailable: {error}")))?;
+        if prior.as_ref().is_some_and(|(text, _)| text != &params.text) {
+            return Err(invalid_request(
+                "notice event id already has different content",
+            ));
+        }
+        let already_recorded = prior.is_some();
+        let mut notification_published = false;
+        if !already_recorded {
+            thread
+                .record_external_notice(&params.event_id, &params.text)
+                .await
+                .map_err(|error| internal_error(format!("notice append failed: {error}")))?;
+            let connections = self
+                .thread_state_manager
+                .subscribed_connection_ids(thread_id)
+                .await;
+
+            let notification = ServerNotification::ItemCompleted(ItemCompletedNotification {
+                thread_id: params.thread_id,
+                turn_id: params.event_id.clone(),
+                completed_at_ms: chrono::Utc::now().timestamp_millis(),
+                item: ThreadItem::AgentMessage {
+                    id: params.event_id.clone(),
+                    text: params.text,
+                    phase: None,
+                    memory_citation: None,
+                    delivery: None,
+                    questions: None,
+                },
+            });
+            // Confirm at least one actual write, never infer publication from a
+            // subscriber entry. Presentation/human reading remain unverified.
+            let _ = tokio::time::timeout(std::time::Duration::from_secs(1), async {
+                for connection in connections {
+                    notification_published |= self
+                        .outgoing
+                        .send_server_notification_to_connection_and_wait(
+                            connection,
+                            notification.clone(),
+                        )
+                        .await;
+                }
+            })
+            .await;
+        }
+        Ok(Some(
+            ThreadNoticeAppendResponse {
+                event_id: params.event_id,
+                recorded: true,
+                model_context_available: prior.is_none_or(|(_, available)| available),
+                notification_published,
+                already_recorded,
+            }
+            .into(),
+        ))
+    }
+}
