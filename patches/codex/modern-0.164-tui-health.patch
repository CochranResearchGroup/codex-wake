@@ -0,0 +1,265 @@
+//! Routing/bounds tests use the real outgoing owner. They do not qualify a TUI loop.
+use super::tui_health::TuiHealth;
+use crate::outgoing_message::{ConnectionId, OutgoingEnvelope, OutgoingMessageSender};
+use codex_analytics::AnalyticsEventsClient;
+use codex_app_server_protocol::*;
+use codex_protocol::ThreadId;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::mpsc;
+
+fn binding() -> TuiHealthBinding {
+    TuiHealthBinding {
+        home: "/synthetic".into(),
+        provider: "synthetic".into(),
+        backend_id: "backend".into(),
+        channel: "native_tui".into(),
+        pid: std::process::id(),
+        start_ticks: std::fs::read_to_string("/proc/self/stat")
+            .unwrap()
+            .rsplit_once(')')
+            .unwrap()
+            .1
+            .split_whitespace()
+            .nth(19)
+            .unwrap()
+            .into(),
+        boot_id: std::fs::read_to_string("/proc/sys/kernel/random/boot_id")
+            .unwrap()
+            .trim()
+            .into(),
+        connection_generation: "generation".into(),
+    }
+}
+fn params(binding: &TuiHealthBinding, nonce: u32) -> TuiHealthProbeParams {
+    TuiHealthProbeParams {
+        binding: binding.clone(),
+        thread_id: ThreadId::new().to_string(),
+        challenge: format!("{nonce:064x}"),
+        timeout_ms: 50,
+    }
+}
+
+#[tokio::test]
+async fn health_challenge_owner_cannot_be_resolved_by_other_connections_or_replayed_as_input() {
+    let (sender, mut messages) = mpsc::channel(16);
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        sender,
+        AnalyticsEventsClient::disabled(),
+    ));
+    let service = Arc::new(TuiHealth::new("/synthetic".into()));
+    let binding = binding();
+    let owner = ConnectionId(1);
+    let other = ConnectionId(2);
+    assert!(
+        service
+            .register(
+                owner,
+                Some(binding.pid + 1),
+                TuiHealthRegisterParams {
+                    binding: binding.clone()
+                }
+            )
+            .await
+            .is_err()
+    );
+    let mut other_account = binding.clone();
+    other_account.home = "/different-native-account".into();
+    assert!(
+        service
+            .register(
+                owner,
+                Some(binding.pid),
+                TuiHealthRegisterParams {
+                    binding: other_account
+                }
+            )
+            .await
+            .is_err()
+    );
+    service
+        .register(
+            owner,
+            Some(binding.pid),
+            TuiHealthRegisterParams {
+                binding: binding.clone(),
+            },
+        )
+        .await
+        .unwrap();
+    let mut p = params(&binding, 1);
+    p.timeout_ms = 5000;
+    let expected = p.clone();
+    let (s, o) = (service.clone(), outgoing.clone());
+    let mut probe = tokio::spawn(async move { s.probe(p, &o).await });
+    let message = messages.recv().await.unwrap();
+    let id = match message {
+        OutgoingEnvelope::ToConnection {
+            connection_id,
+            message: codex_app_server_transport::OutgoingMessage::Request(request),
+            ..
+        } => {
+            assert_eq!(connection_id, owner);
+            assert!(matches!(&request, ServerRequest::TuiHealthChallenge { .. }));
+            request.id().clone()
+        }
+        _ => panic!("health request not targeted"),
+    };
+    assert!(
+        outgoing
+            .pending_requests_for_thread(ThreadId::from_string(&expected.thread_id).unwrap())
+            .await
+            .is_empty()
+    );
+    let response = TuiHealthResponse {
+        binding: binding.clone(),
+        thread_id: expected.thread_id,
+        challenge: expected.challenge,
+        state: "responsive".into(),
+        evidence: "tui_main_loop_ack".into(),
+        loop_tid: 1,
+    };
+    outgoing
+        .notify_client_response(other, id.clone(), serde_json::to_value(&response).unwrap())
+        .await;
+    outgoing
+        .notify_client_error(
+            other,
+            id.clone(),
+            JSONRPCErrorError {
+                code: -32001,
+                message: "wrong peer".into(),
+                data: None,
+            },
+        )
+        .await;
+    assert!(
+        tokio::time::timeout(Duration::from_millis(20), &mut probe)
+            .await
+            .is_err()
+    );
+    outgoing
+        .replay_requests_to_connection_for_thread(other, ThreadId::new())
+        .await;
+    assert!(messages.try_recv().is_err());
+    outgoing
+        .notify_client_response(owner, id, serde_json::to_value(response).unwrap())
+        .await;
+    assert!(probe.await.unwrap().is_ok());
+}
+
+#[tokio::test]
+async fn expired_foreground_events_are_bounded_until_exact_origin_drains_or_disconnects() {
+    let (sender, mut messages) = mpsc::channel(16);
+    let outgoing = OutgoingMessageSender::new(sender, AnalyticsEventsClient::disabled());
+    let service = TuiHealth::new("/synthetic".into());
+    let binding = binding();
+    let owner = ConnectionId(1);
+    let other = ConnectionId(2);
+    service
+        .register(
+            owner,
+            Some(binding.pid),
+            TuiHealthRegisterParams {
+                binding: binding.clone(),
+            },
+        )
+        .await
+        .unwrap();
+    let mut ids = Vec::new();
+    for nonce in 0..8 {
+        assert!(
+            service
+                .probe(params(&binding, nonce), &outgoing)
+                .await
+                .unwrap_err()
+                .message
+                .contains("deadline")
+        );
+        if let OutgoingEnvelope::ToConnection {
+            message: codex_app_server_transport::OutgoingMessage::Request(request),
+            ..
+        } = messages.recv().await.unwrap()
+        {
+            ids.push(request.id().clone());
+        }
+    }
+    assert_eq!(ids.len(), 8);
+    assert!(
+        service
+            .probe(params(&binding, 9), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("capacity")
+    );
+    service.retire(other, &ids[0]).await;
+    assert!(
+        service
+            .probe(params(&binding, 10), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("capacity")
+    );
+    service.retire(owner, &ids[0]).await;
+    assert!(
+        service
+            .probe(params(&binding, 11), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("deadline")
+    );
+    service.disconnect(owner, &outgoing).await;
+    assert!(
+        service
+            .describe(TuiHealthDescribeParams { pid: binding.pid })
+            .await
+            .bindings
+            .is_empty()
+    );
+    assert!(
+        service
+            .probe(params(&binding, 12), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("unavailable")
+    );
+}
+
+#[tokio::test]
+async fn full_outgoing_channel_refuses_health_without_waiting_for_foreground() {
+    let (sender, _messages) = mpsc::channel(1);
+    let outgoing = OutgoingMessageSender::new(sender, AnalyticsEventsClient::disabled());
+    let service = TuiHealth::new("/synthetic".into());
+    let binding = binding();
+    let owner = ConnectionId(1);
+    service
+        .register(
+            owner,
+            Some(binding.pid),
+            TuiHealthRegisterParams {
+                binding: binding.clone(),
+            },
+        )
+        .await
+        .unwrap();
+    assert!(
+        service
+            .probe(params(&binding, 1), &outgoing)
+            .await
+            .unwrap_err()
+            .message
+            .contains("deadline")
+    );
+    let refused = tokio::time::timeout(
+        Duration::from_secs(1),
+        service.probe(params(&binding, 2), &outgoing),
+    )
+    .await
+    .unwrap()
+    .unwrap_err();
+    assert!(refused.message.contains("reply unavailable"));
+}
