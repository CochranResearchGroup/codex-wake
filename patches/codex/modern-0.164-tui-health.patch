@@ -0,0 +1,544 @@
+use anyhow::Result;
+use app_test_support::TestAppServer;
+use app_test_support::to_response;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ThreadHistoryMode;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::ThreadStartResponse;
+use codex_app_server_protocol::TurnStartParams;
+use codex_app_server_protocol::UserInput;
+use core_test_support::responses;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::TempDir;
+use test_case::test_case;
+use tokio::time::Duration;
+use tokio::time::timeout;
+
+async fn rpc(
+    client: &mut TestAppServer,
+    method: &str,
+    params: serde_json::Value,
+) -> Result<serde_json::Value> {
+    let id = client.send_raw_request(method, Some(params)).await?;
+    Ok(client
+        .read_stream_until_response_message(RequestId::Integer(id))
+        .await?
+        .result)
+}
+
+#[test_case(None; "default_paginated")]
+#[test_case(Some(ThreadHistoryMode::Legacy); "legacy")]
+#[tokio::test]
+async fn notice_is_durable_idempotent_visible_and_starts_no_model_turn(
+    history_mode: Option<ThreadHistoryMode>,
+) -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let model = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_response_created("notice-response"),
+            responses::ev_assistant_message(
+                "notice-model-answer",
+                "Operator continuation complete",
+            ),
+            json!({"type":"response.completed","response":{"id":"notice-response","usage":{
+            "input_tokens":20,"input_tokens_details":{"cached_tokens":10},"output_tokens":5,
+            "output_tokens_details":{"reasoning_tokens":0},"total_tokens":25}}}),
+        ]),
+    )
+    .await;
+    let home = TempDir::new()?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!(
+            r#"
+model = "mock-model"
+approval_policy = "never"
+sandbox_mode = "read-only"
+model_provider = "mock_provider"
+[model_providers.mock_provider]
+name = "Notice test"
+base_url = "{}/v1"
+wire_api = "responses"
+request_max_retries = 0
+stream_max_retries = 0
+"#,
+            server.uri()
+        ),
+    )?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized_with_timeout(Duration::from_secs(10))
+        .await?;
+    let start = client
+        .send_thread_start_request_with_auto_env(ThreadStartParams {
+            history_mode,
+            ..Default::default()
+        })
+        .await?;
+    let started: ThreadStartResponse = to_response(
+        client
+            .read_stream_until_response_message(RequestId::Integer(start))
+            .await?,
+    )?;
+    let thread = started.thread;
+    let goal_before_notice = rpc(
+        &mut client,
+        "thread/goal/get",
+        json!({"threadId":thread.id}),
+    )
+    .await?;
+    let event = "notice_owned_stop_1";
+    let text = "Goal paused: external token allowance reached. Extend allowance / Reset budget window / Keep stopped. Native /goal resume alone does not renew this external allowance. [External supervision event notice_owned_stop_1]";
+    let append = client
+        .send_raw_request(
+            "thread/notice/append",
+            Some(json!({"threadId":thread.id,"eventId":event,"text":text})),
+        )
+        .await?;
+    let shown = timeout(
+        Duration::from_secs(10),
+        client.read_stream_until_notification_message("item/completed"),
+    )
+    .await??;
+    assert_eq!(
+        shown
+            .params
+            .as_ref()
+            .and_then(|params| params.get("item"))
+            .and_then(|item| item.get("text")),
+        Some(&json!(text))
+    );
+    let appended = client
+        .read_stream_until_response_message(RequestId::Integer(append))
+        .await?;
+    assert_eq!(
+        appended.result,
+        json!({"eventId":event,"recorded":true,"modelContextAvailable":true,"notificationPublished":true,"alreadyRecorded":false})
+    );
+    assert_eq!(model.requests().len(), 0);
+    let duplicate = client
+        .send_raw_request(
+            "thread/notice/append",
+            Some(json!({"threadId":thread.id,"eventId":event,"text":text})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(duplicate))
+            .await?
+            .result,
+        json!({"eventId":event,"recorded":true,"modelContextAvailable":true,"notificationPublished":false,"alreadyRecorded":true})
+    );
+    let changed = client
+        .send_raw_request(
+            "thread/notice/append",
+            Some(json!({"threadId":thread.id,"eventId":event,"text":format!("Changed {text}")})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_error_message(RequestId::Integer(changed))
+            .await?
+            .error
+            .code,
+        -32600
+    );
+    let read = client
+        .send_raw_request(
+            "thread/notice/read",
+            Some(json!({"threadId":thread.id,"eventId":event})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(read))
+            .await?
+            .result,
+        json!({"notice":{"eventId":event,"text":text},"modelContextAvailable":true})
+    );
+    let history = std::fs::read_to_string(thread.path.as_ref().expect("rollout path"))?;
+    assert_eq!(
+        history
+            .lines()
+            .filter(|line| line.contains("external_supervision") && line.contains(event))
+            .count(),
+        1
+    );
+    let rows = history
+        .lines()
+        .map(|line| serde_json::from_str::<serde_json::Value>(line).expect("valid rollout"))
+        .collect::<Vec<_>>();
+    let display_rows = rows
+        .iter()
+        .filter(|row| {
+            row["type"] == "event_msg"
+                && (row["payload"]["type"] == "agent_message" && row["payload"]["message"] == text
+                    || row["payload"]["type"] == "item_completed"
+                        && row["payload"]["item"]["type"] == "AgentMessage"
+                        && row["payload"]["item"]["id"] == event)
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(display_rows.len(), 1);
+    let display = &display_rows[0]["payload"];
+    if history_mode == Some(ThreadHistoryMode::Legacy) {
+        assert_eq!(display["type"], "agent_message");
+        assert_eq!(display["message"], text);
+    } else {
+        assert_eq!(display["type"], "item_completed");
+        assert_eq!(display["thread_id"], thread.id);
+        assert_eq!(display["turn_id"], event);
+        assert_eq!(display["item"]["type"], "AgentMessage");
+        assert_eq!(display["item"]["id"], event);
+        assert_eq!(
+            display["item"]["content"],
+            json!([{"type":"Text","text":text}])
+        );
+    }
+    assert!(!rows.iter().any(|row| row["type"] == "event_msg"
+        && matches!(
+            row["payload"]["type"].as_str(),
+            Some("task_started" | "token_count")
+        )));
+    let completions = rows
+        .iter()
+        .filter(|row| row["type"] == "event_msg" && row["payload"]["type"] == "task_complete")
+        .collect::<Vec<_>>();
+    if history_mode == Some(ThreadHistoryMode::Legacy) {
+        assert!(completions.is_empty());
+    } else {
+        assert_eq!(completions.len(), 1);
+        assert_eq!(
+            completions[0]["payload"],
+            json!({"type":"task_complete","root_turn_id":event,"turn_id":event,"last_agent_message":null})
+        );
+    }
+    // A new process must discover the persisted notice, not a live-session cache.
+    client.shutdown_gracefully().await?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized_with_timeout(Duration::from_secs(10))
+        .await?;
+    let resume = client
+        .send_raw_request("thread/resume", Some(json!({"threadId":thread.id})))
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(resume))
+        .await?;
+    let cold_read = client
+        .send_raw_request(
+            "thread/notice/read",
+            Some(json!({"threadId":thread.id,"eventId":event})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(cold_read))
+            .await?
+            .result,
+        json!({"notice":{"eventId":event,"text":text},"modelContextAvailable":true})
+    );
+    let cold_duplicate = client
+        .send_raw_request(
+            "thread/notice/append",
+            Some(json!({"threadId":thread.id,"eventId":event,"text":text})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(cold_duplicate))
+            .await?
+            .result,
+        json!({"eventId":event,"recorded":true,"modelContextAvailable":true,"notificationPublished":false,"alreadyRecorded":true})
+    );
+    assert_eq!(model.requests().len(), 0);
+    assert_eq!(
+        rpc(
+            &mut client,
+            "thread/goal/get",
+            json!({"threadId":thread.id})
+        )
+        .await?,
+        goal_before_notice
+    );
+    if history_mode != Some(ThreadHistoryMode::Legacy) {
+        let page = rpc(
+            &mut client,
+            "thread/turns/list",
+            json!({"threadId":thread.id}),
+        )
+        .await?;
+        let turns = page["data"].as_array().expect("public turn page");
+        assert_eq!(
+            turns.len(),
+            1,
+            "notice requires a cold-readable display container"
+        );
+        let container = &turns[0];
+        assert_eq!(container["id"], event);
+        assert_eq!(container["rootTurnId"], event);
+        assert_eq!(container["status"], "completed");
+        for field in ["startedAt", "completedAt", "durationMs", "error"] {
+            assert!(container[field].is_null(), "display container {field}");
+        }
+        let items = rpc(
+            &mut client,
+            "thread/items/list",
+            json!({"threadId":thread.id,"turnId":event}),
+        )
+        .await?;
+        let entries = items["data"].as_array().expect("public item page");
+        assert_eq!(entries.len(), 1);
+        assert_eq!(entries[0]["turnId"], event);
+        assert_eq!(entries[0]["item"]["id"], event);
+        assert_eq!(entries[0]["item"]["type"], "agentMessage");
+        assert_eq!(entries[0]["item"]["text"], text);
+    }
+    // Only this explicit operator continuation starts a local mock model request.
+    let turn = client
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Continue with approved operator work".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(turn))
+        .await?;
+    timeout(
+        Duration::from_secs(10),
+        client.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let flushed = client
+        .send_raw_request(
+            "thread/notice/read",
+            Some(json!({"threadId":thread.id,"eventId":event})),
+        )
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(flushed))
+        .await?;
+    let rows = std::fs::read_to_string(thread.path.as_ref().expect("rollout path"))?;
+    let usage_rows = rows
+        .lines()
+        .map(|line| serde_json::from_str::<serde_json::Value>(line).expect("valid rollout"))
+        .filter(|row| row.get("type") == Some(&json!("token_usage_record")))
+        .collect::<Vec<_>>();
+    assert_eq!(usage_rows.len(), 1);
+    assert_eq!(
+        usage_rows[0]["payload"]["response_id"],
+        json!("notice-response")
+    );
+    assert_eq!(usage_rows[0]["payload"]["thread_id"], json!(thread.id));
+    assert_eq!(
+        usage_rows[0]["payload"]["root_turn_id"],
+        usage_rows[0]["payload"]["turn_id"]
+    );
+    assert_eq!(
+        usage_rows[0]["payload"]["usage"],
+        json!({"input_tokens":20,"cached_input_tokens":10,"cache_write_input_tokens":0,
+        "output_tokens":5,"reasoning_output_tokens":0,"total_tokens":25})
+    );
+    let input = model.single_request().input();
+    assert!(input.iter().any(|item| {
+        item.get("content")
+            .and_then(|content| content.as_array())
+            .is_some_and(|parts| {
+                parts.iter().any(|part| {
+                    part.get("text")
+                        .and_then(|value| value.as_str())
+                        .is_some_and(|text| {
+                            text.contains("external_supervision") && text.contains(event)
+                        })
+                })
+            })
+    }));
+    Ok(())
+}
