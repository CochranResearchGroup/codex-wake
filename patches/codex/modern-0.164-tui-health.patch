+            status(&mut app, thread).await?.data[0]
+                .tools
+                .contains_key("old_widget")
+        );
+    }
+    let admitted: ThreadMcpServerReloadResponse = app
+        .request(|request_id| ClientRequest::ThreadMcpServerReload {
+            request_id,
+            params: ThreadMcpServerReloadParams {
+                thread_id: threads[0].clone(),
+                dry_run: Some(false),
+            },
+        })
+        .await?;
+    assert!(admitted.queued);
+    assert_eq!(admitted.thread_id, threads[0]);
+    assert!(
+        status(&mut app, &threads[0]).await?.data[0]
+            .tools
+            .contains_key("new_widget")
+    );
+    assert!(
+        status(&mut app, &threads[1]).await?.data[0]
+            .tools
+            .contains_key("old_widget")
+    );
+    let missing_scope_id = app
+        .send_raw_request("mcpServerStatus/list", Some(json!({"runtimeOnly": true})))
+        .await?;
+    let missing_scope = timeout(
+        DEFAULT_READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(missing_scope_id)),
+    )
+    .await??;
+    assert_eq!(missing_scope.error.code, -32600);
+    assert!(missing_scope.error.message.contains("exact loaded thread"));
+    let requests = server
+        .received_requests()
+        .await
+        .expect("recorded MCP requests");
+    let startups = requests
+        .iter()
+        .filter(|request| {
+            serde_json::from_slice::<serde_json::Value>(&request.body)
+                .is_ok_and(|value| value["method"] == "initialize")
+        })
+        .count();
+    assert_eq!(startups, 3, "only the selected runtime may reconnect");
+    assert!(
+        !requests
+            .iter()
+            .any(|request| request.url.path().ends_with("/responses"))
+    );
+    Ok(())
+}
