diff --git a/codex-rs/core/src/codex_thread/external_notice.rs b/codex-rs/core/src/codex_thread/external_notice.rs
new file mode 100644
index 0000000000000000000000000000000000000000..44e2a9709bfb031d4481b7c798b8dc561d1999c6
--- /dev/null
+++ b/codex-rs/core/src/codex_thread/external_notice.rs
@@ -0,0 +1,208 @@
+//! Durable, bounded external notices do not schedule model work.
+use super::CodexThread;
+use crate::context::ContextualUserFragment;
+use crate::context::InternalContextSource;
+use crate::context::InternalModelContextFragment;
+use codex_history::RolloutItem;
+use codex_protocol::ResponseItemId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::items::AgentMessageContent;
+use codex_protocol::items::AgentMessageItem;
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::AgentMessageEvent;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ItemCompletedEvent;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_protocol::protocol::TurnCompleteEvent;
+use codex_thread_store::ItemSortKey;
+use codex_thread_store::ListItemsParams;
+use codex_thread_store::ListItemsPosition;
+use codex_thread_store::LoadThreadHistoryParams;
+use codex_thread_store::SortDirection;
+use codex_thread_store::ThreadStoreError;
+
+impl CodexThread {
+    /// Find a persisted notice without creating a model turn.
+    pub async fn external_notice(&self, event_id: &str) -> Result<Option<(String, bool)>> {
+        // A newly loaded thread can defer its rollout until first use. Materialize
+        // the existing session header, never a user turn, before inspecting it.
+        self.ensure_rollout_materialized().await;
+        self.flush_rollout().await?;
+        let history = self.external_notice_history(event_id).await?;
+        let marker = format!("[External supervision event {event_id}]");
+        let in_context = self.session.clone_history().await.raw_items().any(|item| {
+            matches!(item,
+            ResponseItem::Message { id: Some(id), .. } if id.as_str() == event_id)
+        });
+        Ok(history.iter().find_map(|item| match item {
+            RolloutItem::EventMsg(EventMsg::AgentMessage(message))
+                if message.message.ends_with(&marker) =>
+            {
+                Some((message.message.clone(), in_context))
+            }
+            _ => None,
+        }))
+    }
+
+    /// Paginated stores retain display items independently of compacted model context.
+    /// Scan every persisted item page so an old notice remains an idempotency key.
+    async fn external_notice_history(&self, event_id: &str) -> Result<Vec<RolloutItem>> {
+        let store = &self.session.services.thread_store;
+        let mut items = match self.load_history(false).await {
+            Ok(history) => return Ok(history.items),
+            Err(ThreadStoreError::Unsupported {
+                operation: "paginated_threads",
+            }) => {
+                store
+                    .load_latest_model_context(LoadThreadHistoryParams {
+                        thread_id: self.session.thread_id,
+                        include_archived: false,
+                    })
+                    .await
+                    .map_err(|error| {
+                        CodexErr::InvalidRequest(format!("notice context unavailable: {error}"))
+                    })?
+                    .items
+            }
+            Err(error) => {
+                return Err(CodexErr::InvalidRequest(format!(
+                    "notice history unavailable: {error}"
+                )));
+            }
+        };
+        let marker = format!("[External supervision event {event_id}]");
+        let mut position = None;
+        loop {
+            let page = store
+                .list_items(ListItemsParams {
+                    item_ids: None,
+                    thread_id: self.session.thread_id,
+                    turn_id: None,
+                    include_archived: false,
+                    position,
+                    page_size: 256,
+                    sort_direction: SortDirection::Asc,
+                    sort_key: ItemSortKey::CreatedAtOrdinal,
+                    after_updated_at_ordinal: None,
+                })
+                .await
+                .map_err(|error| {
+                    CodexErr::InvalidRequest(format!("notice items unavailable: {error}"))
+                })?;
+            for saved in page.items {
+                let item: serde_json::Value =
+                    serde_json::from_slice(&saved.item_json).map_err(|error| {
+                        CodexErr::InvalidRequest(format!("notice item invalid: {error}"))
+                    })?;
+                if item["type"] == "agentMessage"
+                    && let Some(text) = item["text"].as_str().filter(|text| text.ends_with(&marker))
+                {
+                    items.push(RolloutItem::EventMsg(EventMsg::AgentMessage(
+                        AgentMessageEvent {
+                            message: text.to_owned(),
+                            phase: None,
+                            memory_citation: None,
+                            delivery: None,
+                            questions: None,
+                        },
+                    )));
+                }
+            }
+            match page.next_cursor {
+                Some(cursor) => position = Some(ListItemsPosition::Cursor(cursor)),
+                None => return Ok(items),
+            }
+        }
+    }
+
+    /// Record model context and a replayable display event even while a tool is busy.
+    /// The caller serializes notice requests for this thread; no turn is started.
+    pub async fn record_external_notice(&self, event_id: &str, text: &str) -> Result<()> {
+        if text.len() > 768 || text.is_empty() || event_id.len() > 128 || event_id.is_empty() {
+            return Err(CodexErr::InvalidRequest(
+                "external notice exceeds bounded context size".into(),
+            ));
+        }
+        let fragment = InternalModelContextFragment::new(
+            InternalContextSource::from_static("external_supervision"),
+            text,
+        );
+        let mut item: ResponseItem = ContextualUserFragment::into(fragment);
+        if let ResponseItem::Message { id, .. } = &mut item {
+            *id = Some(ResponseItemId::from_server(event_id.to_owned()));
+        }
+        let history = self.external_notice_history(event_id).await?;
+        let saved = history.iter().find_map(|saved| match saved {
+            RolloutItem::ResponseItem(envelope) => match &envelope.item {
+                ResponseItem::Message {
+                    id: Some(id),
+                    content,
+                    ..
+                } if id.as_str() == event_id => Some(content),
+                _ => None,
+            },
+            _ => None,
+        });
+        if let Some(content) = saved {
+            let expected = match &item {
+                ResponseItem::Message { content, .. } => content,
+                _ => unreachable!(),
+            };
+            if content != expected {
+                return Err(CodexErr::InvalidRequest(
+                    "notice event id already has different content".into(),
+                ));
+            }
+        } else {
+            let turn = self.session.new_inject_items_context().await;
+            self.session
+                .record_conversation_items(turn.as_ref(), turn.model_info(), &[item])
+                .await;
+        }
+        // The event is separate from the model item so existing clients replay it.
+        // Reconcile a partial append by retaining the same id/context, never reinjecting it.
+        let marker = format!("[External supervision event {event_id}]");
+        if !history.iter().any(|saved| matches!(saved,
+            RolloutItem::EventMsg(EventMsg::AgentMessage(message)) if message.message.ends_with(&marker))) {
+            // Upstream persistence selects AgentMessage for legacy history and
+            // ItemCompleted for paginated history. Keep both inputs so each mode
+            // retains its canonical display representation without a model turn.
+            let mut display_items = vec![
+                RolloutItem::EventMsg(EventMsg::AgentMessage(AgentMessageEvent {
+                    message: text.to_owned(), phase: None, memory_citation: None, delivery: None, questions: None,
+                })),
+                RolloutItem::EventMsg(EventMsg::ItemCompleted(ItemCompletedEvent {
+                    thread_id: self.session.thread_id,
+                    turn_id: event_id.to_owned(),
+                    item: TurnItem::AgentMessage(AgentMessageItem {
+                        id: event_id.to_owned(),
+                        content: vec![AgentMessageContent::Text { text: text.to_owned() }],
+                        phase: None, memory_citation: None, delivery: None, questions: None,
+                    }),
+                    started_at_ms: None,
+                    completed_at_ms: chrono::Utc::now().timestamp_millis(),
+                })),
+            ];
+            if self.config_snapshot().await.history_mode == ThreadHistoryMode::Paginated {
+                // Canonical paginated turn paging needs a display container as well
+                // as its item. This is persisted directly, never dispatched through
+                // the session's model-turn completion or goal/accounting handlers.
+                display_items.push(RolloutItem::EventMsg(EventMsg::TurnComplete(TurnCompleteEvent {
+                    root_turn_id: Some(event_id.to_owned()),
+                    turn_id: event_id.to_owned(),
+                    last_agent_message: None,
+                    error: None,
+                    started_at: None,
+                    completed_at: None,
+                    duration_ms: None,
+                    time_to_first_token_ms: None,
+                })));
+            }
+            self.append_rollout_items(&display_items).await.map_err(|error| CodexErr::InvalidRequest(format!("notice display append failed: {error}")))?;
+        }
+        self.flush_rollout().await?;
+        Ok(())
+    }
+}
