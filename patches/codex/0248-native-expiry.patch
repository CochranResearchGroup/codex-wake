+        .bind(thread_id.to_string())
+        .bind(item_id)
+        .fetch_optional(self.pool.as_ref())
+        .await?;
+        row.map(|row| {
+            let status: String = row.try_get("status")?;
+            let status = match status.as_str() {
+                "canceled" => crate::BoundedQueueStatus::Canceled,
+                "expired" => crate::BoundedQueueStatus::Expired,
+                "admitted" => crate::BoundedQueueStatus::Admitted {
+                    turn_id: row.try_get("turn_id")?,
+                },
+                _ => anyhow::bail!("unknown bounded queue outcome"),
+            };
+            Ok(crate::BoundedQueueOutcome {
+                record: QueuedUserSubmissionRecord::try_from_row(&row)?,
+                status,
+            })
+        })
+        .transpose()
+    }
