diff --git a/codex-rs/state/queue_migrations/0003_bounded_queue.sql b/codex-rs/state/queue_migrations/0003_bounded_queue.sql
new file mode 100644
index 0000000000..aa60f1dc96
--- /dev/null
+++ b/codex-rs/state/queue_migrations/0003_bounded_queue.sql
@@ -0,0 +1,11 @@
+-- NULL preserves legacy unbounded queue semantics.
+ALTER TABLE queued_items ADD COLUMN expires_at INTEGER CHECK (expires_at > 0);
+CREATE TABLE bounded_queue_outcomes (
+    id TEXT PRIMARY KEY NOT NULL,
+    thread_id TEXT NOT NULL,
+    payload_json TEXT NOT NULL,
+    expires_at INTEGER NOT NULL CHECK (expires_at > 0),
+    status TEXT NOT NULL,
+    recorded_at_ms INTEGER NOT NULL
+);
+CREATE INDEX bounded_queue_outcomes_thread_idx ON bounded_queue_outcomes(thread_id);
diff --git a/codex-rs/state/queue_migrations/0004_bounded_admission.sql b/codex-rs/state/queue_migrations/0004_bounded_admission.sql
new file mode 100644
index 0000000000..4f861eb0f5
--- /dev/null
+++ b/codex-rs/state/queue_migrations/0004_bounded_admission.sql
@@ -0,0 +1,3 @@
+ALTER TABLE bounded_queue_outcomes ADD COLUMN turn_id TEXT
+    CHECK ((status = 'admitted' AND turn_id IS NOT NULL AND length(turn_id) > 0)
+        OR (status <> 'admitted' AND turn_id IS NULL));
