+#[tokio::test]
+async fn bounded_queue_admission_and_cancellation_choose_one_durable_outcome() {
+    let (runtime, thread_id) = runtime_with_thread().await;
+    let other = StateRuntime::init(runtime.sqlite().clone(), "test-provider".to_string())
+        .await
+        .unwrap();
+    let item = runtime
+        .thread_queue()
+        .enqueue_bounded(thread_id, "original", 1794800000)
+        .await
+        .unwrap();
+    let admission = crate::BoundedQueueStatus::Admitted {
+        turn_id: "owned-turn".to_string(),
+    };
+    let (admitted, canceled) = tokio::join!(
+        runtime
+            .thread_queue()
+            .settle_bounded(&item, admission.clone()),
+        other.thread_queue().delete(thread_id, &item.id),
+    );
+    let admitted = admitted.unwrap();
+    let canceled = canceled.unwrap();
+    assert_ne!(admitted, canceled);
+    let outcome = runtime
+        .thread_queue()
+        .bounded_outcome(thread_id, &item.id)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(outcome.record, item);
+    assert_eq!(
+        outcome.status,
+        if admitted {
+            admission.clone()
+        } else {
+            crate::BoundedQueueStatus::Canceled
+        }
+    );
+    assert!(
+        !other
+            .thread_queue()
+            .settle_bounded(&item, admission)
+            .await
+            .unwrap()
+    );
+    assert_eq!(
+        other
+            .thread_queue()
+            .bounded_outcome(thread_id, &item.id)
+            .await
+            .unwrap(),
+        Some(outcome)
+    );
+}
