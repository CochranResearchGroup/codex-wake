+        let (status, turn_id) = match status {
+            crate::BoundedQueueStatus::Canceled => ("canceled", None),
+            crate::BoundedQueueStatus::Expired => ("expired", None),
+            crate::BoundedQueueStatus::Admitted { turn_id } => {
+                anyhow::ensure!(
+                    !turn_id.is_empty(),
+                    "admitted queue entry requires its original turn ID"
+                );
+                ("admitted", Some(turn_id))
