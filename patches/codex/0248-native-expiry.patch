+#[tokio::test]
+async fn bounded_queue_cancellation_survives_reopen_with_original_deadline() {
+    let (runtime, thread_id) = runtime_with_thread().await;
+    let sqlite = runtime.sqlite().clone();
+    let item = runtime
+        .thread_queue()
+        .enqueue_bounded(thread_id, r#"{"client":"original"}"#, 1794800000)
+        .await
+        .unwrap();
+    runtime
+        .thread_queue()
+        .update(thread_id, &item.id, r#"{"client":"updated"}"#)
+        .await
+        .unwrap();
+    assert!(
+        runtime
+            .thread_queue()
+            .delete(thread_id, &item.id)
+            .await
+            .unwrap()
+    );
+    let reopened = StateRuntime::init(sqlite, "test-provider".to_string())
+        .await
+        .unwrap();
+    assert!(
+        reopened
+            .thread_queue()
+            .list_page(thread_id, /*offset*/ 0, /*limit*/ 10)
+            .await
+            .unwrap()
+            .is_empty()
+    );
+    let outcome = reopened
+        .thread_queue()
+        .bounded_outcome(thread_id, &item.id)
+        .await
+        .unwrap()
+        .expect("durable cancellation");
+    assert_eq!(outcome.record.expires_at, Some(1794800000));
+    assert_eq!(outcome.record.payload, r#"{"client":"updated"}"#);
+    assert_eq!(outcome.status, crate::BoundedQueueStatus::Canceled);
+    assert!(
+        !reopened
+            .thread_queue()
+            .delete(thread_id, &item.id)
+            .await
+            .unwrap()
+    );
+    assert_eq!(
+        reopened
+            .thread_queue()
+            .bounded_outcome(thread_id, &item.id)
+            .await
+            .unwrap(),
+        Some(outcome)
+    );
+}
