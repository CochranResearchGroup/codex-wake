+#[tokio::test]
+async fn notice_is_immediately_retained_while_model_response_is_pending() -> Result<()> {
+    use wiremock::Mock;
+    use wiremock::ResponseTemplate;
+    use wiremock::matchers::method;
+    use wiremock::matchers::path;
+    let server = responses::start_mock_server().await;
+    let body = responses::sse(vec![
+        responses::ev_response_created("busy-notice-response"),
+        responses::ev_assistant_message("busy-notice-answer", "Local model finished"),
+        responses::ev_completed("busy-notice-response"),
+    ]);
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(
+            ResponseTemplate::new(200)
+                .set_body_raw(body, "text/event-stream")
+                .set_delay(Duration::from_secs(2)),
+        )
+        .expect(1)
+        .mount(&server)
+        .await;
+    let home = TempDir::new()?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!(
+            r#"
+model = "mock-model"
+approval_policy = "never"
+sandbox_mode = "read-only"
+model_provider = "mock_provider"
+[model_providers.mock_provider]
+name = "Busy notice test"
+base_url = "{}/v1"
+wire_api = "responses"
+request_max_retries = 0
+stream_max_retries = 0
+"#,
+            server.uri()
+        ),
+    )?;
+    let mut client = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized_with_timeout(Duration::from_secs(10))
+        .await?;
+    let start = client
+        .send_thread_start_request_with_auto_env(ThreadStartParams::default())
+        .await?;
+    let started: ThreadStartResponse = to_response(
+        client
+            .read_stream_until_response_message(RequestId::Integer(start))
+            .await?,
+    )?;
+    let thread = started.thread;
+    let turn = client
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Owned local delayed response".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(turn))
+        .await?;
+    let event = "notice_busy_model_1";
+    let text = "External supervision changed while this model request was busy. [External supervision event notice_busy_model_1]";
+    let append = client
+        .send_raw_request(
+            "thread/notice/append",
+            Some(json!({"threadId":thread.id,"eventId":event,"text":text})),
+        )
+        .await?;
+    let notification = timeout(Duration::from_secs(10), async {
+        loop {
+            let notification = client
+                .read_stream_until_notification_message("item/completed")
+                .await?;
+            if notification
+                .params
+                .as_ref()
+                .and_then(|value| value.get("item"))
+                .and_then(|item| item.get("id"))
+                == Some(&json!(event))
+            {
+                break anyhow::Ok(notification);
+            }
+        }
+    })
+    .await??;
+    assert_eq!(
+        notification
+            .params
+            .as_ref()
+            .and_then(|value| value.get("item"))
+            .and_then(|item| item.get("text")),
+        Some(&json!(text))
+    );
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(append))
+            .await?
+            .result,
+        json!({"eventId":event,"recorded":true,"modelContextAvailable":true,"notificationPublished":true,"alreadyRecorded":false})
+    );
+    let read = client
+        .send_raw_request(
+            "thread/notice/read",
+            Some(json!({"threadId":thread.id,"eventId":event})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(read))
+            .await?
+            .result,
+        json!({"notice":{"eventId":event,"text":text},"modelContextAvailable":true})
+    );
+    timeout(
+        Duration::from_secs(10),
+        client.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    assert_eq!(
+        server
+            .received_requests()
+            .await
+            .expect("requests retained")
+            .len(),
+        1
+    );
+    Ok(())
+}
