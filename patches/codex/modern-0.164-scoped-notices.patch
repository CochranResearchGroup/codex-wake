+    assert!(admitted.queued);
+    assert_eq!(admitted.thread_id, threads[0]);
+    assert!(
+        status(&mut app, &threads[0]).await?.data[0]
+            .tools
+            .contains_key("new_widget")
+    );
+    assert!(
+        status(&mut app, &threads[1]).await?.data[0]
+            .tools
+            .contains_key("old_widget")
+    );
+    let missing_scope: Result<ListMcpServerStatusResponse> = app
+        .request(|request_id| ClientRequest::McpServerStatusList {
+            request_id,
+            params: ListMcpServerStatusParams {
+                runtime_only: Some(true),
+                thread_id: None,
+                server_name: None,
+                detail: None,
+                cursor: None,
+                limit: None,
+            },
+        })
+        .await;
+    assert!(missing_scope.is_err());
+    let requests = server
+        .received_requests()
+        .await
+        .expect("recorded MCP requests");
+    let startups = requests
+        .iter()
+        .filter(|request| {
+            serde_json::from_slice::<serde_json::Value>(&request.body)
+                .is_ok_and(|value| value["method"] == "initialize")
+        })
+        .count();
+    assert_eq!(startups, 3, "only the selected runtime may reconnect");
+    assert!(
+        !requests
+            .iter()
+            .any(|request| request.url.path().ends_with("/responses"))
+    );
+    Ok(())
+}
