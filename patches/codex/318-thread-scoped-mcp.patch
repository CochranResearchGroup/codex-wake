+use rmcp::model::CallToolResult;
+use rmcp::model::Content;
+use rmcp::model::ListToolsResult;
+use rmcp::model::PaginatedRequestParams;
+use rmcp::model::ServerCapabilities;
+use rmcp::model::ServerInfo;
+use rmcp::model::Tool;
+use rmcp::service::RequestContext;
+use rmcp::service::RoleServer;
+use rmcp::transport::StreamableHttpServerConfig;
+use rmcp::transport::StreamableHttpService;
+use rmcp::transport::streamable_http_server::session::local::LocalSessionManager;
+use serde_json::Value;
+use serde_json::json;
+use tempfile::TempDir;
+use tokio::net::TcpListener;
+use tokio::task::JoinHandle;
+use tokio::time::timeout;
+
+const WAIT: Duration = Duration::from_secs(15);
+
+#[derive(Clone)]
+struct VersionServer(&'static str);
+
+impl ServerHandler for VersionServer {
+    fn get_info(&self) -> ServerInfo {
+        let mut info = ServerInfo::new(ServerCapabilities::builder().enable_tools().build());
+        info.server_info.version = self.0.into();
+        info
+    }
+
+    async fn list_tools(
+        &self,
+        _request: Option<PaginatedRequestParams>,
+        _context: RequestContext<RoleServer>,
+    ) -> Result<ListToolsResult, rmcp::ErrorData> {
+        Ok(ListToolsResult {
+            tools: vec![Tool::new(
+                "version",
+                "Report pinned runtime version",
+                Arc::new(
+                    serde_json::from_value(json!({"type":"object","properties":{}}))
+                        .expect("schema"),
+                ),
+            )],
+            next_cursor: None,
+            meta: None,
+        })
+    }
+
+    async fn call_tool(
+        &self,
+        _request: CallToolRequestParams,
+        _context: RequestContext<RoleServer>,
+    ) -> Result<CallToolResult, rmcp::ErrorData> {
+        Ok(CallToolResult::success(vec![Content::text(self.0)]))
+    }
+}
+
+async fn version_server(version: &'static str) -> Result<(String, JoinHandle<()>)> {
+    let listener = TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    let service = StreamableHttpService::new(
+        move || Ok(VersionServer(version)),
+        Arc::new(LocalSessionManager::default()),
+        StreamableHttpServerConfig::default(),
+    );
+    let router = Router::new().nest_service("/mcp", service);
+    let task = tokio::spawn(async move {
+        let _ = axum::serve(listener, router).await;
+    });
+    Ok((format!("http://{address}/mcp"), task))
+}
+
+async fn rpc(app: &mut TestAppServer, method: &str, params: Value) -> Result<Value> {
+    let id = app.send_raw_request(method, Some(params)).await?;
+    let response = timeout(
+        WAIT,
+        app.read_stream_until_response_message(RequestId::Integer(id)),
+    )
+    .await??;
+    Ok(response.result)
+}
+
+async fn snapshot(app: &mut TestAppServer, thread: &str) -> Result<Value> {
+    let catalog = rpc(
+        app,
+        "mcpServerStatus/list",
+        json!({"threadId":thread,"detail":"toolsAndAuthOnly","runtimeOnly":true}),
+    )
+    .await?;
+    let behavior = rpc(
+        app,
+        "mcpServer/tool/call",
+        json!({"threadId":thread,"server":"versioned","tool":"version","arguments":{}}),
+    )
+    .await?;
+    Ok(json!({"catalog":catalog,"behavior":behavior}))
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn thread_reload_inspection_and_refresh_preserve_the_loaded_peer() -> Result<()> {
+    let provider = responses::start_mock_server().await;
+    let home = TempDir::new()?;
+    write_mock_responses_config_toml(
+        home.path(),
+        &provider.uri(),
+        &BTreeMap::new(),
+        1024,
+        None,
+        "mock_provider",
+        "compact",
+    )?;
+    let path = home.path().join("config.toml");
+    let original = std::fs::read_to_string(&path)?;
+    let (old_url, old_task) = version_server("v1").await?;
+    let (new_url, new_task) = version_server("v2").await?;
+    std::fs::write(
+        &path,
+        format!("{original}\n[mcp_servers.versioned]\nurl = {old_url:?}\n"),
+    )?;
+    let mut app = TestAppServer::new_with_auto_env(home.path()).await?;
+    timeout(WAIT, app.initialize()).await??;
+    let mut threads = Vec::new();
+    for _ in 0..2 {
+        let id = app
+            .send_thread_start_request_with_auto_env(ThreadStartParams {
+                model: Some("mock-model".into()),
+                ..Default::default()
+            })
+            .await?;
+        let response = timeout(
+            WAIT,
+            app.read_stream_until_response_message(RequestId::Integer(id)),
+        )
+        .await??;
+        let response: ThreadStartResponse = to_response(response)?;
+        threads.push(response.thread.id);
+    }
+    let selected_before = snapshot(&mut app, &threads[0]).await?;
+    let peer_before = snapshot(&mut app, &threads[1]).await?;
+    assert_eq!(
+        selected_before["catalog"]["data"][0]["serverInfo"]["version"],
+        "v1"
+    );
+    std::fs::write(
+        &path,
+        format!("{original}\n[mcp_servers.versioned]\nurl = {new_url:?}\n"),
+    )?;
+    assert_eq!(
+        rpc(
+            &mut app,
+            "thread/mcpServer/reload",
+            json!({"threadId":threads[0],"dryRun":true})
+        )
+        .await?,
+        json!({"threadId":threads[0],"queued":false})
+    );
+    // A status read must observe the loaded runtime, not connect to the new config.
+    assert_eq!(snapshot(&mut app, &threads[0]).await?, selected_before);
+    assert_eq!(snapshot(&mut app, &threads[1]).await?, peer_before);
+    let id = app
+        .send_raw_request(
+            "thread/mcpServer/reload",
+            Some(json!({"threadId":"00000000-0000-7000-8000-000000000318"})),
+        )
+        .await?;
+    timeout(
+        WAIT,
+        app.read_stream_until_error_message(RequestId::Integer(id)),
+    )
+    .await??;
+    assert_eq!(snapshot(&mut app, &threads[1]).await?, peer_before);
+    assert_eq!(
+        rpc(
+            &mut app,
+            "thread/mcpServer/reload",
+            json!({"threadId":threads[0]})
+        )
+        .await?,
+        json!({"threadId":threads[0],"queued":true})
+    );
+    timeout(WAIT, async {
+        loop {
+            let selected = snapshot(&mut app, &threads[0]).await?;
+            if selected["behavior"]["content"][0]["text"] == "v2" {
+                assert_eq!(
+                    selected["catalog"]["data"][0]["serverInfo"]["version"],
+                    "v2"
+                );
+                break Ok::<(), anyhow::Error>(());
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await??;
+    assert_eq!(snapshot(&mut app, &threads[1]).await?, peer_before);
+    old_task.abort();
+    new_task.abort();
+    Ok(())
+}
