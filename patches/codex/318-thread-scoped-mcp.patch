+/// Plan and queue a refresh for one exact loaded thread without touching its peers.
+pub(crate) async fn queue_thread_refresh(
+    thread_manager: &Arc<ThreadManager>,
+    config_manager: &ConfigManager,
+    thread_id: ThreadId,
+) -> io::Result<()> {
+    let thread = thread_manager.get_thread(thread_id).await.map_err(|err| {
+        io::Error::other(format!("failed to load refresh thread {thread_id}: {err}"))
+    })?;
+    let config = build_refresh_config(thread.as_ref(), config_manager).await?;
+    queue_refresh(thread_id, Arc::clone(&thread), config).await?;
+    thread.apply_pending_mcp_server_refresh().await;
+    Ok(())
+}
