diff --git a/codex-rs/tui/src/chatwidget/tests/app_server.rs b/codex-rs/tui/src/chatwidget/tests/app_server.rs
index 3c7d9bbf50..2e8bc9edaa 100644
--- a/codex-rs/tui/src/chatwidget/tests/app_server.rs
+++ b/codex-rs/tui/src/chatwidget/tests/app_server.rs
@@ -1256,3 +1256,32 @@ async fn live_app_server_thread_closed_requests_immediate_exit() {
 
     assert_matches!(rx.try_recv(), Ok(AppEvent::Exit(ExitMode::Immediate)));
 }
+
+#[tokio::test]
+async fn external_supervision_notice_renders_without_starting_a_turn() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let text = "Goal paused: external allowance reached. Extend allowance / Reset budget window / Keep stopped. Native /goal resume alone does not renew this external allowance.";
+    chat.handle_server_notification(
+        ServerNotification::ItemCompleted(ItemCompletedNotification {
+            thread_id: "thread-1".into(),
+            turn_id: "notice_stop_1".into(),
+            completed_at_ms: 0,
+            item: AppServerThreadItem::AgentMessage {
+                id: "notice_stop_1".into(),
+                text: text.into(),
+                phase: None,
+                memory_citation: None,
+            },
+        }),
+        /*replay_kind*/ None,
+    );
+    let cells = drain_insert_history(&mut rx);
+    assert_eq!(cells.len(), 1);
+    let lines = lines_to_single_string(&cells[0]);
+    assert_chatwidget_snapshot!("external_supervision_notice_without_turn", lines);
+    assert!(!chat.bottom_pane.is_task_running());
+    assert!(
+        op_rx.try_recv().is_err(),
+        "notice must not submit a model operation"
+    );
+}
