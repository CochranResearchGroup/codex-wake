@@ -0,0 +1,44 @@
+//! Response ledger compatibility from upstream 5f79a92e3936274318d2122ae3244e5edd80dd1f.
+//! Descendant lineage is unavailable in this older runtime, so it remains held.
+use super::Session;
+use super::TurnContext;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::RawResponseCompletedEvent;
+use codex_protocol::protocol::RolloutItem;
+use codex_protocol::protocol::TokenUsage;
+
+impl Session {
+    pub(crate) async fn record_response_token_usage(
+        &self,
+        turn: &TurnContext,
+        response_id: String,
+        usage: Option<TokenUsage>,
+    ) {
+        let observed =
+            RolloutItem::EventMsg(EventMsg::RawResponseCompleted(RawResponseCompletedEvent {
+                response_id: response_id.clone(),
+                token_usage: usage.clone(),
+                usage_metadata: None,
+            }));
+        let record = usage
+            .as_ref()
+            .filter(|_| self.thread_id().to_string() == self.session_id().to_string())
+            .map(|usage| (response_id, usage));
+        if let Some((response_id, usage)) = record {
+            let record = self.state.lock().await.record_token_usage(
+                self.thread_id(),
+                &turn.sub_id,
+                self.session_id(),
+                turn.sub_id.clone(),
+                response_id,
+                usage,
+            );
+            self.persist_rollout_items(&[observed, RolloutItem::TokenUsageRecord(record)])
+                .await;
+        } else {
+            // No record is fabricated for missing usage or unproved descendant
+            // root-turn attribution. Wake sees the unmatched completion and holds.
+            self.persist_rollout_items(&[observed]).await;
+        }
+    }
+}
