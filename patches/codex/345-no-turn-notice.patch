+    );
+    let appended = client
+        .read_stream_until_response_message(RequestId::Integer(append))
+        .await?;
+    assert_eq!(
+        appended.result,
+        json!({"eventId":event,"recorded":true,"modelContextAvailable":true,"notificationPublished":true,"alreadyRecorded":false})
+    );
+    assert_eq!(model.requests().len(), 0);
+    let duplicate = client
+        .send_raw_request(
+            "thread/notice/append",
