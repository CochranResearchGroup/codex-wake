+#[tokio::test]
+async fn notice_is_durable_idempotent_visible_and_starts_no_model_turn() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let model = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![
+            responses::ev_response_created("notice-response"),
+            responses::ev_assistant_message(
+                "notice-model-answer",
+                "Operator continuation complete",
+            ),
+            json!({"type":"response.completed","response":{"id":"notice-response","usage":{
+            "input_tokens":20,"input_tokens_details":{"cached_tokens":10},"output_tokens":5,
+            "output_tokens_details":{"reasoning_tokens":0},"total_tokens":25}}}),
+        ]),
+    )
+    .await;
+    let home = TempDir::new()?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        format!(
+            r#"
+model = "mock-model"
+approval_policy = "never"
+sandbox_mode = "read-only"
+model_provider = "mock_provider"
+[model_providers.mock_provider]
+name = "Notice test"
+base_url = "{}/v1"
+wire_api = "responses"
+request_max_retries = 0
+stream_max_retries = 0
+"#,
+            server.uri()
+        ),
+    )?;
+    let mut client = TestAppServer::new_with_auto_env(home.path()).await?;
+    client.initialize().await?;
+    let start = client
+        .send_thread_start_request_with_auto_env(ThreadStartParams::default())
+        .await?;
+    let started: ThreadStartResponse = to_response(
+        client
+            .read_stream_until_response_message(RequestId::Integer(start))
+            .await?,
+    )?;
+    let thread = started.thread;
+    let event = "notice_owned_stop_1";
+    let text = "Goal paused: external token allowance reached. Extend allowance / Reset budget window / Keep stopped. Native /goal resume alone does not renew this external allowance. [External supervision event notice_owned_stop_1]";
+    let append = client
