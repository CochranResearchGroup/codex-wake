+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(duplicate))
+            .await?
+            .result,
+        json!({"eventId":event,"recorded":true,"modelContextAvailable":true,"notificationPublished":false,"alreadyRecorded":true})
+    );
+    let changed = client
+        .send_raw_request(
+            "thread/notice/append",
+            Some(json!({"threadId":thread.id,"eventId":event,"text":format!("Changed {text}")})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_error_message(RequestId::Integer(changed))
+            .await?
+            .error
+            .code,
+        -32600
+    );
+    let read = client
+        .send_raw_request(
+            "thread/notice/read",
+            Some(json!({"threadId":thread.id,"eventId":event})),
+        )
+        .await?;
+    assert_eq!(
+        client
+            .read_stream_until_response_message(RequestId::Integer(read))
+            .await?
+            .result,
+        json!({"notice":{"eventId":event,"text":text},"modelContextAvailable":true})
+    );
+    let history = std::fs::read_to_string(thread.path.as_ref().expect("rollout path"))?;
+    assert_eq!(
+        history
+            .lines()
+            .filter(|line| line.contains("external_supervision") && line.contains(event))
+            .count(),
+        1
+    );
+    assert_eq!(
+        history
+            .lines()
+            .filter(|line| line.contains("agent_message") && line.contains(event))
+            .count(),
+        1
+    );
+    // Only this explicit operator continuation starts a local mock model request.
+    let turn = client
+        .send_turn_start_request(TurnStartParams {
+            thread_id: thread.id.clone(),
+            input: vec![UserInput::Text {
+                text: "Continue with approved operator work".into(),
+                text_elements: Vec::new(),
+            }],
+            ..Default::default()
+        })
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(turn))
+        .await?;
+    timeout(
+        Duration::from_secs(10),
+        client.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let flushed = client
+        .send_raw_request(
+            "thread/notice/read",
+            Some(json!({"threadId":thread.id,"eventId":event})),
+        )
+        .await?;
+    client
+        .read_stream_until_response_message(RequestId::Integer(flushed))
+        .await?;
+    let rows = std::fs::read_to_string(thread.path.as_ref().expect("rollout path"))?;
+    let usage_rows = rows
+        .lines()
+        .map(|line| serde_json::from_str::<serde_json::Value>(line).expect("valid rollout"))
+        .filter(|row| row.get("type") == Some(&json!("token_usage_record")))
+        .collect::<Vec<_>>();
+    assert_eq!(usage_rows.len(), 1);
+    assert_eq!(
+        usage_rows[0]["payload"]["response_id"],
+        json!("notice-response")
+    );
+    assert_eq!(usage_rows[0]["payload"]["thread_id"], json!(thread.id));
+    assert_eq!(
+        usage_rows[0]["payload"]["root_turn_id"],
+        usage_rows[0]["payload"]["turn_id"]
+    );
+    assert_eq!(
+        usage_rows[0]["payload"]["usage"],
+        json!({"input_tokens":20,"cached_input_tokens":10,
+        "output_tokens":5,"reasoning_output_tokens":0,"total_tokens":25})
+    );
+    let input = model.single_request().input();
+    assert!(input.iter().any(|item| {
+        item.get("content")
+            .and_then(|content| content.as_array())
+            .is_some_and(|parts| {
+                parts.iter().any(|part| {
+                    part.get("text")
+                        .and_then(|value| value.as_str())
+                        .is_some_and(|text| {
+                            text.contains("external_supervision") && text.contains(event)
+                        })
+                })
+            })
+    }));
+    Ok(())
+}
