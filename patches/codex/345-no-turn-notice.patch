+//! Durable, bounded external notices do not schedule model work.
+use super::CodexThread;
+use crate::context::ContextualUserFragment;
+use crate::context::InternalContextSource;
+use crate::context::InternalModelContextFragment;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::AgentMessageEvent;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::RolloutItem;
+
+impl CodexThread {
+    /// Find a persisted notice without creating a model turn.
+    pub async fn external_notice(&self, event_id: &str) -> Result<Option<(String, bool)>> {
+        // A newly loaded thread can defer its rollout until first use. Materialize
+        // the existing session header, never a user turn, before inspecting it.
+        self.ensure_rollout_materialized().await;
+        self.flush_rollout().await?;
+        let history = self
+            .load_history(/*include_archived*/ false)
+            .await
+            .map_err(|error| {
+                CodexErr::InvalidRequest(format!("notice history unavailable: {error}"))
+            })?;
+        let marker = format!("[External supervision event {event_id}]");
+        let context_exists = history.items.iter().any(|item| {
+            matches!(item,
+            RolloutItem::ResponseItem(ResponseItem::Message { id: Some(id), .. }) if id == event_id)
+        });
+        if !context_exists {
+            return Ok(None);
+        }
+        let in_context = self
+            .codex
+            .session
+            .clone_history()
+            .await
+            .raw_items()
+            .iter()
+            .any(|item| {
+                matches!(item,
+            ResponseItem::Message { id: Some(id), .. } if id == event_id)
+            });
+        Ok(history.items.iter().find_map(|item| match item {
+            RolloutItem::EventMsg(EventMsg::AgentMessage(message))
+                if message.message.ends_with(&marker) =>
+            {
+                Some((message.message.clone(), in_context))
+            }
+            _ => None,
+        }))
+    }
+
+    /// Record model context and a replayable display event even while a tool is busy.
+    /// The caller serializes notice requests for this thread; no turn is started.
+    pub async fn record_external_notice(&self, event_id: &str, text: &str) -> Result<()> {
+        if text.len() > 768 || text.is_empty() || event_id.len() > 128 || event_id.is_empty() {
+            return Err(CodexErr::InvalidRequest(
+                "external notice exceeds bounded context size".into(),
+            ));
+        }
+        let fragment = InternalModelContextFragment::new(
+            InternalContextSource::from_static("external_supervision"),
+            text,
+        );
+        let mut item: ResponseItem = ContextualUserFragment::into(fragment);
+        if let ResponseItem::Message { id, .. } = &mut item {
+            *id = Some(event_id.to_owned());
+        }
+        let history = self
+            .load_history(/*include_archived*/ false)
+            .await
+            .map_err(|error| {
+                CodexErr::InvalidRequest(format!("notice history unavailable: {error}"))
+            })?;
+        let saved = history.items.iter().find_map(|saved| match saved {
+            RolloutItem::ResponseItem(ResponseItem::Message {
+                id: Some(id),
+                content,
+                ..
+            }) if id == event_id => Some(content),
+            _ => None,
+        });
+        if let Some(content) = saved {
+            let expected = match &item {
+                ResponseItem::Message { content, .. } => content,
+                _ => unreachable!(),
+            };
+            if content != expected {
+                return Err(CodexErr::InvalidRequest(
+                    "notice event id already has different content".into(),
+                ));
+            }
+        } else {
+            let turn = self.codex.session.new_default_turn().await;
+            self.codex
+                .session
+                .record_conversation_items(turn.as_ref(), &[item])
+                .await;
+        }
+        // The event is separate from the model item so existing clients replay it.
+        // Reconcile a partial append by retaining the same id/context, never reinjecting it.
+        let marker = format!("[External supervision event {event_id}]");
+        if !history.items.iter().any(|saved| matches!(saved,
+            RolloutItem::EventMsg(EventMsg::AgentMessage(message)) if message.message.ends_with(&marker))) {
+            self.append_rollout_items(&[RolloutItem::EventMsg(EventMsg::AgentMessage(AgentMessageEvent {
+                message: text.to_owned(), phase: None, memory_citation: None,
