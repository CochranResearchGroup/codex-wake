              {
                "path": "docs/dev/policies/0013-planning-discipline.md",
                "heading_path": [
                  "Policy | Planning Discipline"
                ]
              }
            ]
          },
          {
            "id": "effect.no-derived-authority",
            "kind": "prohibited_effect",
            "statement": "Derived MCP policy packets cannot replace canonical Markdown or infer current action authorization.",
