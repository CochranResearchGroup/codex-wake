        "schema_version": 1,
        "obligations": [
          {
            "id": "gate.single-canonical-policy",
            "kind": "required_gate",
            "statement": "Keep one active path per policy module identity; reconcile conflicting copies and validate unique entrypoint wiring.",
            "citations": [
              {
                "path": "docs/dev/policies/0010-policy-management.md",
