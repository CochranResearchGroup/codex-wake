+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn resumed_custom_call_without_output_recovers_and_completes_turn() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let initial = test_codex().build_with_auto_env(&server).await?;
+    mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("seed", "Saved context."),
+            ev_completed("seed"),
+        ]),
+    )
+    .await;
+    initial.submit_text_turn("Seed the saved history.").await?;
+    initial.codex.shutdown_and_wait().await?;
+    let orphaned_call = RolloutItem::ResponseItem(
+        ResponseItem::CustomToolCall {
+            encrypted_content: None,
+            id: None,
+            status: Some("completed".to_string()),
+            call_id: "orphaned-exec".to_string(),
+            name: "exec".to_string(),
+            namespace: Some("functions".to_string()),
+            input: "throw new Error('historical call must not be replayed')".to_string(),
+            internal_chat_message_metadata_passthrough: None,
+        }
+        .into(),
+    );
+    append_rollout_item_to_path(
+        initial
+            .session_configured
+            .rollout_path
+            .as_ref()
+            .expect("seed turn materializes its rollout"),
+        &orphaned_call,
+    )
+    .await?;
+    let history = initial
+        .thread_store
+        .load_latest_model_context(LoadThreadHistoryParams {
+            thread_id: initial.session_configured.thread_id,
+            include_archived: true,
+        })
+        .await?;
+    let resumed = initial
+        .thread_manager
+        .resume_thread_with_history(
+            initial.config.clone(),
+            InitialHistory::Resumed(ResumedHistory {
+                history_revision: None,
+                conversation_id: history.thread_id,
+                history: Arc::new(history.items),
+                rollout_path: initial.session_configured.rollout_path.clone(),
+            }),
+            initial.thread_manager.auth_manager(),
+            /*parent_trace*/ None,
+            ClientMcpExtensions::default(),
+        )
+        .await?;
+    let response = mount_sse_once(
+        &server,
+        sse(vec![
+            ev_assistant_message("recovered", "Historical tool result was unavailable."),
+            ev_completed("recovered"),
+        ]),
+    )
+    .await;
+    resumed
+        .thread
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Continue without replaying the historical tool.".to_string(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    wait_for_event(&resumed.thread, |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+    assert_eq!(
+        response
+            .single_request()
+            .custom_tool_call_output("orphaned-exec"),
+        serde_json::json!({
+            "type": "custom_tool_call_output",
+            "call_id": "orphaned-exec",
+            "output": "aborted"
+        })
+    );
+    resumed.thread.shutdown_and_wait().await?;
+    Ok(())
+}
